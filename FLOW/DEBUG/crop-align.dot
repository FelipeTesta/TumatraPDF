digraph CropAlign {
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Consolas", fontsize=10];
    edge [fontname="Consolas", fontsize=9];
    compound=true;

    // ============================================================
    // Cluster 1: Tool invocation + line drawing (align, toolMode=5)
    // ============================================================
    subgraph cluster_invoke {
        label="Cluster 1: Tool invocation + line drawing (Crop Align, toolMode=5)";
        color="#4caf50";

        c1_cmd [label="CmdArchAlign (Edit toolbar, CmdArchAlign=525)\nHandleCmdArchAlign\nCommands_ArchTools.cpp\nguard kAlignToggleGuardMs=500 (:37)\ntoolMode 0<->5 toggle (s50-R8 idempotency)", fillcolor="#c8e6c9", style=filled];
        c1_draw [label="User draws line on canvas (LIVE rubber-band)\nWM_LBUTTONDOWN/-MOVE/-UP (toolMode==5)\narchTools.point1/point2 (page coords)\nCanvas.cpp OnMouseMove drag preview :1855-1886\nCanvas.cpp OnMouseLeftButtonDown drag start :2564-2575\nclick-click 2nd path :2576-2593", fillcolor="#bbdefb", style=filled];
        c1_fin [label="FinalizeAlign(win, dm, pageNo)\nCanvas.cpp\nangle vs nearer axis atan2f (:2870)\nnormDeg [-90,90] (:2873-2888)\naxis 0=vertical / 1=horizontal (:2882-2888)\nrotation = -measuredAngle (:2891) CCW+; s64-R7: totalAngle = residual (absolute angle from pristine, single Fm0)\n— R6 delta-sum (alignAppliedAngle + residual) REMOVED; one line per session.\nSIGN CONVENTION (PyMuPDF-verified): PDF y-up rotation angle = signed image-space deviation — apply -40deg rights a -40deg-tilted line, +10deg rights a 10deg-off-vertical line; single Fm0 about page center, mediabox = AABB of ORIGINAL rotated by total (no compounding)\ncrop = mediabox rotated about center (:2897-2919)\nclamp to mediabox (:2921-2924)\naspect preserved to mediabox W:H (:2925-2934)\nAfter apply: alignLine cleared → line disappears from canvas; page stays deskewed.", fillcolor="#bbdefb", style=filled];

        c1_cmd -> c1_draw -> c1_fin;
    }

    // ============================================================
    // Cluster 1c: Crop tool invocation + overlay (toolMode=6)
    // ============================================================
    subgraph cluster_crop_invoke {
        label="Cluster 1c: Page Crop tool invocation + bbox overlay (toolMode=6)";
        color="#4caf50";

        c1c_cmd [label="CmdArchPageCrop (Edit toolbar, CmdArchPageCrop=536)\nHandleCmdArchPageCrop\nCommands_ArchTools.cpp\nguard: discards other preview on switch\ntoolMode 0<->6 toggle\nwin->archTools.on NOT set (Edit bar row\nshared with Arch Tools — mutually exclusive)", fillcolor="#c8e6c9", style=filled];
        c1c_overlay [label="On activation: overlay = FULL PAGE bounds (fitz page space,\ny-down) via CvtToScreen — both operands named y-down\nCanvas.cpp OnPaintDocument crop block\nSPACE AFTER FIX: applied rect = PDF y-up via mb.x0/mb.y1 conversion;\ncropBboxPage stays fitz y-down page space; hit-test uses pt + bounds.{x,y}\ngreen bbox + 8 white resize handles (kResizeHandleSize=8)\nMin size guard 20x20 page units\nClamp box to mediabox on drag", fillcolor="#bbdefb", style=filled];
        c1c_style [label="nomacs-parity styling (s64-R8) via Theme API\n4 darkened strips outside region (ThemeWindowBackgroundColor alpha 150)\n+ 2px ThemeEdgeColor border + 8 handles (ThemeWindowTextColor alpha 230)\nCanvas.cpp paint block ~:4863-4890", fillcolor="#e1bee7", style=filled];
        c1c_drag [label="Drag lifecycle (Start/StopMouseDrag pattern)\n8 handles (corners+edges) resize, interior moves\nBox stays on canvas until Apply or tool switch\nESC reverts to box at drag start\nHover shows resize cursor", fillcolor="#bbdefb", style=filled];

        c1c_cmd -> c1c_overlay -> c1c_drag;
        c1c_style -> c1c_overlay [label="styles overlay+border+handles", style=dashed];
    }

    // ============================================================
    // Cluster 1b: Ignore-draw-when-applied + ESC discard (s64-R7)
    // ============================================================
    subgraph cluster_reset {
        label="Cluster 1b: Ignore-draw-when-applied + ESC discard (s64-R7)";
        color="#e91e63";

        c1b_mouse [label="OnMouseLeftButtonDown: toolMode=5, dragLine=0\nCanvas.cpp\nNEW (s64-R7): if this page already has an active align preview\n(em->hasPreviewGeomEdit && em->previewGeomEdit.pageNo == pageNo), IGNORE the drag start\n— log and return without placing point1. User must discard via ESC / toggle-off first.\nThe R6 restore-pristine-on-second-draw + per-page delta-sum is REMOVED.", fillcolor="#fce4ec", style=filled];
        c1b_esc [label="WM_KEYDOWN VK_ESCAPE (Canvas.cpp WndProcCanvas, s64-R7)\nWhen toolMode==5: DiscardPreview(pageNo, dm) reverts page to pristine +\nclears preview state; then clears alignLine/dragLine/mouseAction, releases capture.\nResult: page back to pristine, ready for a new align line.", fillcolor="#fce4ec", style=filled];

        c1b_mouse -> c1b_esc [label="gate → discard → redraw"];

        c1b_esc_keep [label="s64-R7c: ESC keeps tool ON (toolMode=5)\nCanvas.cpp WndProcCanvas WM_KEYDOWN VK_ESCAPE returns 0 (consumes ESC)\n— toolMode UNCHANGED (stays 5), no HandleCmdArchAlign, no toolbar toggle-off.\nRoot cause (unfixable, SumatraPDF.cpp READ-ONLY): FrameOnKeydown line 8207\nzeros toolMode=0 on ESC; Canvas.cpp handler returns 0 first when canvas has focus.\nLog: "[arch] Esc discard (tool stays on)" vs FrameOnKeydown's "[arch] Esc cancel: draw mode cancelled".", fillcolor="#fff3e0", style=filled];

        c1b_esc -> c1b_esc_keep [label="same ESC handler → tool stays ON"];
    }

    // ============================================================
    // Cluster 2: Finalize + instant apply (s50-R9)
    // ============================================================
    subgraph cluster_apply {
        label="Cluster 2: Finalize + instant apply (s50-R9/R10)";
        color="#2196f3";

        c2_queue [label="dm->GetEngine()->QueuePageGeometry(pageNo, rotation, bbox)\nEngineMupdf.cpp\nrejects pages with engine annotations/widgets (:4057-4072)\nper-page dedupe (:4075-4082)\nmodifiedPageGeometry = true (:4088)", fillcolor="#bbdefb", style=filled];
        c2_apply [label="dm->GetEngine()->ApplyPendingGeometryEditsNow()\nCanvas.cpp\nEngineMupdf.cpp\nPass1 docLock (:7141) applies to live pdfdoc\n  CAPTURE pristine state at FIRST apply (s64)\n    keeps pdf_keep_obj refs to pageDict, contents, resources\n    captures orig MediaBox, CropBox, /Rotate\nPass2 pagesLock+renderLock (:7463) drops caches", fillcolor="#bbdefb", style=filled];
        c2_fix [label="NEW (s63 FIX): gRenderCache->FreeForDisplayModel(dm)\nCanvas.cpp immediately after ApplyPendingGeometryEditsNow\nprecedent: TrimConfigDialog.cpp, Commands_Image.cpp/247,\nCommands_Edit.cpp, ImageEditHostSumatra.cpp\nDROP stale (dm,pageNo,rotation,zoom,tile) bitmaps", fillcolor="#c8e6c9", style=filled];
        c2_build [label="dm->BuildPagesInfo()\nCanvas.cpp (was 2951)\nDisplayModel.cpp\nre-AllocArray pagesInfo (state=Unknown)\n0.00ms EXPECTED — measurement deferred to Relayout\n(useLazyMediaBoxes/default box, :1036)", fillcolor="#e1bee7", style=filled];
        c2_relayout [label="dm->RelayoutKeepingView()\nCanvas.cpp (was 2952)\nDisplayModel.cpp\nanchor FirstVisiblePageNo + dyInPage (:1604-1611)\nRelayout(zoomVirtual, rotation) (:1613)\nPageMediaBox :820 -> engine->PageMediabox :831 (pass2 mediabox)\nRecalcVisibleParts :1619 -> RenderVisibleParts :1620\ncb->UpdateScrollbars :1621 -> RepaintDisplay :1622 (Repaint -> cb->Repaint :410)", fillcolor="#e1bee7", style=filled];
        c2_repaint [label="ScheduleRepaint(win, 0)\nCanvas.cpp (was 2963)\ncanvas WM_PAINT -> Canvas.cpp gRenderCache->Paint(...)", fillcolor="#c8e6c9", style=filled];

        c2_queue -> c2_apply -> c2_fix -> c2_build -> c2_relayout -> c2_repaint;
    }

    // ============================================================
    // Cluster 3: Geometry mutation in EngineMupdf (XObject /Matrix + boxes)
    // ============================================================
    subgraph cluster_geom {
        label="Cluster 3: Geometry mutation (EngineMupdf.cpp)";
        color="#9c27b0";

        c3_r3 [label="R3 arbitrary-angle path (:7181-7348)\nangleDeg 37.1deg -> not 90-multiple\nmediabox = pdf_bound_page FZ_MEDIA_BOX (:7188)\ncropRect = ToFzRect(edit.cropRectPage) (:7191)\nrotatedBBox = rot corners bbox (:7210-7220)\nXObject content: q %g %g cm <orig contents> Q (:7229-7252)\n/BBox = [0 0 cropW cropH] (:7259)\n/Matrix = translate(-cropW/2,-cropH/2) pre_rotate pre_translate(newCx,newCy) (:7263-7266)\npdf_new_xobject (:7275) — resources borrowed from page (:7269-7272)\nnew page /Contents = q /FmN Do Q (:7290-7302)\n/Resources = old + /XObject<</FmN xobj>> (:7304-7335)\npdf_set_page_box FZ_MEDIA_BOX + FZ_CROP_BOX = rotatedBBox (:7342-7343)\nedit.newMediabox = ToRectF(rotatedBBox) NON-ZERO ORIGIN (:7347)\n/Rotate LEFT UNCHANGED (currentRotate factoring = known limitation :7183-7185)", fillcolor="#bbdefb", style=filled];
        c3_r2 [label="R2 90-multiple path (:7122-7180)\n/Rotate = (currentRotate + round(angle/90)*90) % 360 (:7125-7127)\nCropBox transformed about mediabox center (:7138-7175)\nrotateDelta==0 (pure crop): write BOTH MediaBox+CropBox raw as\n[0 0 cropW cropH] zero-origin, skipping pdf_set_page_box\n(s63 box-divergence fix — pdf_set_page_box routes through\npage CTM and diverges on 2nd call). edit.newMediabox set.\nrotateDelta!=0: mediabox NOT touched — edit.newMediabox = empty (:7180)", fillcolor="#c8e6c9", style=filled];

        c3_r3 -> c3_r2 [style=dashed, label="sibling branch"];
    }

    // ============================================================
    // Cluster 4: Cache invalidation — WHICH caches get dropped
    // ============================================================
    subgraph cluster_cache {
        label="Cluster 4: Cache invalidation (s50-R10 two-pass)";
        color="#ff9800";

        c4_pass2 [label="Pass 2 pagesLock+renderLock (:7363-7391)\nfor each pendingGeomEdit:\nIF newMediabox non-empty: pageInfo->mediabox = :7375-7377 (R3 only!)\nfz_drop_page + pageInfo->page = nullptr (:7379-7382)\nfz_drop_display_list + displayList = nullptr (:7384-7387)\nelementsNeedRebuilding = true (:7389) — consumed EngineMupdf.cpp\nappliedInMemory = true (:7393)", fillcolor="#bbdefb", style=filled];
        c4_red [label="GREEN — FIXED (s63): RenderCache bitmap cache\nkeyed (dm, pageNo, rotation, zoom, tile). FinalizeAlign and\nApplyPreviewGeometry call gRenderCache->FreeForDisplayModel(dm)\nbefore BuildPagesInfo, dropping stale (dm,pageNo,rotation,zoom,tile)\nentries so the next paint re-renders from the mutated pdfdoc.\nPaintTile Find() (RenderCache.cpp) now MISSes post-apply;\nBlitPixmapRegion (:1179) paints the NEW deskewed bitmap.\nTestAlignApply (ControlCmd 66) mirrors the same tail.", fillcolor="#c8e6c9", style=filled];
        c4_getorbuild [label="GetOrBuildPageDisplayList\nEngineMupdf.cpp\nrebuilds displayList lazily from reloaded fz_page (after drop)\nnext RenderPage uses NEW page content (XObject /Matrix)", fillcolor="#e1bee7", style=filled];

        c4_pass2 -> c4_red [style=dashed, color="#d32f2f"];
        c4_red -> c4_getorbuild [style=dashed, label="post-fix path"];
    }

    // ============================================================
    // Cluster 5: Render / repaint after apply (paint path)
    // ============================================================
    subgraph cluster_render {
        label="Cluster 5: Render/repaint path (post-fix)";
        color="#795548";

        c5_paint [label="Canvas WM_PAINT\nCanvas.cpp gRenderCache->Paint(hdc, bounds, dm, pageNo, pi, ...)\nrenderMissing=true -> Find(dm,pageNo,rotation,zoom,&tile) (:1132)", fillcolor="#bbdefb", style=filled];
        c5_miss [label="Post-fix: cache MISS (FreeForDisplayModel dropped entries)\n-> RequestRendering(dm, pageNo, tile) (:1144) render thread\nRenderPage: GetFzPageInfo reloads fz_page (pageInfo->page was null)\nGetOrBuildPageDisplayList (:4626) rebuilds from mutated pdfdoc\ncontent = q /FmN Do Q with rotated /Matrix -> pixmap at NEW mediabox size\nentry cached -> BlitPixmapRegion (:1179) = DESKEWED BITMAP", fillcolor="#c8e6c9", style=filled];
        c5_hit [label="PRE-FIX (resolved s63): cache HIT (stale)\nold bitmap blitted; content stayed UNROTATED = no visual deskew.\nNo longer reachable: FreeForDisplayModel(dm) forces a cache MISS\nso every post-apply paint re-renders from the mutated pdfdoc.", fillcolor="#c8e6c9", style=filled];

        c5_paint -> c5_miss [label="post-fix (s63)"];
        c5_paint -> c5_hit [label="pre-fix (historical)", color="#d32f2f", style=dashed];
    }

    // ============================================================
    // Cluster 6: Save path (PersistOutlineEdits sibling)
    // ============================================================
    subgraph cluster_save {
        label="Cluster 6: Save path (geometry re-apply skip)";
        color="#000000";

        c6_save [label="Ctrl+S / quit -> EngineMupdfSaveUpdated\nEngineMupdf.cpp\nPREVIEW GATING (s64-R2): RestorePreviewIfNeeded(dm) reverts any\nuncommitted preview (hasPreviewGeomEdit not in pendingGeomEdits)\nbefore saving — only promoted (committed) edits persist.\nSaves pendingGeomEdits via ApplyPendingGeometryEdits unless\nappliedInMemory (instant visual apply already wrote the live doc).\nSets appliedInMemory=false + modifiedPageGeometry=false on success.", fillcolor="#e1bee7", style=filled];
        c6_geomtest [label="Control cmds (SumatraControl.cpp, enum ControlCmd)\nTestAlignQueue = 64 — queue page-geometry edit to pendingGeomEdits\nTestGeomSave = 65 — headless fresh-engine save (own engine, not live)\nTestAlignApply = 66 — DIRECT in-memory apply (QueuePageGeometry +\n  ApplyPendingGeometryEditsNow) — persists on save, NOT gated\nTestAlignCommit = 67 — PromotePreviewToPending (commit preview)\nTestAlignDiscard = 68 — DiscardPreview (revert preview to pristine)\nTestGetPageNo = 69 — introspection\nmbBefore/mbAfter logged in TestAlignApply result", fillcolor="#fff9c4", style=filled];

        c6_save -> c6_geomtest [style=dashed, label="exercised by tests"];
    }

    // ============================================================
    // Cluster 7: s64 Pristine capture + Restore path
    // ============================================================
    subgraph cluster_s64 {
        label="Cluster 7: s64 — Pristine capture at 1st apply (unchanged by R7)";
        color="#673ab7";

        c7_cap [label="Pristine capture in ApplyPreviewGeometry / ApplyPendingGeometryEditsNow\nEngineMupdf.cpp / EngineMupdf_Preview.cpp\nPagePristineState struct added to EngineMupdf\n  pageDict, contents, resources (pdf_keep_obj)\n  mediaBox, cropBox, rotate\ncaptured ONCE per page at FIRST in-memory apply\npristinePageStates vector stores by pageNo\nUsed by DiscardPreview to revert page to pristine (ESC / toggle-off / 2nd-draw gate).", fillcolor="#d1c4e9", style=filled];

        // s64-R6 restore-on-2nd-draw + per-page delta-sum idempotency REMOVED (s64-R7).
    }

    // ============================================================
    // KNOWN LATENT ISSUES (RED / yellow — not fixed this round)
    // ============================================================
    subgraph cluster_latent {
        label="Latent / known issues (s63: noted, not fixed)";
        color="#d32f2f";
        style=dashed;

        l1 [label="R2 (90deg) path: pageInfo->mediabox NOT updated (:7180 empty newMediabox)\nlayout keeps pre-edit W:H though /Rotate+CropBox changed — Fit Width/page layout\nmay mis-size swapped-orientation pages. FIX LATER: recompute mediabox via\npdf_page_obj_transform post /Rotate set, or ToRectF(rotated crop).", fillcolor="#fff9c4", style=filled];
        l2 [label="R3 rotatedBBox has NON-ZERO origin (ToRectF(rotatedBBox), :7347)\nMediaBox/CropBox stored with absolute rotated-corner coords.\nRender CTM (FzCreateViewCtm, :479) ignores origin for rotation==0 (scale only) —\npage content coords are absolute too, so page renders correctly;\nmonitor for selection/hit-test/screen math assuming origin 0.", fillcolor="#fff9c4", style=filled];
        l3 [label="elementsNeedRebuilding=true set (:7389) but no full annot re-decode before\nnext paint is guaranteed — annots/widgets on edited pages were already\nREJECTED at QueuePageGeometry (:4057-4072), so expected no-op.", fillcolor="#c8e6c9", style=filled];

        l1 -> l2 -> l3 [style=dashed];
    }

    // ============================================================
    // Cluster 8: s64 preview / commit / discard state machine
    // ============================================================
    subgraph cluster_state {
        label="Cluster 8: s64 preview/commit/discard state machine (EngineMupdf_Preview.cpp)";
        color="#673ab7";

        c8_preview [label="ApplyPreviewGeometry(pageNo, angleDeg, cropRect, dm)\nEngineMupdf_Preview.cpp\nPREVIEW — in-memory visual only, does NOT add to pendingGeomEdits.\nCaptures pristine PagePristineState at FIRST apply.\nApplies R2 (/Rotate+CropBox) or R3 (Form XObject FmN) to live pdfdoc.\nSets hasPreviewGeomEdit=true, appliedInMemory=true.\nInvalidates RenderCache + BuildPagesInfo + RelayoutKeepingView.", fillcolor="#bbdefb", style=filled];
        c8_commit [label="PromotePreviewToPending(pageNo)\nEngineMupdf_Preview.cpp\nCOMMIT — moves previewGeomEdit → pendingGeomEdits.\nTriggered by CmdArchAlignApply=526 (GUI Apply button)\nor TestAlignCommit=67 (control).\nSaved file = single deskew (last angle from ORIGINAL via pristine restore).", fillcolor="#c8e6c9", style=filled];
        c8_discard [label="DiscardPreview(pageNo, dm)\nEngineMupdf_Preview.cpp\nDISCARD — RestorePageGeometry reverts page to pristine.\nTriggered by ESC / tool-switch / TestAlignDiscard=68.\nFile stays PRISTINE.", fillcolor="#ffcdd2", style=filled];
        c8_restore [label="RestorePreviewIfNeeded(dm)\nEngineMupdf_Preview.cpp\nSAVE PATH — reverts uncommitted preview (hasPreviewGeomEdit\nnot in pendingGeomEdits) before pdf_save_document.\nOnly committed (promoted) edits are persisted.", fillcolor="#c8e6c9", style=filled];
        c8_ctrl [label="Control cmds (SumatraControl.cpp)\nTestAlignQueue = 64  (queue to pendingGeomEdits)\nTestAlignApply = 66  (direct in-memory apply, NOT gated)\nTestAlignCommit = 67  (PromotePreviewToPending)\nTestAlignDiscard = 68  (DiscardPreview)\nTestGeomSave = 65  (fresh-engine headless save, own engine)", fillcolor="#fff9c4", style=filled];

        c8_preview -> c8_commit [label="commit (CmdArchAlignApply=526)"];
        c8_preview -> c8_discard [label="discard (ESC / tool-switch)"];
        c8_commit -> c6_save [label="promoted edits persist at save"];
        c8_restore -> c6_save [style=dashed, label="uncommitted preview reverted"];
    }

    // ============================================================
    // FLOW LINKS
    // ============================================================
    c1_fin -> c8_preview [label="FinalizeAlign → ApplyPreviewGeometry (GUI preview)"];
    c1c_drag -> c8_preview [label="Apply click (CmdArchAlignApply=526):\nApplyPreviewGeometry(pageNo,0,cropBboxPage)\nthen PromotePreviewToPending", color="#4caf50"];
    c1c_drag -> c8_discard [label="tool switch / ESC → DiscardPreview", color="#4caf50"];
    c2_apply -> c4_pass2;
    c3_r3 -> c4_pass2 [style=dashed, label="pass1 output"];
    c2_fix -> c4_red [style=dashed, label="closes the hole"];
    c2_relayout -> c5_paint;
    c1b_mouse -> c1_fin [style=dotted, label="ignore-draw gate (preview active)"];
    c7_cap -> c2_apply [style=dotted, label="capture at 1st apply"];
    l1 -> c3_r2 [style=dotted, color="#d32f2f"];
    l2 -> c3_r3 [style=dotted, color="#d32f2f"];
    c8_preview -> c8_commit [label="commit (CmdArchAlignApply=526)"];
    c8_preview -> c8_discard [label="discard (ESC / tool-switch)"];
    c8_commit -> c6_save [label="promoted edits persist at save"];
    c8_restore -> c6_save [style=dashed, label="uncommitted preview reverted"];
}

// ============================================================
// s64-R5 (2026-11-13) findings + fixes — 4 live-validated Crop Align GUI bugs
// ============================================================
// Bug 1 — selection coords incoherent after righting:
//   Root cause: none in apply path. ApplyPreviewGeometry (EngineMupdf_Preview.cpp)
//   already mirrors ApplyPendingGeometryEditsNow tail: drops cached fz_page +
//   FreeForDisplayModel(dm) + BuildPagesInfo + RelayoutKeepingView, so pageInfo
//   mediabox + render use NEW geometry. No code change needed; tail present.
//   Verified via TestAlignApply mediabox + TestGetPageNo. GUI selection E2E deferred
//   to user live test (no in-proc selection oracle headless).
//
// Bug 2 — toggle-off does NOT discard:
//   Root cause: Commands_ArchTools.cpp HandleCmdArchAlign gated DiscardArchPreview
//   on `win->archTools.toolMode != 5`, but toolMode still == oldMode (5) at that
//   point → condition never true → discard skipped on toggle-off. Mixed
//   preview/pending/appliedInMemory state left live.
//   Fix: call DiscardArchPreview(win) unconditionally when oldMode==5 (line ~162).
//   Escape discard: VK_ESCAPE path exists only for crop drag (Canvas.cpp);
//   align toggle-off + DiscardArchPreview covers the align case.
//
// Bug 3 — repeated line draw accumulates rotation:
//   Root cause: Canvas.cpp OnMouseLeftButtonDown align first-click (line ~2696)
//   only reset when a pendingGeomEdits entry existed for the page AND
//   em->appliedInMemory. A preview (hasPreviewGeomEdit) is NOT in pendingGeomEdits,
//   so the second draw applied on top of the already-mutated page → rotation
//   doubled (consecutive-apply-on-same-engine never tested headless).
//   R5 fix: reset from PagePristineState whenever page is in preview OR
//   appliedInMemory state (DiscardPreview for preview) before placing point1.
//   Verified: apply1==apply2==apply3 mediabox via ad-hoc-s64-align-verify.ts
//   (single Fm0, angle from ORIGINAL).
//   s64-R7: reset-on-second-draw REPLACED by ignore-draw-when-applied gate
//   (Cluster 1b) + ESC discard (Cluster 1b) — no delta-sum accumulation.
//
// Bug 4 — 🔴 dirty dot not lighting:
//   Root cause: EngineMupdfHasUnsavedAnnotations (EngineMupdf.cpp) reads
//   modifiedAnnotations || modifiedPageGeometry || modifiedOutline, but
//   ApplyPreviewGeometry only set hasPreviewGeomEdit + appliedInMemory, NOT
//   modifiedPageGeometry → dot stayed OFF after preview apply.
//   Fix: set modifiedPageGeometry = true in ApplyPreviewGeometry
//   (EngineMupdf_Preview.cpp) so dot lights on preview apply; DiscardPreview
//   clears it; commit keeps lit until save.
// ============================================================
// s64-R7 (2026-11-13) Crop Align — single-line UX, R6 accumulation removed
// ============================================================
// UX: one draw per session — ignore-draw-while-preview gate (Canvas.cpp
// OnMouseLeftButtonDown ignores drag start when this page already has an
// active align preview); ESC discard → pristine (DiscardPreview reverts page
// geometry + clears preview state); toggle-off discard (HandleCmdArchAlign
// calls DiscardArchPreview unconditionally on oldMode==5).
// R6 accumulation REMOVED: alignAppliedAngle / alignAppliedPageNo /
// RestorePageGeometryForAlign / straightened-line deleted.
// totalAngle = residual = absolute angle from pristine (single Fm0, one line
// per session; no delta-sum, no per-page accumulation).

// ============================================================
// s64-R7b (2026-11-13) ESC full-reset + draw re-enable
// ============================================================
// ESC handler (Canvas.cpp WndProcCanvas WM_KEYDOWN VK_ESCAPE, toolMode==5):
//   (1) DiscardPreview(pageNo, dm) — page back to PRISTINE (R7, already in place)
//   (2) Clears ALL align drag state: point1/point2 reset to PointF{},
//       dragLine=0, dragMoved=false, dragStartPos=Point{}, alignLine cleared,
//       ReleaseCapture if capture was ours, mouseAction=None.
//   (3) toolMode UNCHANGED (stays 5) — draw stays enabled, next draw starts
//       from state 0 WITHOUT re-toggle. Fixes stale-drag-state trap: ESC during
//       an active drag (dragLine==1) no longer leaves capture stuck or a stale
//       point pair that breaks the next draw; ignore-draw gate (previewActive)
//       is also satisfied since DiscardPreview clears hasPreviewGeomEdit.
// E2E verified: tests/tmp/s64/ad-hoc-s64-esc-reset.ts (draw1→ESC→draw2→ESC,
// TestAlignCommit: committed/no-preview/committed/no-preview). Build 0/0.
// MD5 out/dbg64/TumatraPDF.exe == ../Compiled/TumatraPDF.exe.

// ============================================================
// s64-R7c (2026-11-13) ESC keeps Crop Align tool ON (toolMode=5)
// ============================================================
// Root cause: SumatraPDF.cpp FrameOnKeydown WM_KEYDOWN VK_ESCAPE sets
// win->archTools.toolMode = 0 for ANY toolMode != 0, including 5 (READ-ONLY,
// cannot fix there). User log proof: "[arch] Esc cancel: draw mode cancelled,
// was mode=5" then toolbar button OFF.
// Fix: Canvas.cpp WndProcCanvas WM_KEYDOWN VK_ESCAPE (line ~7033) returns 0
// (consumes ESC) when canvas has focus, so FrameOnKeydown never runs. toolMode
// stays 5, no HandleCmdArchAlign, no toolbar toggle-off. Log added:
// "[arch] Esc discard (tool stays on)" distinguishes from FrameOnKeydown's
// "[arch] Esc cancel: draw mode cancelled".
// Real-GUI E2E: tests/tmp/s64/ad-hoc-s64-esc-real.ts PASS
//   (draw → real ESC key → draw → ESC, TestAlignCommit: committed/no-preview/
//   committed/no-preview, toolbar stays ON). Build 0/0.
// MD5 b78b9fb8b4bda56d44320e2a710188e7 (out/dbg64 == Compiled).

// ============================================================
// s64-R7d (2026-11-13) ESC discard keeps tool ON via LIVE frame path
// ============================================================
// Root cause: key-handler liveness decided by FOCUS policy. Canvas clicks call
// HwndSetFocus(hwndFrame) (Canvas.cpp/:3629/:4389) -> canvas never has
// keyboard focus -> ESC goes to FRAME -> FrameOnKeydown (SumatraPDF.cpp).
// FrameOnKeydown zeros toolMode=0 on ESC for ANY toolMode incl 5 ("Esc cancel:
