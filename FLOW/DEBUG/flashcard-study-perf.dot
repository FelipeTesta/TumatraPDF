digraph FlashcardStudyPerf {
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Consolas", fontsize=9];
    edge [fontname="Consolas", fontsize=8];
    compound=true;

    // ===================== ENTRY POINTS =====================
    subgraph cluster_entry {
        label="Study=On Transition Entry Points";
        color="#f44336";
        style=dashed;
        penwidth=2.0;

        rate_key [label="Rate key (1-4 / numpad)\n-> HandleFlashcardRate\nCommands_Flashcard.cpp", fillcolor="#ffcdd2", style=filled];
        next_btn [label="Next btn (CmdFlashcardNext)\n-> FlashcardNext (no rate)\nCommands_Flashcard.cpp", fillcolor="#fff9c4", style=filled];
        back_btn [label="Back btn (CmdFlashcardBack)\n-> FlashcardBack (no rate)\nCommands_Flashcard.cpp", fillcolor="#fff9c4", style=filled];
        lista_click [label="Lista row click\n-> FlashcardNavigateToCardInCurrentTab\nFlashcardSidebar.cpp", fillcolor="#fff9c4", style=filled];
        study_tick [label="Timer tick (15.6ms)\n-> FlashcardStudyTick\nCommands_Flashcard.cpp", fillcolor="#e1bee7", style=filled];
        tab_switch [label="Tab switch\n-> FlashcardOnTabChanged\nCommands_Flashcard.cpp", fillcolor="#e1bee7", style=filled];
        order_change [label="Order/Filter dialog apply\n-> FlashcardApplyStudyOrder\nCommands_Flashcard.cpp", fillcolor="#e1bee7", style=filled];
    }

    // ===================== CORE TRANSITION (HandleFlashcardRate) =====================
    subgraph cluster_core {
        label="CORE: HandleFlashcardRate (Commands_Flashcard.cpp)";
        color="#ff9800";
        style=filled;
        fillcolor="#fff3e0";

        hfr_entry [label="HandleFlashcardRate(win, rating)\ncurIdx = win->flashcard.currentCardIdx\ne = studyOrder[curIdx]", fillcolor="#ffcdd2", style=filled];
        scan1 [label="Scan1: find state in studyDoc.states\nBINARY SEARCH O(log S) — states kept SORTED\nFlashcardStudySortStates guarantees invariant on\nload / parse / prune / insert\nFlashcardStudyVerifySorted at insert boundary (debug)\nif found: state = states[foundIdx].state\nelse: insertIdx = insertion point\nFlashcardSm2Update(state, rating)", fillcolor="#ffcdd2", style=filled];
        sm2 [label="FlashcardSm2Update(state, rating)\nSM-2 LITE variant (4 ratings 1=Again/2=Hard/3=Good/4=Easy;\nno repetitions counter, no learning steps, no graduating/easy interval,\nno max interval, no fuzz, no burying; failure reset CHANGES EF\nunlike canonical SM-2 — see FLASHCARD_ALGORITHM.md)", fillcolor="#fff9c4", style=filled];
        relearn [label="rating==1 relearn\nstudyOrder.Append(e)\nFlashcardPrewarmInvalidate()\nO(1) + epoch bump", fillcolor="#fff9c4", style=filled];
        scan2 [label="Scan2: write state back to studyDoc.states\nINSERT at sorted position to maintain invariant\nFlashcardStudyVerifySorted after insert (debug)\nO(log S) lookup + O(S) insert (Vec shift)\nstates kept sorted by key, no duplicate keys\nDedup keeps newest lastReviewedAt", fillcolor="#ffcdd2", style=filled];
        prune [label="FlashcardStudyPruneStates(studyDoc, cards)\nFlashcard.cpp\n-- DEFERRED (coalesced >= 50 ms, study tick) --\nset kFcDirtyPrune=1 + remember tab (pendingSaveTabs)\nNOT run inline on rating\nO(C log C + S) merge pass: sort card keys (VecSort qsort)\nthen merge with sorted states to drop orphans\nInvariant verified after prune (FlashcardStudyVerifySorted)\nFlush: session end / toggle OFF / timer expiry / tab switch /\ntab close / app close / periodic (study tick servicing)\n7 flush points total\nkFcDirtyPrune=1 | kFcDirtySave=2 | kFcDirtySidebar=4", fillcolor="#c8e6c9", style=filled];
        save [label="FlashcardStudySave(filePath, studyDoc)\nFlashcard.cpp\n-- DEFERRED (coalesced >= 50 ms, study tick) --\nset kFcDirtySave=2 + remember tab (pendingSaveTabs)\nNOT run inline on rating\n-- ASYNC SAVE WORKER (FlashcardSaveWorker, BELOW_NORMAL) --\nUI thread: resolve path + snapshot states + enqueue\nWorker writes per-book JSON via FlashcardStudyWriteJsonToFile_BROKEN\n(shared writer serves sync + async — format cannot drift)\nJob carries real docName/docPath (resolved on UI thread)\nWorker drains queue before exit (stop flag under lock + signal)\nRetry up to 3x, 100 ms backoff, truthful 'giving up' log\nNo fake sentinel job, no stray .tmp\nProfile write stays on UI thread (ProfileDataUpdateStudyDoc)\nO(states) I/O — on worker thread, not UI thread\nFlush: same 7 points as prune\nFlashcardFlushBookkeepingSaveOnly: save WITHOUT prune,\nbefore 'save changes?' prompt can cancel it", fillcolor="#c8e6c9", style=filled];
        stats_card [label="FlashcardStatsAddCard(e.tab)\nFlashcardStats.cpp\nFileState.flashcardCardsDone++\nProfileDataAddFlashcardCard\nsidecar daily bucket +1 cards\nO(1) amortized", fillcolor="#fff9c4", style=filled];
        toolbar_count [label="FlashcardToolbarUpdateCount(win)\nO(1)", fillcolor="#fff9c4", style=filled];
        sidebar [label="FlashcardSidebarPopulate(win)\n-- DEFERRED (coalesced >= 50 ms, study tick) --\nset kFcDirtySidebar=4; not run inline on rating\nGATED on win->uiState.fcListVisible: hidden panel skips\nO(cards x states) + page-text extraction per rating\nFlashcardEnsureTabCards calls populate ONLY when fcListVisible\n-- INCREMENTAL UPDATE (eb14afc) --\nFlashcardSidebarUpdateIncremental: one row updated, no\nLB_RESETCONTENT, no page-text extraction\nFalls back to full rebuild (logged) if preconditions fail\nFlush: same 7 points as prune/save\nkFcDirtySidebar=4", fillcolor="#c8e6c9", style=filled];
        advance [label="Advance setup\nrevealMode=false\nstudyTimeSec=0\nlastStudyTick=0\ncurrentCardIdx++", fillcolor="#e1bee7", style=filled];
        session_end [label="if (curIdx >= len(order))\nstudyMode=false\ncurrentCardIdx=-1\nFlashcardStudyTimerStop()", fillcolor="#e1bee7", style=filled];
        prefetch_up [label="FlashcardPrefetchUpcoming(win, curIdx, budget)\nfor i=fromIdx..end-1: INTENTIONAL — currentCardIdx++\nprecedes this call, so fromIdx IS the NEW card\nprefetch warms new card + count-1 following\nengine->GetFzPageInfo(card.pageNo, true)\nextraPages too\nlog '[fc][perf] prefetch idx=%d ... %dms'\n-- FlashcardPrefetchCount (80dc44f) --\nsync page-info prefetch has OWN count\n(floor 1, max tier cap) — never collapses to 0\nTile prewarm still uses FlashcardPrewarmBudget (can be 0)\nBreaks vicious circle: zero prefetch -> cold parse -> slow nav", fillcolor="#fff9c4", style=filled];
        nav [label="FlashcardNavigateToEntry(win, order[curIdx], true)\nwrapper -> inner\nEWWA: 0.7*old + 0.3*dt (clamp 2000ms)\n-- EWMA NOW MEASURES CRITICAL PATH (80dc44f) --\nwhole HandleFlashcardRate duration (totalMs),\nnot just navigate inner\noptional TabsSelect (global session)\nPhysicalToVirtualForRect\ngRenderCache->Exists probe (logged)\nCvtToScreen + ScrollYBy", fillcolor="#e1bee7", style=filled];
        prefetch_render [label="FlashcardPrefetchRenderUpcoming(win, fromIdx)\ncalled from PrefetchUpcoming\nfor (i=fromIdx+1; i<len && done<2; i++)\n  vPage = PhysicalToVirtualPage\n  if (!Exists(dm, vPage, rot, zoom))\n    RequestRendering(dm, vPage)\n  -- REQUEST AS SPECULATIVE (eb14afc) --\n  PageRenderRequest::speculative = true\n  GetNextRequest serves VISIBLE before speculative\n  Full queue evicts speculative entry first\nlog '[fc][perf] prefetch-render idx=%d card=%d page=%d ...'\n  -> requested (speculative)", fillcolor="#fff9c4", style=filled];
        prewarm_enq [label="FlashcardPrewarmEnqueue(win, curIdx)\nidle gate (reveal/mouseAction)\nbudget = FlashcardPrewarmBudget()\nqueue FcWarmJob for d1 (next N) + d2 (other tabs)\ntile requests for same-tab d1 if PageVisibleNearby\nmax 4 concurrent jobs", fillcolor="#e1bee7", style=filled];
        rerender [label="MainWindowRerender(win)\n-> WM_PAINT -> PaintFlashcardMasks\nCanvas.cpp", fillcolor="#e1bee7", style=filled];

        // CRITICAL CHAIN (before repaint): scan/stats/toolbar/sidebar-flag/advance/nav/rerender
        hfr_entry -> scan1 -> sm2 -> relearn -> scan2 -> stats_card -> toolbar_count -> sidebar -> advance -> prefetch_up -> nav -> prefetch_render -> prewarm_enq -> rerender;
        // sidebar node above = flag set only (kFcDirtySidebar=4); populate runs deferred
        advance -> session_end [style=dashed, label="all cards rated"];
        session_end -> rerender [style=dashed];
        session_end -> flush_session_end [style=dotted, label="flush point 1: session end"];
        // DEFERRED CHAIN (coalesced >= 50 ms, study tick / flush points): prune -> save -> sidebar-populate
        deferred [label="DEFERRED BOOKKEEPING\nFlashcardRunDeferredBookkeeping\nCommands_Flashcard.cpp\ncoalesced >= 50 ms, serviced by FlashcardStudyTick\n-> prune (kFcDirtyPrune=1) THEN save (kFcDirtySave=2)\nper remembered tab, prune BEFORE save\n-> sidebar populate (kFcDirtySidebar=4), window-level\nclears pendingSaveTabs + dirtyFlags; sets lastBookkeepingTick\n-- ASYNC SAVE WORKER --\nFlashcardSaveWorker (BELOW_NORMAL priority)\nUI: resolve path + snapshot states + enqueue\nWorker: FcSaveWriteJob via FlashcardStudyWriteJsonToFile\n(shared writer, sync + async — format cannot drift)\nRetry up to 3x, 100 ms backoff, truthful 'giving up' log\nWorker drains queue before exit (stop flag under lock + signal)\nProfile write on UI thread (ProfileDataUpdateStudyDoc)\n7 FLUSH POINTS: session end / toggle OFF / timer expiry /\ntab switch / tab close / app close / periodic (study tick)\nFlashcardFlushBookkeepingSaveOnly: save WITHOUT prune,\nbefore 'save changes?' prompt can cancel it", fillcolor="#c8e6c9", style=filled];
        prune -> deferred [style=dotted, label="dirty flag set, not run inline"];
        save -> deferred [style=dotted, label="dirty flag set, not run inline"];
        sidebar -> deferred [style=dotted, label="dirty flag set, not run inline"];
        deferred -> rerender [style=dotted, label="serviced later by tick/flush (>=50ms)"];
    }

    // 7 FLUSH POINTS (FlashcardFlushBookkeeping, declared MainWindow.h)
    subgraph cluster_flush {
        label="FLUSH POINTS (invoke FlashcardFlushBookkeeping -> deferred chain)";
        color="#f44336";
        style=dashed;
        penwidth=2.0;
        flush_session_end [label="1. Session end\n(last card rated)\nCommands_Flashcard.cpp", fillcolor="#ffe0b2", style=filled];
        flush_toggle_off [label="2. Study toggle OFF\n(studyMode=false)\nCommands_Flashcard.cpp", fillcolor="#ffe0b2", style=filled];
        flush_timer_expiry [label="3. Study-session timer expiry\n(periodic, study tick servicing)\nFlashcardStudyTick\nCommands_Flashcard.cpp", fillcolor="#ffe0b2", style=filled];
        flush_tab_switch [label="4. Tab switch\nFlashcardOnTabChanged\nCommands_Flashcard.cpp", fillcolor="#ffe0b2", style=filled];
        flush_tab_close [label="5. Tab close (CloseTab)\nSumatraPDF.cpp", fillcolor="#ffe0b2", style=filled];
        flush_app_close [label="6. App/window close (CloseWindow)\nSumatraPDF.cpp", fillcolor="#ffe0b2", style=filled];
        flush_periodic [label="7. Periodic\n(study tick servicing >= 50 ms)\nFlashcardStudyTick\nCommands_Flashcard.cpp", fillcolor="#ffe0b2", style=filled];
        flush_session_end -> deferred [style=dotted];
        flush_toggle_off -> deferred [style=dotted];
        flush_timer_expiry -> deferred [style=dotted];
        flush_tab_switch -> deferred [style=dotted];
        flush_tab_close -> deferred [style=dotted];
        flush_app_close -> deferred [style=dotted];
        flush_periodic -> deferred [style=dotted];
    }

    // ===================== DATA STRUCTURES =====================
    subgraph cluster_datastructs {
        label="Data Structures & Sizes/Complexities";
        color="#4285f4";
        style=filled;
        fillcolor="#e3f2fd";

        fq_entry [label="FlashcardQueueEntry (Commands_Flashcard.cpp)\nstruct {\n  WindowTab* tab;\n  int cardIdx; // index into tab->flashcard.cards\n}\nVec<FlashcardQueueEntry> studyOrder — session queue", fillcolor="#bbdefb", style=filled];
        fc_card [label="Flashcard (Flashcard.h)\nstruct {\n  u64 key; // hash(pageNo, bounds)\n  int pageNo; // physical page (1-based)\n  RectF bounds; // cloze rect on page\n  Vec<ExtraPage> extraPages; // cross-page groups\n  // ... other fields\n}\nVec<Flashcard> cards — per-tab, all cards in doc", fillcolor="#bbdefb", style=filled];
        study_doc [label="FlashcardStudyDoc (Flashcard.h)\nstruct {\n  int version;\n  Vec<StateEntry> states;\n};\nstruct StateEntry { u64 key; FlashcardStudyState state; };\nstates.len = number of cards ever rated in this book\npersisted as JSON per book (md5 filename)", fillcolor="#bbdefb", style=filled];
        fc_state [label="FlashcardStudyState (Flashcard.h)\nstruct {\n  int rating; // 0=new, 1-4\n  int interval; // days\n  float easeFactor; // [1.3, 2.5]\n  i64 lastReviewedAt; // unix ms\n  i64 nextReviewAt; // unix ms\n  int reviewCount;\n}", fillcolor="#bbdefb", style=filled];
        tab_state [label="FlashcardTabState (WindowTab.h)\nstruct {\n  Vec<Flashcard> cards;\n  FlashcardStudyDoc studyDoc;\n  Str filterExpr;\n  bool filterEnabled;\n  bool cardsLoaded;\n  Vec<Vec<int>> cardIndicesByPage; // NEW: physical page -> card indices\n  //   rebuilt at ALL 6 writers of tab->flashcard.cards\n}\nPer-tab, lazy-loaded on first toggle/tab switch", fillcolor="#bbdefb", style=filled];
        win_fc [label="MainWindow::FlashcardState (MainWindow.h)\nstruct {\n  bool on, studyMode, revealMode;\n  Vec<FlashcardQueueEntry> studyOrder;\n  int currentCardIdx; // -1 = none\n  float studyTimeSec; // per-card accumulator\n  u64 lastStudyTick; // GetTickCount64\n  u64 lastRateTick; // NEW: rating-start timestamp (keypress->paint probe)\n  bool rateProbePending; // NEW: armed on rating, consumed on first paint\n  double cardSwitchMsEwma; // adaptive prewarmer signal\n  int prewarmFilledForIdx; // dedupe prewarm enqueue\n  Vec<FcListRow> listaRows; // sidebar cache\n  WindowTab* activeListCardTab;\n  int activeListCardIdx;\n  u32 dirtyFlags; // NEW: kFcDirtyPrune=1, kFcDirtySave=2, kFcDirtySidebar=4\n  Vec<WindowTab*> pendingSaveTabs; // NEW: remembered rated tabs,\n  //   dupes suppressed vs last element\n  u64 lastBookkeepingTick; // NEW: last deferred-service time\n  int listaIncrementalCardIdx; // NEW: tracked card for incremental sidebar\n  WindowTab* listaIncrementalCardTab; // NEW\n  // ... timer fields\n}\nFlags: kFcDirtyPrune=1, kFcDirtySave=2, kFcDirtySidebar=4\n(MainWindow.h)", fillcolor="#bbdefb", style=filled];
        warm_job [label="FcWarmJob (Commands_Flashcard.cpp)\nstruct {\n  u32 epoch;\n  WindowTab* tab;\n  DisplayModel* dm;\n  EngineMupdf* engine;\n  int pageNo;\n  Vec<int> extraPages;\n  bool wantTile;\n  int vPage;\n}\ngFcWarmQueue: Vec<FcWarmJob>\ngFcWarmActive: int (in-flight)\ngFcWarmEpoch: u32 (invalidation counter)", fillcolor="#bbdefb", style=filled];
        render_cache [label="gRenderCache (RenderCache.cpp)\nTile cache keyed by (dm, vPage, rotation, zoom)\nExists(dm, vPage, rot, zoom) -> bool\nRequestRendering(dm, vPage) -> async\nPageVisibleNearby(vPage) -> current +-1\nMAX_PAGE_REQUESTS = 8", fillcolor="#bbdefb", style=filled];
        page_text [label="PageText (FlashcardSidebar.cpp)\nstruct { Str text; int pageNo; };\nPer-page cache: pt (text) + ptPage (pageNo)\nUsed by FcListCardLabelTemp for masked label\nextracted via ExtractPageTextLocked (stext)", fillcolor="#bbdefb", style=filled];

        fq_entry -> fc_card -> study_doc -> fc_state -> tab_state -> win_fc -> warm_job -> render_cache -> page_text;
    }

    // ===================== LOCK / THREAD TOPOLOGY =====================
    subgraph cluster_threads {
        label="Lock / Thread Topology (what blocks UI)";
        color="#9c27b0";
        style=dashed;
        penwidth=2.0;

        ui_thread [label="UI THREAD (MainWindow message loop)\nRUNS:\n- HandleFlashcardRate (critical path only: scan/stats/toolbar/nav/rerender)\n- FlashcardStudyTick (timer callback)\n- FlashcardRunDeferredBookkeeping (prune->save->sidebar, >=50ms)\n   STILL ON UI THREAD — moved OUT of critical path, NOT off-thread\n   (honest limitation: deferred work is UI-thread)\n- FlashcardPrefetchUpcoming (GetFzPageInfo sync)\n- FlashcardNavigateToEntryInner (TabsSelect + scroll)\n- PaintFlashcardMasks (per-paint)\n- ProfileDataUpdateStudyDoc (profile write, NOT thread-safe)\n- FlashcardStudySaveAsync (resolve path + snapshot + enqueue only)\nBLOCKED BY:\n- gFcWarmLock (brief, in PrewarmEnqueue/Invalidate)\n- e->docLock (ScopedRecursiveMutex, if engine calls)\n- filesystem (AV, MoveFileExW — only at flush points, sync path)\nNOT blocked by: per-book JSON write (offloaded to save worker)", fillcolor="#ffcdd2", style=filled];
        save_worker [label="SAVE WORKER THREAD (NEW)\nFlashcardSaveWorker (Commands_Flashcard.cpp)\nTHREAD_PRIORITY_BELOW_NORMAL\nLoop:\n  EnterCriticalSection(&gFcSaveLock)\n  pop job from gFcSaveQueue (or break if gFcSaveStop)\n  LeaveCriticalSection\n  FcSaveWriteJob(job): fopen .tmp -> FlashcardStudyWriteJsonToFile\n    -> fclose -> MoveFileExW\n  On failure: retry up to 3x, 100 ms backoff,\n    truthful 'giving up' log, drop job\n  On exit: drain queue (stop flag under lock + signal)\n  gFcSaveActive tracks in-flight jobs\nDOES NOT BLOCK UI (BELOW_NORMAL, queue + lock)\nJoined at app exit (3s bounded timeout)\nNever touches live studyDoc — works on SNAPSHOT", fillcolor="#c8e6c9", style=filled];

        ui_thread -> prewarm_thread [style=dotted, label="posts jobs via gFcWarmSignal"];
        ui_thread -> save_worker [style=dotted, label="enqueues via SetEvent(gFcSaveSignal)"];
        ui_thread -> lock_fc [style=dotted, label="brief Enter/Leave"];
        prewarm_thread -> lock_fc [style=dotted, label="brief Enter/Leave"];
        prewarm_thread -> doc_lock [style=dotted, label="GetFzPageInfo takes lock"];
        ui_thread -> doc_lock [style=dotted, label="various calls take lock"];
        render_thread -> doc_lock [style=dotted, label="RenderPage takes lock"];
    }

    // ===================== CACHE LAYERS =====================
    subgraph cluster_caches {
        label="Cache Layers & Hit/Miss Semantics";
        color="#795548";
        style=filled;
        fillcolor="#efebe9";

        fz_cache [label="MuPDF fz_page cache (internal)\nGetFzPageInfo(pageNo, loadQuick=true)\nloadQuick = page dict + annots only\n(no stext, no render)\nSub-ms when cached; few ms first-touch\nPer-DisplayModel, survives session", fillcolor="#bbdefb", style=filled];
        render_cache2 [label="gRenderCache tiles\nKey: (dm, vPage, rotation, zoom)\nExists() -> bool (O(1) newest-first scan)\nRequestRendering() -> async, queued\nPageVisibleNearby(vPage) = current +-1\nTile evicted on: zoom change, relayout, dark mode epoch\nPaintFlashcardMasks uses CvtToScreen -> blits from cache", fillcolor="#bbdefb", style=filled];
        page_text_cache [label="PageText cache (per populate)\nFlashcardSidebar.cpp pt/ptPage\nSingle page cached during one Populate\nFreed at end (FreePageText)\nNOT persisted across populate calls\nExtractPageTextLocked -> fz_stext_page -> fz_extract_text", fillcolor="#fff9c4", style=filled];
        study_doc_mem [label="studyDoc in memory (FlashcardTabState)\nFlashcardStudyDoc::states Vec\nModified on every rating (scan1/scan2/prune)\nFlushed to disk by FlashcardStudySave\nLoaded by FlashcardStudyLoad at toggle/tab switch\nProfileData holds merged copy (newest-wins)", fillcolor="#c8e6c9", style=filled];
        study_disk [label="study JSON on disk\n<study-dir>/<md5-path>.json\nWritten by FlashcardStudySave (tmp + MoveFileExW)\nRead by FlashcardStudyLoad (file::ReadFile + JSON parse)\nLegacy fallback: app-data/FlashcardStudy/<md5>.json\nProfile adopt: ProfileDataGetStudyDoc", fillcolor="#c8e6c9", style=filled];

        fz_cache -> render_cache2 -> page_text_cache -> study_doc_mem -> study_disk;
    }

    // ===================== PERF HYPOTHESES (with how-to-measure) =====================
    subgraph cluster_hypotheses {
        label="PERF HYPOTHESES (with HOW TO MEASURE)";
        color="#ff9800";
        style=dashed;
        penwidth=2.0;

        h1_dbg [label="H1. Prune O(C log C + S) merge pass\nFlashcard.cpp\nSTATUS: IMPLEMENTED (e550105 + eb59cc3)\nSort card keys (VecSort qsort) + merge with sorted states\nPrune moved out of critical path (kFcDirtyPrune=1,\npendingSaveTabs, flush at 7 points)\nDebug gate: FlashcardStudyVerifySorted at prune boundary\nHOW TO MEASURE:\n  Log '[fc][perf] deferred: prune=%dms ...'\n  Run with 100/500/1000 cards; verify prune ms stays low\nCONFIRM: prune no longer blocks repaint", fillcolor="#c8e6c9", style=filled];
        h2_dbg [label="H2. StudySave async worker + shared writer\nFlashcard.cpp\nSTATUS: IMPLEMENTED (fb37717 + 839e670)\nSave moved out of critical path (kFcDirtySave=2,\npendingSaveTabs, flush at 7 points)\nUI thread: snapshot + enqueue; worker writes JSON\nFlashcardStudyWriteJsonToFile shared writer (sync + async)\nRetry up to 3x, 100 ms backoff, 'giving up' log\nHOW TO MEASURE:\n  Log '[fc][perf] deferred: ... save=%dms ...'\n  ProcMon: worker writes .tmp + MoveFileExW\nCONFIRM: save ms in deferred line is snapshot+enqueue only", fillcolor="#c8e6c9", style=filled];
        h3_dbg [label="H3. SidebarPopulate visibility gate + incremental\nFlashcardSidebar.cpp\nSTATUS: IMPLEMENTED (19c4f00 + eb14afc)\nGated on fcListVisible: hidden panel skips per-rating cost\nkFcDirtySidebar=4; runs coalesced via study tick\nFlashcardSidebarUpdateIncremental: one row updated\nFalls back to full rebuild (logged)\nHOW TO MEASURE:\n  Close Lista panel -> measure transition time\n  Log '[fc][perf] deferred: ... sidebar=%dms ...'\nCONFIRM: Lista closed = instant, open = fast (incremental)", fillcolor="#c8e6c9", style=filled];
        h4_dbg [label="H4. Prefetch start index (corrected: intentional)\nCommands_Flashcard.cpp\ncurrentCardIdx++ PRECEDES prefetch call\n-> fromIdx IS the new card; warming it is intentional\nOLD 'off-by-one' claim was WRONG (C-CORR-1)\nFlashcardPrefetchCount: floor 1, max tier cap\nHOW TO VERIFY: log shows prefetch idx = currentCardIdx", fillcolor="#fff9c4", style=filled];
        h5_dbg [label="H5. PrewarmInvalidate drain loop\nFlashcard.cpp\nSTATUS: RESOLVED (80dc44f — loop REMOVED)\nDead drain loop deleted. Worker epoch filter\ndrops stale jobs instead. No actual wait ever happened.\nHOW TO MEASURE: no drain-loop code remains\nCONFIRM: code inspection confirms removal", fillcolor="#c8e6c9", style=filled];
        h6_dbg [label="H6. EWMA measures CRITICAL PATH\nCommands_Flashcard.cpp\nSTATUS: RESOLVED (80dc44f)\nEWWA wraps entire HandleFlashcardRate (totalMs),\n0.7/0.3 smoothing, 2000 ms clamp\nPrefetch floor (FlashcardPrefetchCount >= 1) breaks\nvicious circle on weak machines\nHOW TO MEASURE:\n  Log '[fc][perf] rate: ... total=%dms ...'\n  Compare ewma vs real transition time\nCONFIRM: ewma reflects real cost, not just navigate", fillcolor="#c8e6c9", style=filled];
        h7_dbg [label="H7. Tier cap = 0 on weak machines\nFlashcard.cpp\nSTATUS: OPEN (tile prewarm only)\nFlashcardPrewarmBudget returns 0 on <=2 cores / <4GB RAM\nTile prewarm silently does nothing on low-end machines\nBUT: FlashcardPrefetchCount returns 1 (floor) for page-info\nprefetch — breaks vicious circle for sync path\nHOW TO MEASURE:\n  Run on 2-core / <4GB VM\n  Observe log '[fc][perf] prewarm skipped: n=0'\nCONFIRM: prefetch still works (count=1), tile prewarm = 0", fillcolor="#fff9c4", style=filled];

        h1_dbg -> h2_dbg -> h3_dbg -> h4_dbg -> h5_dbg -> h6_dbg -> h7_dbg;
    }

    // ===================== IMPROVEMENT OPTIONS (detailed) =====================
    subgraph cluster_opts {
        label="IMPROVEMENT OPTIONS (5 fields each)";
        color="#4caf50";
        style=dashed;
        penwidth=2.0;

        o1_dbg [label="O1. Hash-set prune / amortize\nFILE: Flashcard.cpp\nSTATUS: IMPLEMENTED (e550105)\nRepo-native sorted Vec + binary search (no STL per C-F9)\nFlashcardStudySortStates: VecSort (qsort) + dedup pass\nO(N log N) sort, O(log S) lookup, O(C log C + S) prune merge\nInvariant guaranteed on EVERY load path\nDebug gate: FlashcardStudyVerifySorted at load/parse/prune/insert\nGAIN: Eliminate nested loop on EVERY prune\nBREAKS: Nothing — done correctly", fillcolor="#c8e6c9", style=filled];
        o2_dbg [label="O2. Debounce/coalesce StudySave\nFILE: Flashcard.cpp\nSTATUS: IMPLEMENTED (eb59cc3 + fb37717 + 839e670)\nDeferred via kFcDirtySave + pendingSaveTabs;\nflush at 7 points (session end / toggle OFF / timer expiry /\ntab switch / tab close / app close / periodic)\nASYNC: FlashcardSaveWorker (BELOW_NORMAL), per-book JSON write\non worker thread, FlashcardStudyWriteJsonToFile shared writer\nProfile write stays on UI thread (ProfileData is not thread-safe)\nFlashcardFlushBookkeepingSaveOnly: save WITHOUT prune,\nbefore 'save changes?' prompt can cancel it\nGAIN: Eliminate per-rating disk I/O + AV latency\nRISK: Data loss on crash (~60s window, SM-2 state only)\nBREAKS: Config window expects file to reflect latest (adopt)", fillcolor="#c8e6c9", style=filled];
        o3_dbg [label="O3. Incremental SidebarPopulate\nFILE: FlashcardSidebar.cpp\nSTATUS: IMPLEMENTED (eb14afc)\nFlashcardSidebarUpdateIncremental: one row updated, no\nLB_RESETCONTENT, no page-text extraction\nPreconditions: Lista HWNDs + fcListVisible + same tab +\nstudyOrderIdx valid + listaRows count matches listbox count\nFalls back to full rebuild (logged)\nGAIN: O(1) per rating vs O(cards x states) + n LB msgs\nRISK: Listbox API quirks; selection/scroll preservation\nBREAKS: Nothing if row data structure unchanged", fillcolor="#c8e6c9", style=filled];
        o4_dbg [label="O4. Skip visible page in render prefetch (prefetch start is intentional)\nFILE: Commands_Flashcard.cpp\nSTATUS: RESOLVED (C-CORR-1 — do NOT change start index)\ncurrentCardIdx++ precedes prefetch call; fromIdx = NEW card\nGAIN: none needed — warming new card is intentional\nBREAKS: Nothing", fillcolor="#c8e6c9", style=filled];
        o5_dbg [label="O5. Whole-transition EWMA\nFILE: Commands_Flashcard.cpp\nSTATUS: RESOLVED (80dc44f)\nEWWA wraps entire HandleFlashcardRate (totalMs),\n0.7/0.3 smoothing, 2000 ms clamp\nPrefetch floor (FlashcardPrefetchCount >= 1) breaks\nvicious circle; tile prewarm still gated by FlashcardPrewarmBudget\nGAIN: Prewarmer budget reacts to REAL transition cost\nRISK: Ewma noisier; N=150/ewma calibration may need retune\nBREAKS: Prewarm budget behavior changes", fillcolor="#c8e6c9", style=filled];
        o6_dbg [label="O6. Fix/remove dead drain loop\nFILE: Flashcard.cpp\nSTATUS: RESOLVED (80dc44f — loop REMOVED)\nDead drain loop deleted. Worker epoch filter drops stale jobs.\nNo actual wait ever happened (condition always false).\nGAIN: Prevent stale in-flight contending docLock/CPU\nRISK: None (removal is safe)\nBREAKS: Nothing if epoch check solid", fillcolor="#c8e6c9", style=filled];
        o7_dbg [label="O7. Offload disk work to worker thread\nFILE: Flashcard.cpp + Commands_Flashcard.cpp\nSTATUS: IMPLEMENTED (fb37717 + 839e670)\nFlashcardSaveWorker (BELOW_NORMAL priority) + FcSaveQueue\nUI: resolve path + snapshot states + enqueue (FlashcardStudySaveAsync)\nWorker: FcSaveWriteJob via FlashcardStudyWriteJsonToFile\n(shared writer, sync + async — format cannot drift)\nJob carries real docName/docPath (resolved on UI thread)\nWorker drains queue before exit (stop flag under lock + signal)\nNo fake sentinel job, no stray .tmp\nRetry up to 3x, 100 ms backoff, truthful 'giving up' log\nProfile write stays on UI thread (gProfile has NO locks)\nFlashcardFlushBookkeepingSaveOnly: save WITHOUT prune,\nbefore 'save changes?' prompt (CloseTab, CloseAllDocumentTabsForUnsync,\nCloseWindow); full flush runs only after prompt succeeds\nGAIN: UI thread never blocks on per-book JSON I/O\nRISK: Complex state sync; crash safety\nBREAKS: Config window 'Re-check' expects up-to-date files", fillcolor="#c8e6c9", style=filled];

        o1_dbg -> o2_dbg -> o3_dbg -> o4_dbg -> o5_dbg -> o6_dbg -> o7_dbg;
    }

    // ===================== COMPLETE CALL GRAPH =====================
    subgraph cluster_callgraph {
        label="COMPLETE CALL GRAPH: One Card Transition (rate key)";
        color="#f44336";
        style=dashed;
        penwidth=2.0;

        cg1 [label="HandleFlashcardRate (Commands_Flashcard.cpp)\n  -> arm keypress->paint probe (lastRateTick, rateProbePending)\n  -> scan1: binary search studyDoc.states (O(log S), SORTED)\n  -> FlashcardSm2Update\n  -> rating==1: studyOrder.Append + FlashcardPrewarmInvalidate\n  -> scan2: insert state at sorted position (O(S))\n  -> FlashcardStudyVerifySorted (debug)\n  -> set kFcDirtyPrune=1 + pendingSaveTabs (deferred)\n  -> set kFcDirtySave=2 + pendingSaveTabs (deferred)\n  -> FlashcardStatsAddCard (synchronous, O(1) amortized)\n  -> track card for incremental sidebar (listaIncrementalCardIdx)\n  -> FlashcardToolbarUpdateCount (synchronous, O(1))\n  -> set kFcDirtySidebar=4 (deferred)\n  -> advance setup (revealMode=false, studyTimeSec=0, lastStudyTick=0,\n     currentCardIdx++)\n  -> if session end: studyMode=false, currentCardIdx=-1,\n     FlashcardStudyTimerStop, FlashcardFlushBookkeeping\n  -> else:\n       FlashcardPrefetchUpcoming (FlashcardPrefetchCount >= 1)\n       FlashcardNavigateToEntry (EWMA = totalMs)\n       FlashcardPrewarmEnqueue\n  -> MainWindowRerender -> WM_PAINT -> PaintFlashcardMasks\n     (Canvas.cpp: visible pages only, cardIndicesByPage,\n      keypress->paint probe consumed once)\n  -> log '[fc][perf] rate: ... total=%dms ...'\n  -> EWMA update (0.7/0.3, clamp 2000ms)\n  -> if session ended: FlashcardFlushBookkeeping (flush point 1)", fillcolor="#ffcdd2", style=filled];

        cg2 [label="FlashcardStudyPruneStates (Flashcard.cpp)\n  O(C log C + S) merge pass:\n  1. Copy card keys, VecSort (qsort) — O(C log C)\n  2. Merge pass with sorted states — O(C + S)\n  3. Keep only states whose key exists in cardKeys\n  4. FlashcardStudyVerifySorted (debug)\n  Complexity: O(C log C + S) where S = states, C = cards\nCALL SITES:\n  FlashcardRunDeferredBookkeeping (deferred, kFcDirtyPrune=1)\n  FlashcardLoadFromDocument (load path)", fillcolor="#fff9c4", style=filled];

        cg3 [label="FlashcardStudySave (Flashcard.cpp)\n  -- SYNC path (adopt/resync/load) --\n  path = FlashcardStudyPath(filePath)\n  fopen .tmp -> FlashcardStudyWriteJsonToFile -> fclose\n  MoveFileExW(MOVEFILE_REPLACE_EXISTING)\n  fallback: remove + rename\n  ProfileDataUpdateStudyDoc\n\n  -- ASYNC path (deferred bookkeeping) --\n  UI thread: resolve path + snapshot states + docName/docPath\n  FlashcardStudySaveAsync(statesSnapshot, ...) -> enqueue to worker\n  Worker (BELOW_NORMAL): FcSaveWriteJob via\n    FlashcardStudyWriteJsonToFile (SHARED writer)\n  Retry up to 3x, 100 ms backoff, 'giving up' log\n  Worker drains queue before exit (stop flag + signal)\n  Profile write stays on UI thread\n\nCALL SITES:\n  FlashcardRunDeferredBookkeeping (deferred, kFcDirtySave=2)\n  FlashcardFlushBookkeepingSaveOnly (save without prune,\n   before 'save changes?' prompt)\n  FlashcardToolbar.cpp (clean-selected, clean-all)", fillcolor="#fff9c4", style=filled];

        cg4 [label="FlashcardSidebarPopulate (FlashcardSidebar.cpp)\n  -- DEFERRED (kFcDirtySidebar=4) --\n  GATED on win->uiState.fcListVisible: hidden panel skips\n  if !hwndListaBox: return\n  LB_RESETCONTENT\n  for each card in tab->cards:\n    linear scan studyDoc.states\n    FcListCardLabelTemp (ExtractPageText)\n    LB_ADDSTRING + LB_SETITEMDATA\n  FreePageText\n  O(cards x states) + text + n msgs\n\n-- INCREMENTAL (eb14afc) --\nFlashcardSidebarUpdateIncremental:\n  one row updated, no LB_RESETCONTENT, no page-text extraction\n  Preconditions: Lista HWNDs + fcListVisible + same tab +\n    studyOrderIdx valid + listaRows count matches listbox count\n  Falls back to full rebuild (logged) if any precondition fails\n\nCALL SITES:\n  FlashcardRunDeferredBookkeeping (deferred, kFcDirtySidebar=4)\n  Commands_Flashcard.cpp (FlashcardOnTabChanged)\n  Commands_Flashcard.cpp (CmdFlashcardToggle OFF)\n  Commands_Flashcard.cpp (FlashcardEnsureTabCards, only if fcListVisible)\n  FlashcardToolbar.cpp (clean-selected)\n  FlashcardToolbar.cpp (clean-all)\n  FlashcardSidebar.cpp (ctrl+click select)", fillcolor="#fff9c4", style=filled];

        cg5 [label="FlashcardPrefetchUpcoming (Commands_Flashcard.cpp)\n  end = min(fromIdx + count, len(order))\n  -- FlashcardPrefetchCount: floor 1, max tier cap --\n  count >= 1 ALWAYS (never collapses to 0)\n  for i=fromIdx..end-1: INTENTIONAL — currentCardIdx++\n  precedes this call, so fromIdx = NEW card\n    e = order[i]\n    engine->GetFzPageInfo(card.pageNo, true)\n    extraPages too\n    log '[fc][perf] prefetch idx=%d ... %dms'\n  FlashcardPrefetchRenderUpcoming(win, fromIdx)\n    -> RequestRendering(dm, vPage) AS SPECULATIVE\nCALL SITES:\n  Commands_Flashcard.cpp (HandleFlashcardRate)\n  Commands_Flashcard.cpp (FlashcardApplyStudyOrder)\n  Commands_Flashcard.cpp (CmdFlashcardNext — reset prewarmFilledForIdx)", fillcolor="#fff9c4", style=filled];

        cg6 [label="FlashcardNavigateToEntryInner (Commands_Flashcard.cpp)\n  if CurrentTab != e.tab: TabsSelect (sync)\n  dm = e.tab->AsFixed()\n  vr = card.bounds\n  vPage = PhysicalToVirtualForRect(card.pageNo, card.bounds, &vr)\n  if gRenderCache:\n    cached = Exists(dm, vPage, rot, zoom)\n    log '[fc][perf] navigate: card=%d cached=%d'\n  screenRect = CvtToScreen(vPage, vr)\n  if centerVertically:\n    dy = screenRect.y + dy/2 - vpdy/2\n    ScrollYBy(dy, false)\nCALL SITES:\n  Commands_Flashcard.cpp (FlashcardNavigateToEntry wrapper)\n  Commands_Flashcard.cpp (FlashcardNavigateToCardInCurrentTab — Lista)", fillcolor="#e1bee7", style=filled];

        cg7 [label="FlashcardPrewarmEnqueue (Commands_Flashcard.cpp)\n  prewarmFilledForIdx = fromIdx\n  if fromIdx+1 >= len(order): return\n  if revealMode || mouseAction!=None: return (idle gate)\n  FlashcardPrewarmEnsureWorker()\n  n = FlashcardPrewarmBudget(win)\n  if n<=0: log skipped, return\n  n2 = n+2; tileReqs=0; nWarmed=0\n  for i=fromIdx+1..fromIdx+n2:\n    isD1 = i<=fromIdx+n\n    sameTab = e.tab == CurrentTab()\n    if !isD1 && sameTab: continue\n    if !isD1: cap 2 warm docs\n    job = {epoch, tab, dm, engine, pageNo, extraPages}\n    if isD1 && sameTab && tileReqs<2 && PageVisibleNearby:\n      job.wantTile=true; job.vPage=vPage; tileReqs++\n    push job to gFcWarmQueue (cap 4 total)\n    SetEvent(gFcWarmSignal)\nCALL SITES:\n  Commands_Flashcard.cpp (HandleFlashcardRate)\n  Commands_Flashcard.cpp (FlashcardApplyStudyOrder)\n  Commands_Flashcard.cpp (FlashcardStudyTick — idle pump)", fillcolor="#e1bee7", style=filled];

        cg8 [label="PaintFlashcardMasks (Canvas.cpp)\n  if !flashcard.on: return\n  cards = &CurrentTab()->flashcard.cards\n  studyCardIdx = active card index (if same tab)\n  listCardIdx = Lista-selected card index (if same tab)\n  -- VISIBLE PAGES ONLY (8de6a69) --\n  Build visiblePhysPages from dm->pagesInfo:\n    physical page visible if ANY virtual page has\n    visibleRatio > 0 (TC2 right column correct)\n  Always include: active card's pages + Lista-selected card's pages\n  -- cardIndicesByPage index (rebuilt at ALL 6 writers) --\n  if index built: iterate only visible phys pages,\n    paint cards from pageIndex[physPage]\n  else: fallback — iterate ALL cards\n  paintPage: PhysicalToVirtualForRect -> CvtToScreen ->\n    cull against viewportRect -> draw rect\n  Ctrl+Alt rects painted INDIVIDUALLY (not union)\n  Phantom move/resize handles gone\n  -- KEYPRESS->PAINT PROBE (arm/consume) --\n  if rateProbePending && active card page rendered from\n    cached tile: measure deltaMs, log once, clear flag\n  '[fc][perf] paint: keypress->paint=%dms card=%d page=%d cached=%d'\nCALL SITES:\n  Canvas.cpp DrawDocument loop (per paint)", fillcolor="#e1bee7", style=filled];

        cg1 -> cg2 -> cg3 -> cg4 -> cg5 -> cg6 -> cg7 -> cg8;
    }

    // ===================== NEW FINDINGS (C-F1..C-F9) =====================
    subgraph cluster_newfindings {
        label="NEW FINDINGS (C-F1..C-F9, verified in code)";
        color="#9c27b0";
        style=dashed;
        penwidth=2.0;

        c_f1 [label="C-F1 Lista visibility gate\nFlashcardSidebar.cpp\n-- IMPLEMENTED (19c4f00) --\nGated on win->uiState.fcListVisible: hidden panel skips\nO(cards x states) + page-text extraction per rating\nFlashcardEnsureTabCards calls FlashcardSidebarPopulate\nONLY when fcListVisible\nHWNDs destroyed ONLY on flashcard mode OFF\nFlashcardSidebarToggle merely toggles fcListVisible\nCheap visibility win — panel no longer pays per-rating cost", fillcolor="#c8e6c9", style=filled];
        c_f2 [label="C-F2 text cache lifetime\nFlashcardSidebar.cpp\nPageText pt/ptPage cache is LOCAL to one Populate call\n-> P text extractions per rating, NEVER reused between ratings\npt/ptPage freed at end (FreePageText)", fillcolor="#ffe0b2", style=filled];
        c_f3 [label="C-F3 paint cost\nCanvas.cpp PaintFlashcardMasks\n-- OPTIMIZED (8de6a69 + 6c55353) --\nPaint ONLY visible pages (visibleRatio > 0 on ANY virtual page)\nPer-tab index cardIndicesByPage: physical page -> card indices\n(primary + extraPages), rebuilt at ALL 6 writers of\ncards array\nActive card + Lista-selected card always included\nFull-iteration fallback when index missing\nHonest complexity: O(cards on visible pages x Q) — NOT O(1)\nCtrl+Alt rects painted INDIVIDUALLY (not one union)\nPhantom move/resize handles gone\nExisting log: '[fc] paint: %d cards, %d rects drawn, %.3f ms/paint avg'", fillcolor="#c8e6c9", style=filled];
        c_f4 [label="C-F4 render queue priority\nRenderCache.cpp\n-- FIXED (eb14afc) --\nPageRenderRequest::speculative flag\nGetNextRequest serves VISIBLE request before speculative one\nFull queue evicts speculative entry first\nDuplicate request: visible keeps priority over speculative\nVisible incoming overwrites speculative existing\nLog: '[fc][perf] renderq: serving visible over %d speculative'", fillcolor="#c8e6c9", style=filled];
        c_f5 [label="C-F5 vicious circle: same budget gates sync + async\n-- FIXED (80dc44f) --\nFlashcardPrefetchCount: sync page-info prefetch has OWN count\n(floor 1, max tier cap) — never collapses to 0\nFlashcardPrewarmBudget still gates tile prewarm (can be 0)\nDead drain loop REMOVED from FlashcardPrewarmInvalidate\nEWWA measures CRITICAL PATH (totalMs), not just navigate inner\nBreaks: zero prefetch -> cold parse -> slow nav -> low EWMA", fillcolor="#c8e6c9", style=filled];
        c_f6 [label="C-F6 two file writes per rating, not one\n-- FIXED (fb37717 + 839e670) --\nFlashcardStudyWriteJsonToFile: ONE shared writer serves\nBOTH sync (FlashcardStudySave) + async (worker) paths\nFormat cannot drift\nAsync: FlashcardSaveWorker (BELOW_NORMAL), snapshot of states\nWorker never touches live studyDoc\nJob carries real docName/docPath (resolved on UI thread)\nWorker drains queue before exit (stop flag under lock + signal)\nFailed write: retry up to 3x, 100 ms backoff, truthful 'giving up' log\nProfile write stays on UI thread (gProfile has NO locks)\nNo fake sentinel job, no stray .tmp", fillcolor="#c8e6c9", style=filled];
        c_f7 [label="C-F7 stats do NOT write per rating\nFlashcardStatsAddCard / FlashcardStatsAddSeconds\nFlashcardStats.cpp keep counters in memory\nflush at thresholds (>=20 cards, >=60 seconds)\nNO per-rating I/O", fillcolor="#ffe0b2", style=filled];
        c_f8 [label="C-F8 study tick does NOT invalidate canvas\nFlashcardStudyTick Commands_Flashcard.cpp+\nonly credits study seconds (wall clock), checks session timer\npumps prewarm; repaints ONLY when session timer expires\n15.6ms period is NOT a repaint problem\nAlso services deferred bookkeeping (>= 50 ms coalesced)", fillcolor="#c8e6c9", style=filled];
        c_f9 [label="C-F9 repo constraint: NO STL\nsumatrapdf-src/src/base/: Str, Vec, StrVec only\nunordered_map does NOT exist\nany key->index index must be repo-native:\nsorted Vec + binary search, or small open-addressing table in base/", fillcolor="#ffe0b2", style=filled];

        c_f1 -> c_f2 -> c_f3 -> c_f4 -> c_f5 -> c_f6 -> c_f7 -> c_f8 -> c_f9;
    }

    // ===================== DISCARD CHANGES (data fate) =====================
    subgraph cluster_discard {
        label="UNSAVED DOCUMENT -> DISCARD CHANGES (data fate)";
        color="#f44336";
        style=dashed;
        penwidth=2.0;

        discard_load [label="FlashcardEnsureTabCards (Commands_Flashcard.cpp)\nloads cards from LIVE document (FlashcardLoadFromDocument)\nstudy states from JSON (FlashcardStudyLoad)\none per tab (cardsLoaded guard)\nlog: 'loaded %d cards, %d study states'\nmismatch = orphans", fillcolor="#ffcdd2", style=filled];
        discard_key [label="FlashcardKey (Flashcard.cpp)\nFNV-1a over (pageNo + bounds quantized x100)\nstudy state keyed by POSITION, not annotation object\nrecreating SAME rect on SAME page RESURRECTS old state\nrecreating a few pixels off -> NEW key = progress LOST\nold state stays orphaned", fillcolor="#ffcdd2", style=filled];
        discard_prune [label="FlashcardStudyPruneStates (Flashcard.cpp)\ncalled ONLY on rating and delete paths\nNEVER on load -> zero cards = no rating = no prune\norphan survives indefinitely (rewritten by every save)", fillcolor="#ffcdd2", style=filled];
        discard_stats [label="study TIME and cards-rated counters NOT reverted\nlive in per-doc FileState (flashcardStudyTimeSec,\nflashcardCardsDone), daily sidecar, ProfileData\nhistory shows time for cards never in saved file", fillcolor="#ffcdd2", style=filled];
        discard_config [label="FlashcardStudyListDocs (Flashcard.cpp)\nreports cards=%d from STUDY STATES, not from document\nConfig window shows phantom card count", fillcolor="#ffcdd2", style=filled];
        discard_opts [label="Options (what changes / where / expected gain / risk / breaks):\nP1 prune orphan states at load (depends on key index) -> JSON self-heals\nP2 warn when study session active + doc has unsaved annotation changes\nP3 keep studied-but-unsaved cards' state in pending area until save\nP4 do not credit daily stats/sidecar/profile for cards not in saved file\n  (or mark them provisional)\nP5 show BOTH counts (states vs cards present in document) in Config window", fillcolor="#c8e6c9", style=filled];

        discard_load -> discard_key -> discard_prune -> discard_stats -> discard_config -> discard_opts;
    }

    // ===================== PERF WORK PLAN =====================
    plan [label="PERF WORK PLAN (ordered, from horizontal validation of 2 external models)\nP0 instrument the phases (prune/save-json/save-profile/stats/sidebar/prefetch/navigate/total) + keypress->paint, P50/P95/P99, because dominant cost depends on deck size\nP1 split the critical path from the bookkeeping (defer save/stats/sidebar/prewarm-enqueue by a coalesced 30-50 ms timer, flush on session end / tab switch / WM_CLOSE / WM_ENDSESSION and before the Config window reads)\nP2 key->state index (repo-native, no STL) + prune only on load / when the card set changes\nP3 async coalesced save for BOTH targets (book JSON and profile)\nP4 sidebar: visibility gate, persistent per-page text cache, update only the changed row, owner-data virtual list\nP5 budget/EWMA: separate the cheap page-info prefetch from the ewma>400 rule, measure the EWMA over the WHOLE transition, tier cap 0 should disable only the tile prewarm, delete the dead drain loop in FlashcardPrewarmInvalidate\nP6 render-queue priority (visible > speculative)\nP7 paint: index cards by page, cull FIRST with the visible range RecalcVisibleParts already computes, convert only visible cards\nP8 the unsaved/discard scenario\nNOTE: DO NOT 'fix' the prefetch start index — warming the new card is intentional (C-CORR-1)", shape=note, fillcolor="#e8f5e9", style="filled,dashed"];

    cg8 -> c_f1 [style=dotted];
    discard_opts -> plan [style=dotted];
    c_f9 -> plan [style=dotted];

    // ===================== INSTRUMENTATION =====================
    subgraph cluster_instrumentation {
        label="INSTRUMENTATION (Phase 0: two [fc][perf] log lines)";
        color="#607d8b";
        style=dashed;
        penwidth=2.0;
        instr [label="NEW LOG LINES (Commands_Flashcard.cpp + Canvas.cpp + Flashcard.cpp):\n1. [fc][perf] rate: scan=%dms stats=%dms toolbar=%dms sidebarFlag=%dms nav=%dms rerender=%dms total=%dms cards=%d states=%d\n   (critical path only, after MainWindowRerender)\n2. [fc][perf] deferred: prune=%dms save=%dms sidebar=%dms tabs=%d total=%dms\n   (FlashcardRunDeferredBookkeeping)\n3. [fc][perf] deferred-save-only: save=%dms tabs=%d\n   (FlashcardFlushBookkeepingSaveOnly)\n4. [fc][perf] paint: keypress->paint=%dms card=%d page=%d cached=%d\n   (Canvas.cpp, arm/consume — exactly one per rating)\n5. [fc][perf] save worker: wrote '%s' %llu bytes in %llums ok=1\n6. [fc][perf] save worker: write FAILED (attempt N/3, retrying in 100ms) / giving up\n7. [fc][perf] renderq: serving visible over %d speculative (idx=%d tail=%d)\nplus FlashcardState::lastRateTick = rating-start timestamp\nplus FlashcardStudyVerifySorted errors (debug builds)\nplus FlashcardSaveWorker retry/give-up events", fillcolor="#fff9c4", style=filled];
    }

    // ===================== LEGEND =====================
    subgraph cluster_legend {
        label="Legend";
        color="#ccc";
        entry [label="Entry points", fillcolor="#ffcdd2", style=filled];
        core [label="Core transition (rate path)", fillcolor="#fff3e0", style=filled];
        data [label="Data structures", fillcolor="#e3f2fd", style=filled];
        thread [label="Thread/lock topology", fillcolor="#f3e5f5", style=filled];
        cache [label="Cache layers", fillcolor="#efebe9", style=filled];
        hyp [label="Hypotheses + measure", fillcolor="#fff3e0", style="filled,dashed"];
        opt [label="Improvement options", fillcolor="#e8f5e9", style="filled,dashed"];
        cg [label="Call graph nodes", fillcolor="#ffcdd2", style="filled,dashed"];
        solid [label="Solid = direct call", style=solid];
        dashed [label="Dashed = conditional/async", style=dashed];
        dotted [label="Dotted = cross-reference", style=dotted];
    }
}