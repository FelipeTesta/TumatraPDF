digraph TumatraPDF {
    rankdir=TB;
    node [shape=box, style=rounded];
    compound=true;

    // Fases do projeto
    fase0 [label="Fase 0: Setup\nClonar SumatraPDF\nInit Git\nDocumentar", fillcolor="#c8e6c9", style=filled];
    fase1 [label="Fase 1: Build Base\nVS2022 + Premake5\nCompilar sem mods", fillcolor="#fff9c4", style=filled];
    fase2 [label="Fase 2: Análise\nPipeline render\nHooks de integração\nUpdate checker", fillcolor="#fff9c4", style=filled];
    fase3 [label="Fase 3: Features 1+2 ✓\nAutoScroll + Contraste\n✓ Temas Light/Dark\n✓ Menu New Tools\n✓ Toolbar Icons\n✓ Command Registration\n✓ AutoScroll + Contraste + Themes + Menu + Invert", fillcolor="#c8e6c9", style=filled];
    fase4 [label="Fase 4: Feature 3 ✓\nViewport Crop + Margin Trim\n(Zoom bug fixed)", fillcolor="#c8e6c9", style=filled];
    fase6 [label="Fase 6: Integração\nTestes\nBuild Final\nMerge upstream", fillcolor="#f8bbd0", style=filled];

    fase0 -> fase1;
    fase1 -> fase2;
    fase2 -> fase3;
    fase2 -> fase4;
    fase3 -> fase6;
    fase4 -> fase6;

    // Update loop
    update [label="Verificação de\nAtualizações Upstream\n(check-updates.ps1)", shape=hexagon, fillcolor="#e1bee7", style=filled];
    fase6 -> update [label="release"];
    update -> fase6 [label="nova versão\ndisponível", style=dashed];

    // Modularidade
    subgraph cluster_modular {
        label="Estratégia Modular";
        style=dashed;
        color="#666";
        
        upstream [label="sumatrapdf-src/\n(CÓDIGO INTOCADO)", shape=folder, fillcolor="#ffcdd2", style=filled];
        features [label="src/features/\n(NOSSAS EXTENSÕES)", shape=folder, fillcolor="#c8e6c9", style=filled];
        hooks [label="src/hooks/\n(PONTOS DE INTEGRAÇÃO)", shape=folder, fillcolor="#fff9c4", style=filled];
        premake [label="Premake5\n(merge scripts)", shape=component];
        
        upstream -> hooks [label="hook points"];
        features -> hooks [label="registra"];
        hooks -> premake [label="build config"];
    }

    // Arquitetura SumatraPDF
    subgraph cluster_arch {
        label="Arquitetura SumatraPDF (upstream)";
        node [shape=record];
        ui [label="Win32 UI\n(Janela, Menus, Toolbar)"];
        render [label="Pipeline Render\nMuPDF → Bitmap → Display"];
        input [label="Input Handler\n(Teclado, Mouse, Scroll)"];
        doc [label="Document Model\n(PDF, EPUB, etc.)"];
        updatecheck [label="UpdateCheck.cpp\n(auto-update nativo)"];
    }

    // Feature hooks
    features -> input [label="autoscroll:\nhook input", style=dotted, lhead=cluster_arch];
    features -> render [label="viewport:\nhook render crop\ncontrast:\nhook post-process", style=dotted, lhead=cluster_arch];

    // Dependências
    subgraph cluster_deps {
        label="Dependências";
        mupdf [label="MuPDF\n(PDF Engine)"];
        vs2022 [label="Visual Studio 2022"];
        premake5 [label="Premake5\n(Build System)"];
    }

    mupdf -> render;
    premake5 -> fase1;
    vs2022 -> fase1;

    // Referência AHK
    ahk [label="sumatra-autoscroll-v3.ahk\n(Referência: AutoScroll\n+ Navegação 2 Colunas)", shape=note, fillcolor="#fff9c4", style=filled];
    ahk -> fase3 [label="portar lógica", style=dashed];

    // Legenda
    subgraph cluster_legend {
        label="Legenda";
        color="#ccc";
        done [label="Concluído", fillcolor="#c8e6c9", style=filled];
        progress [label="Em progresso", fillcolor="#fff9c4", style=filled];
        feature [label="Features", fillcolor="#bbdefb", style=filled];
        critical [label="Crítico", fillcolor="#f8bbd0", style=filled];
    }
}
