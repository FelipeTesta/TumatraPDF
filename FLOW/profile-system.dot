// dot-sync: verified=2026-11-23 refs=4c84637d9895
digraph ProfileSystem {
    // Snapshot: 2026-11-21 (s69) — Profile Sync: correct merge, complete migration, honest UI
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Consolas", fontsize=9];
    edge [fontname="Consolas", fontsize=8];
    compound=true;

    // ===================== WHAT A "PROFILE" IS =====================
    subgraph cluster_what {
        label="What a Profile IS (Profile Memory) — single-file user-data store, NOT UI prefs";
        color="#4caf50";
        style=filled;
        fillcolor="#e8f5e9";

        file [label="<profileDataDir|default app-data>\\tumatraPDF-data_1.json
format v1 (kProfileDataVersion=1) + checksum field
holds: books study states | readingStats/fcStats\nday rows (per-machine) | perDoc counters
backup\\NN\\tumatraPDF-data_1.json + stamp.txt\n(9 slots x 8h rolling)", fillcolor="#c8e6c9", style=filled];
        gprofile [label="gProfile (ProfileData.cpp)
Vec<ProfileBook> books (key = md5(pdfPath) hex,
  docName/docPath/FlashcardStudyDoc)
Vec<ProfDayMachine> readingDaily / studyDaily
  (dateKey YYYYMMDD | sec | cards | machine)
Vec<ProfDocEntry> perDoc (readingSec/fcStudySec/fcCards)
lastWriteTs | loaded | dirty", fillcolor="#c8e6c9", style=filled];
        notsettings [label="NOT captured here: UI prefs / theme / zoom /\ntabs / per-doc FileState fields (invert, trim...)\n=> persist in GlobalPrefs + FileHistory (settings-system.dot)
Profile captures STATS + STUDY STATE only", fillcolor="#f5f5f5", style=filled];

        file -> gprofile [style=dotted];
        gprofile -> notsettings [style=dotted];
    }

    // ===================== LOAD PIPELINE =====================
    subgraph cluster_load {
        label="Load pipeline (ProfileDataEnsureLoaded ProfileData.cpp)";
        color="#2196f3";
        style=filled;
        fillcolor="#e3f2fd";

        ensure [label="ProfileDataEnsureLoaded (lazy, once)
 sets gProfileThisMachine (GetComputerNameW)", fillcolor="#bbdefb", style=filled];
        f4 [label="F4: ProfEnsureProfileDirAndMigrate (:1706)
 profileDataDir set -> mkdir + copy tumatraPDF-data_*.json
 + backup\\ tree from old app-data dir; source kept;
 skip if target primary exists", fillcolor="#bbdefb", style=filled];
        f5 [label="F5: ProfImportPortableInstall (:893)
 one-time Portable exe-adjacent import\n when installed profile empty", fillcolor="#bbdefb", style=filled];
        read [label="file::ReadFile(primary) -> ProfBlockInterior", fillcolor="#bbdefb", style=filled];
        f7 [label="checksum verify (:1291)
ProfReadChecksumTemp (:1552) vs ProfComputeChecksumTemp (:1619) (MD5)
mismatch -> refuse import with log line; absent checksum (old file)
-> accepted with log line", fillcolor="#fff9c4", style=filled];
        backup_rec [label="Corrupt: scan 9 backup slots, newest valid\nslot -> primary (RecoverBackupSlot :2514)\nnone -> ProfImportLegacy + dirty+Save", fillcolor="#fff9c4", style=filled];
        cloud [label="Cloud-revert detect (:1860)
newest backup slot lastWriteTs > primary ts
 -> gCloudRevertPending (:80) = true (consumed at startup,\n SumatraStartup.cpp; skipped when gForTesting)", fillcolor="#fff9c4", style=filled];
        parse [label="ProfParseBooks (:419) / ProfParseDaySection (:1490)
/ ProfParseInfoSection (:1527) -> gProfile", fillcolor="#bbdefb", style=filled];
        reconcile [label="ProfReconcileSidecars (:1007) — startup adopt
of reading-stats.txt / flashcard-stats.txt rows absent from profile sections
(idempotent; books excluded)", fillcolor="#bbdefb", style=filled];
        conflicted [label="ProfMergeConflictedCopies (:1130) — Drive
conflicted copies tumatraPDF-data_*.json:
adopt absent book keys + (dateKey,machine) day rows;
copies never deleted/renamed", fillcolor="#bbdefb", style=filled];

        ensure -> f4 -> f5 -> read -> f7 -> backup_rec [style=dashed, label="on corrupt/missing"];
        read -> parse [style=dashed, label="ok"];
        backup_rec -> parse;
        parse -> cloud -> reconcile -> conflicted;
    }

    // ===================== SAVE + BACKUPS =====================
    subgraph cluster_save {
        label="Save + rolling backups (ProfileData.cpp)";
        color="#9c27b0";
        style=filled;
        fillcolor="#f3e5f5";

        pull [label="ProfPullHistory (:2316)
 gFileHistory snapshot -> perDoc rows (readingSec/fcSec/fcCards)", fillcolor="#e1bee7", style=filled];
        save [label="ProfileDataSaveNow (:2418)
 dirty-gate -> ProfPullHistory -> ProfSaveInner", fillcolor="#e1bee7", style=filled];
        inner [label="ProfSaveInner (:2326) — ATOMIC: tmp file,
 MD5(body w/ empty checksum) -> ProfSubstChecksumTemp
 -> MoveFileExW(MOVEFILE_REPLACE_EXISTING), fallback remove+rename
no .tmp left; optional checksum token after machine", fillcolor="#e1bee7", style=filled];
        maybe [label="ProfMaybeBackup (:2454)
 slot = (time(nullptr)/8h) % 9; stamp.txt period guard;
 wall-clock derived, survives reboots;
 backup\\NN\\tumatraPDF-data_1.json copied if period stale", fillcolor="#e1bee7", style=filled];
        slots [label="ProfileDataBackupStampTemp / RecoverBackupSlot
(:2499/:2514) — 5s hold restore in Backups UI;
drops gProfile in-memory state, re-EnsureLoaded, SaveNow", fillcolor="#e1bee7", style=filled];

        pull -> save -> inner -> maybe;
        maybe -> slots [style=dotted];
    }

    // ===================== WRITER HOOKS =====================
    subgraph cluster_hooks {
        label="Writer hooks (dual-write era) — profile updated on every write, sidecars too";
        color="#ff9800";
        style=filled;
        fillcolor="#fff3e0";

        fc_hook [label="Flashcard.cpp: FlashcardStudySave\n-> ProfileDataUpdateStudyDoc (:1936) FULL REPLACE\nFlashcardStudyLoad -> ProfileDataMergeStudyDoc (:1948)\nnewest-wins per state key (lastReviewedAt >=)\nfirst-contact adopt; FlashcardDeleteAllStudyFiles\n-> ProfileDataClearStudyDocs (:1999)", fillcolor="#fff3e0", style=filled];
        stats [label="ReadingStats.cpp / FlashcardStats.cpp,238\nProfileDataAddReadingSec / AddFlashcardSec / AddFlashcardCard\n live ticks (dirty-only; clamp [0,86400]; save cadence)", fillcolor="#fff3e0", style=filled];
        dayflush [label="FlashcardStatsFlush / ReadingStats flush (dirtySec>=60)\n ProfileDataUpsertStudyDay / UpsertReadingDay — replaces THIS machine's row,\n other machines' rows untouched; SaveNow materializes", fillcolor="#fff3e0", style=filled];
        dual [label="kProfDualWriteSidecars (ReadingStats.cpp / FlashcardStats.cpp / Flashcard.cpp)\n= true — sidecar flashcard-stats.txt / reading-stats.txt\n+ per-book *.json STILL written; profile upserts unconditional", fillcolor="#ffcdd2", style=filled];
        pullhook [label="ProfPullHistory reads gFileHistory FileState\n readingTimeSec / flashcardStudyTimeSec / flashcardCardsDone\n (perDoc snapshot; source of P1-migration corruption)", fillcolor="#fff3e0", style=filled];

        fc_hook -> dual [style=dotted];
        stats -> dayflush;
        dayflush -> save;
        pullhook -> pull;
    }

    // ===================== UI SURFACES =====================
    subgraph cluster_ui {
        label="UI surfaces (NO menu entry anywhere)";
        color="#e91e63";
        style=filled;
        fillcolor="#fce4ec";

        homebtn [label="Home ⟳ Sync button (HomePage.cpp, HomeSyncBtnWnd)
next to 'Stats' header; click -> ShowProfileSyncDialog
(bubble hit-test local->root bridge)", fillcolor="#bbdefb", style=filled];
        syncwnd [label="Profile Sync window (ProfileSyncWnd.cpp)
class TUMATRA_PROFILE_SYNC; read-only readout:
 dir / file / format v / size / last save / machine /
 counts (books, readingDays, studyDays) / backups +
 Drive hint label\n SEVEN buttons (two rows): Set data folder | Save Now |\n Open Folder | Backups | Export | Import | Close (Esc)
 status line at bottom (last action outcome, seeded with migration result);
 Set data folder applies on NEXT start\n WM_SETTINGCHANGE / WM_THEMECHANGED: re-resolve theme,\n re-apply dark caption, repaint all children; brush released on destroy", fillcolor="#bbdefb", style=filled];
        export [label="Export (ProfileDataExportToDir :1206)
copies PRIMARY + backup\\ + stats\\ + study\\ trees; dest-exists -> confirm overwrite;
atomic replace via temp + MoveFileExW\nImport (ProfileDataImportFromJson :1280)
prompt TUMATRA_PROFILE_IMPORT: REPLACE (.pre-import copy + atomic install) or\nMERGE — larger total per day, newer state per card; validates source checksum", fillcolor="#bbdefb", style=filled];
        backupwnd [label="Profile Backups dialog (ProfileBackupWnd.cpp)
class TUMATRA_PROFILE_BACKUP (420x520); 9 slots x8h;
 stamp per slot; 5s hold Restore (1s orange progress);
 keyboard: Up/Down/Home/End select slot, SPACE hold-to-restore;
 failed restore -> message box (not log only); Esc close;
 DwmSetWindowAttribute dark caption (s40)", fillcolor="#bbdefb", style=filled];
        cloudwnd [label="Cloud revert modal (ProfileBackupWnd.cpp)
class TUMATRA_CLOUD_REVERT (380x220); primary vs newest-backup\nstamp; Restore (default) / Keep; Esc = Keep;
called from SumatraStartup.cpp (skipped if gForTesting)", fillcolor="#bbdefb", style=filled];
        cmd [label="Commands: CmdProfileBackups (Commands.h/690)\n dispatch SumatraPDF.cpp; gen-commands palette\n 'Profile: Backups...'; NO menu / shortcut\n CmdProfileSync (gen-commands.ts:350, Commands.h/700)\n dispatch SumatraPDF.cpp; palette 'Profile: Sync...'\n (Home button only)", fillcolor="#ffcdd2", style=filled];

        homebtn -> syncwnd;
        syncwnd -> backupwnd [style=dotted];
        syncwnd -> export;
        backupwnd -> cloudwnd [style=dotted, label="same mold"];
    }

    // ===================== STORAGE PARALLELS / UNIFICATION =====================
    subgraph cluster_parallel {
        label="Storage roots (SHIPPED s64-R9o / v1.0.17 — not a plan, current state)";
        color="#607d8b";
        style=filled;
        fillcolor="#eceff1";

        stores [label="(1) profileDataDir -> <root>\\tumatraPDF-data_1.json [UI: Set data folder button]
(2) flashcardStudyDir -> per-book <md5>.json [legacy override; unset => <root>\\study\\]
(3) reading-stats.txt + flashcard-stats.txt -> <root>\\stats\\ [UI: NONE]
(4) settings file itself (SumatraPDF-settings.txt) [UI: n/a — never travels]", fillcolor="#c8e6c9", style=filled];
        shipped [label="SHIPPED state: one data root (profileDataDir wins, else per-exe app-data dir);
 sidecars in <root>\\stats\\; per-book study JSONs in <root>\\study\\;
 flashcardStudyDir kept only as legacy override", fillcolor="#fff9c4", style=filled];

        stores -> shipped [style=dotted];
    }

    // ===================== OPEN GAPS =====================
    subgraph cluster_gaps {
        label="Open gaps / tech debt";
        color="#f44336";
        style=filled;
        fillcolor="#ffebee";

        p1 [label="P1-migration — FIXED (s64-R9m / s68)
FileState blob: 44 fields + 44 names, FlashcardStudyTimeSec appended LAST\n(AppSettings.cpp kMigDst ends 'FlashcardStudyTimeSec'; L152 'names blob 44')\nReal migration: MigrateFileStateNames (AppSettings.cpp)\ngen3 has FlashcardStudyTimeSec key -> NO-OP skip;\ngen2 has FlashcardCardsDone but not FlashcardStudyTimeSec -> migrate;\ngen1 has neither -> migrate with same shift\n(AppSettings.cpp comment)", fillcolor="#c8e6c9", style=filled];
        f8 [label="F8 — dual-write gate flip (TODO)
slices 1-2 shipped (s36-bs/bt): live stats -> profile;
Config list merge; remaining: FlashcardStudyListDocs iterate
profile books; deprecate sidecar writes when stable;
keep per-machine day rows", fillcolor="#fff9c4", style=filled];
        s36bf [label="Gap s36-bf — sidecar day-row reconciliation
code HAS ProfReconcileSidecars (:1007, runs every load) —
but only adopts ABSENT (dateKey,machine) rows, never updates
a drifted row. TODO stale vs code insufficient — open", fillcolor="#fff9c4", style=filled];
        residual [label="s40 residual — profile actions scriptable via control pipe\n(TestProfileSetFolder/Export/Import/Status = 80-83),\nbut UI buttons stay disabled under -for-testing", shape=note, fillcolor="#ffcdd2", style=filled];

        p1 -> residual [style=dotted];
    }

    // ===================== EDGES =====================
    notsettings -> file [style=invis];
    ensure -> slots [style=invis];
    dual -> file [style=dashed, label="writes"];
    cmd -> homebtn [style=dotted, label="both open same surfaces"];

    // Legend
    subgraph cluster_legend {
        label="Legend";
        color="#ccc";
        green [label="Store / core", fillcolor="#c8e6c9", style=filled];
        blue [label="Load/parse pipeline", fillcolor="#bbdefb", style=filled];
        pink [label="Save/backup path", fillcolor="#e1bee7", style=filled];
        warn [label="Risk / debt", fillcolor="#ffcdd2", style=filled];
        plan [label="Open / future", fillcolor="#fff9c4", style=filled];
    }
}
