digraph ProfileSystem {
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Consolas", fontsize=9];
    edge [fontname="Consolas", fontsize=8];
    compound=true;

    // ===================== WHAT A "PROFILE" IS =====================
    subgraph cluster_what {
        label="What a Profile IS (Profile Memory) — single-file user-data store, NOT UI prefs";
        color="#4caf50";
        style=filled;
        fillcolor="#e8f5e9";

        file [label="<profileDataDir|default app-data>\\tumatraPDF-data_1.json
format v1 (kProfileDataVersion=1) + checksum field
holds: books study states | readingStats/fcStats\nday rows (per-machine) | perDoc counters
backup\\NN\\tumatraPDF-data_1.json + stamp.txt\n(9 slots x 8h rolling)", fillcolor="#c8e6c9", style=filled];
        gprofile [label="gProfile (ProfileData.cpp:69)
Vec<ProfileBook> books (key = md5(pdfPath) hex,
  docName/docPath/FlashcardStudyDoc)
Vec<ProfDayMachine> readingDaily / studyDaily
  (dateKey YYYYMMDD | sec | cards | machine)
Vec<ProfDocEntry> perDoc (readingSec/fcStudySec/fcCards)
lastWriteTs | loaded | dirty", fillcolor="#c8e6c9", style=filled];
        notsettings [label="NOT captured here: UI prefs / theme / zoom /\ntabs / per-doc FileState fields (invert, trim...)\n=> persist in GlobalPrefs + FileHistory (settings-system.dot)
Profile captures STATS + STUDY STATE only", fillcolor="#f5f5f5", style=filled];

        file -> gprofile [style=dotted];
        gprofile -> notsettings [style=dotted];
    }

    // ===================== LOAD PIPELINE =====================
    subgraph cluster_load {
        label="Load pipeline (ProfileDataEnsureLoaded ProfileData.cpp:1265)";
        color="#2196f3";
        style=filled;
        fillcolor="#e3f2fd";

        ensure [label="ProfileDataEnsureLoaded (lazy, once)
 sets gProfileThisMachine (GetComputerNameW)", fillcolor="#bbdefb", style=filled];
        f4 [label="F4: ProfEnsureProfileDirAndMigrate (:1202)
 profileDataDir set -> mkdir + copy tumatraPDF-data_*.json
 + backup\\ tree from old app-data dir; source kept;
 skip if target primary exists", fillcolor="#bbdefb", style=filled];
        f5 [label="F5: ProfImportPortableInstall (:501)
 one-time Portable exe-adjacent import\n when installed profile empty", fillcolor="#bbdefb", style=filled];
        read [label="file::ReadFile(primary) -> ProfBlockInterior", fillcolor="#bbdefb", style=filled];
        f7 [label="F7: checksum verify (:1284)
ProfReadChecksumTemp vs ProfComputeChecksumTemp (MD5)
mismatch -> corrupt path; absent token -> skip (old files)", fillcolor="#fff9c4", style=filled];
        backup_rec [label="Corrupt: scan 9 backup slots, newest valid\nslot -> primary (:1300)\nnone -> ProfImportLegacy (:476) + dirty+Save", fillcolor="#fff9c4", style=filled];
        cloud [label="Cloud-revert detect (:1326)
newest backup slot lastWriteTs > primary ts
 -> gCloudRevertPending = true (consumed at startup,\n SumatraStartup.cpp:2863; skipped when gForTesting)", fillcolor="#fff9c4", style=filled];
        parse [label="ProfParseBooks (:374) / ProfParseDaySection (:986)
/ ProfParseInfoSection (:1023) -> gProfile", fillcolor="#bbdefb", style=filled];
        reconcile [label="ProfReconcileSidecars (:615) — startup adopt
of reading-stats.txt / flashcard-stats.txt rows absent
from profile sections (idempotent; books excluded)", fillcolor="#bbdefb", style=filled];
        conflicted [label="ProfMergeConflictedCopies (:740) — Drive
conflicted copies tumatraPDF-data_*.json:
adopt absent book keys + (dateKey,machine) day rows;
copies never deleted/renamed", fillcolor="#bbdefb", style=filled];

        ensure -> f4 -> f5 -> read -> f7 -> backup_rec [style=dashed, label="on corrupt/missing"];
        read -> parse [style=dashed, label="ok"];
        backup_rec -> parse;
        parse -> cloud -> reconcile -> conflicted;
    }

    // ===================== SAVE + BACKUPS =====================
    subgraph cluster_save {
        label="Save + rolling backups (ProfileData.cpp)";
        color="#9c27b0";
        style=filled;
        fillcolor="#f3e5f5";

        pull [label="ProfPullHistory (:1782)
 gFileHistory snapshot -> perDoc rows (readingSec/fcSec/fcCards)", fillcolor="#e1bee7", style=filled];
        save [label="ProfileDataSaveNow (:1884)
 dirty-gate -> ProfPullHistory -> ProfSaveInner", fillcolor="#e1bee7", style=filled];
        inner [label="ProfSaveInner (:1792) — ATOMIC: tmp file,
 MD5(body w/ empty checksum) -> ProfSubstChecksumTemp
 -> MoveFileExW(MOVEFILE_REPLACE_EXISTING), fallback remove+rename
no .tmp left; optional checksum token after machine", fillcolor="#e1bee7", style=filled];
        maybe [label="ProfMaybeBackup (:1920)
 slot = (time(nullptr)/8h) % 9; stamp.txt period guard;
 wall-clock derived, survives reboots;
 backup\\NN\\tumatraPDF-data_1.json copied if period stale", fillcolor="#e1bee7", style=filled];
        slots [label="ProfileDataBackupStampTemp / RecoverBackupSlot
(:1965/:1980) — 5s hold restore in Backups UI;
drops gProfile in-memory state, re-EnsureLoaded, SaveNow", fillcolor="#e1bee7", style=filled];

        pull -> save -> inner -> maybe;
        maybe -> slots [style=dotted];
    }

    // ===================== WRITER HOOKS =====================
    subgraph cluster_hooks {
        label="Writer hooks (dual-write era) — profile updated on every write, sidecars too";
        color="#ff9800";
        style=filled;
        fillcolor="#fff3e0";

        fc_hook [label="Flashcard.cpp: FlashcardStudySave\n-> ProfileDataUpdateStudyDoc (:735) FULL REPLACE\nFlashcardStudyLoad -> ProfileDataMergeStudyDoc (:1146)\nnewest-wins per state key (lastReviewedAt >=, :1427-1441)\nfirst-contact adopt; FlashcardDeleteAllStudyFiles\n-> ProfileDataClearStudyDocs (:764)", fillcolor="#fff3e0", style=filled];
        stats [label="ReadingStats.cpp:179 / FlashcardStats.cpp:178,131,208\nProfileDataAddReadingSec / AddFlashcardSec / AddFlashcardCard\n live ticks (dirty-only; clamp [0,86400]; save cadence)", fillcolor="#fff3e0", style=filled];
        dayflush [label="FlashcardStatsFlush / ReadingStats flush (dirtySec>=60)\n ProfileDataUpsertStudyDay / UpsertReadingDay — replaces THIS machine's row,\n other machines' rows untouched; SaveNow materializes", fillcolor="#fff3e0", style=filled];
        dual [label="kProfDualWriteSidecars (ReadingStats.cpp / FlashcardStats.cpp / Flashcard.cpp)\n= true — sidecar flashcard-stats.txt / reading-stats.txt\n+ per-book *.json STILL written; profile upserts unconditional", fillcolor="#ffcdd2", style=filled];
        pullhook [label="ProfPullHistory reads gFileHistory FileState\n readingTimeSec / flashcardStudyTimeSec / flashcardCardsDone\n (perDoc snapshot; source of P1-migration corruption)", fillcolor="#fff3e0", style=filled];

        fc_hook -> dual [style=dotted];
        stats -> dayflush;
        dayflush -> save;
        pullhook -> pull;
    }

    // ===================== UI SURFACES =====================
    subgraph cluster_ui {
        label="UI surfaces (NO menu entry anywhere)";
        color="#e91e63";
        style=filled;
        fillcolor="#fce4ec";

        homebtn [label="Home ⟳ Sync button (HomePage.cpp:935, HomeSyncBtnWnd)
next to 'Stats' header; click -> ShowProfileSyncDialog
(bubble hit-test local->root bridge)", fillcolor="#bbdefb", style=filled];
        syncwnd [label="Profile Sync window (ProfileSyncWnd.cpp:546)
class TUMATRA_PROFILE_SYNC; read-only readout:
 dir / file / format v / size / last save / machine /
 counts (books, readingDays, studyDays) / backups +
 Drive hint label\n buttons (6, two rows): Save Now | Open Folder |\n Backups | Export | Import | Close (Esc)", fillcolor="#bbdefb", style=filled];
        export [label="Export (ProfileDataExportToDir :814)
copies primary + backup\\ subtree; fails if dest primary exists;
already-exists confirm -> IFileDialog FOS_PICKFOLDERS\nImport (ProfileDataImportFromJson :852)
prompt TUMATRA_PROFILE_IMPORT (360x180):\n REPLACE (.pre-import move + copy) or\n MERGE — true newest-wins per item vs adopt-absent\n (file-level lastWriteTs, fallback LastWriteTime) (s40)", fillcolor="#bbdefb", style=filled];
        backupwnd [label="Profile Backups dialog (ProfileBackupWnd.cpp:195)
class TUMATRA_PROFILE_BACKUP (420x520); 9 slots x8h;
 stamp per slot; 5s hold Restore (1s orange progress);
Esc close; DwmSetWindowAttribute dark caption (s40)", fillcolor="#bbdefb", style=filled];
        cloudwnd [label="Cloud revert modal (ProfileBackupWnd.cpp:347)
class TUMATRA_CLOUD_REVERT (380x220); primary vs newest-backup\nstamp; Restore (default) / Keep; Esc = Keep;
called from SumatraStartup.cpp:2863 (skipped if gForTesting)", fillcolor="#bbdefb", style=filled];
        cmd [label="Commands: CmdProfileBackups = 529 (Commands.h:340)\n dispatch SumatraPDF.cpp:10359; gen-commands palette\n 'Profile: Backups...'; NO menu / shortcut / Home twin\n   for Sync window (Home button only)", fillcolor="#ffcdd2", style=filled];

        homebtn -> syncwnd;
        syncwnd -> backupwnd [style=dotted];
        syncwnd -> export;
        backupwnd -> cloudwnd [style=dotted, label="same mold"];
    }

    // ===================== STORAGE PARALLELS / UNIFICATION =====================
    subgraph cluster_parallel {
        label="Storage parallels (see analysis md §A) — 4 roots, 2 configurable, 0 unified";
        color="#607d8b";
        style=filled;
        fillcolor="#eceff1";

        stores [label="(1) profileDataDir -> tumatraPDF-data_1.json [UI: NONE, advanced-set only]
(2) flashcardStudyDir -> per-book <md5>.json [UI: Flashcard Config window 📂 picker]
(3) reading-stats.txt + flashcard-stats.txt NEXT TO SETTINGS FILE [UI: NONE]
(4) settings file itself (SumatraPDF-settings.txt) [UI: n/a]", fillcolor="#ffcdd2", style=filled];
        unify [label="UNIFICATION PLAN (md §A):
single data-root setting (profileDataDir) governing
profile + both sidecars + per-book JSONs;
ProfileSyncWnd gains 📂 folder picker (like Config);
sidecars move under profile dir;
flashcardStudyDir kept only as migration shim", fillcolor="#fff9c4", style=filled];

        stores -> unify [style=dotted];
    }

    // ===================== OPEN GAPS =====================
    subgraph cluster_gaps {
        label="Open gaps / tech debt";
        color="#f44336";
        style=filled;
        fillcolor="#ffebee";

        p1 [label="P1-migration — FIXED (s64-R9m / s68)
FileState blob: 44 fields + 44 names, FlashcardStudyTimeSec appended LAST\n(AppSettings.cpp:170 kMigDst ends 'FlashcardStudyTimeSec'; L152 'names blob 44')\nReal migration: MigrateFileStateNames (AppSettings.cpp:193)\ngen3 has FlashcardStudyTimeSec key -> NO-OP skip;\ngen2 has FlashcardCardsDone but not FlashcardStudyTimeSec -> migrate;\ngen1 has neither -> migrate with same shift\n(AppSettings.cpp:189-192 comment)", fillcolor="#c8e6c9", style=filled];
        f8 [label="F8 — dual-write gate flip (TODO)
slices 1-2 shipped (s36-bs/bt): live stats -> profile;
Config list merge; remaining: FlashcardStudyListDocs iterate
profile books; deprecate sidecar writes when stable;
keep per-machine day rows", fillcolor="#fff9c4", style=filled];
        s36bf [label="Gap s36-bf — STATUS MISMATCH
TODO says sidecar day-row reconciliation at startup pending;
code HAS ProfReconcileSidecars (:615, runs every load) —
but only adopts ABSENT rows, never updates drifted ones;
TODO stale or reconcile insufficient — resolve doc vs code", fillcolor="#fff9c4", style=filled];
        residual [label="s40 residuals: Import prompt not force-launchable
in -for-testing (ProfileSyncWnd.cpp:364-370); cloud revert
not deterministically reachable; hold-restore abort kept", shape=note, fillcolor="#ffcdd2", style=filled];

        p1 -> residual [style=dotted];
    }

    // ===================== EDGES =====================
    notsettings -> file [style=invis];
    ensure -> slots [style=invis];
    dual -> file [style=dashed, label="writes"];
    cmd -> homebtn [style=dotted, label="both open same surfaces"];

    // Legend
    subgraph cluster_legend {
        label="Legend";
        color="#ccc";
        green [label="Store / core", fillcolor="#c8e6c9", style=filled];
        blue [label="Load/parse pipeline", fillcolor="#bbdefb", style=filled];
        pink [label="Save/backup path", fillcolor="#e1bee7", style=filled];
        warn [label="Risk / debt", fillcolor="#ffcdd2", style=filled];
        plan [label="Open / future", fillcolor="#fff9c4", style=filled];
    }
}
