digraph TrimContrast {
    rankdir=TB;
    node [shape=box, style=rounded];

    trim [label="Trim (CmdMarginTrimToggle)\nclip-based render: pageRect shrinks top/bottom\nRenderCache tile funcs shrink mediabox + shift user rect", fillcolor="#c8e6c9", style=filled];
    trimdlg [label="TrimConfigDialog (singleton gTrimConfigWnd)\nmargin-top/bottom buttons -> draggable red 2px line\ndrag syncs edits (TrimConfigDialogSyncEdits)\ncheck button saves gGlobalPrefs->trim\nedit validation: DisplayModel::PageMediaBox(CurrentPageNo())\n(virtual->physical routed, TC2-safe)\nCONTEXT LINES (s28): every margin line whose screen y is\nin the viewport is drawn — current page + neighbors\n(continuous modes); near page top -> current top +\nprev bottom; near bottom -> current bottom + next top;\nfull page -> both; drag records trimDragPageNo,\nmath per THAT page (TrimCollectVisibleLines)\nTEMP TRIM (s29): Create snapshots marginTrimEnabled,\nforces OFF + relayout + cache free while the dialog is open\n(full page visible for placing lines); Save/Cancel restore the\nflag BEFORE relayout — Cancel now ALSO frees the cache\n(tiles cached mid-dialog were rendered untrimmed)", fillcolor="#bbdefb", style=filled];
    trimbug [label="FIXED 2026-09-22 (audit R1):\nTrimConfigDialog.cpp:92,113 used engine\nPageMediabox(CurrentPageNo()) w/o routing\nunder TC2 even pages = ReportIf + wrong box\nnow dm->PageMediaBox(); bonus: RenderCache::Invalidate\nsame class also routed (VirtualToPhysical + column halve)", shape=note, fillcolor="#c8e6c9", style=filled];
    trimdup [label="R3 evaluated 2026-09-22: trim rect snippets kept\ninline (site semantics differ: mediabox shrink vs\narea shift vs pt shift + distinct guards);\nforcing helper = render-path risk, low value\ncolX math IS unified -> DisplayModel::ColumnOffsetXForPage", shape=note, fillcolor="#fff9c4", style=filled];
    trimlines [label="R4 DONE 2026-09-22: 3 drag-line math copies in\nCanvas.cpp (hit-test/move/paint) unified in\nTrimComputeLineInfo(TrimLineInfo) static helper\ns28: generalized per page (TrimComputeLineInfoForPage\n+ TrimCollectVisibleLines candidates, stack array)", shape=note, fillcolor="#c8e6c9", style=filled];

    contrast [label="Contrast (Ctrl+Shift+C)\nPDF: Win32 overlay veil WS_EX_LAYERED child,\nalpha=opacity%, result = pixel x (1-a)\nper-doc persist (FileState ContrastEnabled/Opacity)", fillcolor="#e1bee7", style=filled];
    cmd [label="Markdown path (R2 DONE 2026-09-22):\nMarkdownContrastJs(enabled,opacity,invert)\nsingle source in MarkdownModel (3 copies killed)\nMD visual INTENTIONALLY different from PDF veil:\nbody bg #FAFAFA/#050505 + gray text\n(opacity scales text gray; invert swaps)", fillcolor="#e3f2fd", style=filled];
    contrastdup [label="R2 DONE 2026-09-22: gray-math drift killed\nall 3 sites (toggle SumatraPDF / opacity\nContrastOverlay / restore MarkdownModel)\neval the same MarkdownContrastJs string", shape=note, fillcolor="#c8e6c9", style=filled];

    trim -> trimdlg;
    trimdlg -> trimbug [style=dotted];
    trim -> trimdup [style=dotted];
    trim -> trimlines [style=dotted];
    contrast -> cmd;
    cmd -> contrastdup [style=dotted];
}
