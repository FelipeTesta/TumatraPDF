digraph TrimContrast {
    rankdir=TB;
    node [shape=box, style=rounded];

    trim [label="Trim (CmdMarginTrimToggle)\nclip-based render: pageRect shrinks top/bottom\nRenderCache tile funcs shrink mediabox + shift user rect", fillcolor="#c8e6c9", style=filled];
    trimdlg [label="TrimConfigDialog (singleton gTrimConfigWnd)\nmargin-top/bottom buttons -> draggable red 2px line\ndrag syncs edits (TrimConfigDialogSyncEdits)\ncheck button saves gGlobalPrefs->trim", fillcolor="#bbdefb", style=filled];
    trimbug [label="BUG LATENT (audit 2026-09-21):\nTrimConfigDialog.cpp:92,113 uses\nGetEngine()->PageMediabox(CurrentPageNo()) WITHOUT\nVirtualToPhysical -> wrong mediabox under TC2 even pages\nfix: DisplayModel::PageMediaBox()", shape=note, fillcolor="#ffcdd2", style=filled];
    trimdup [label="Duplication: trim rect math in 3 places\nRenderCache.cpp:327/1240, DisplayModel.cpp:1461\n(+ inverse Selection.cpp:48) -> TrimRectPage/Inverse", shape=note, fillcolor="#fff9c4", style=filled];

    contrast [label="Contrast (Ctrl+Shift+C)\nWin32 overlay: WS_EX_LAYERED child, alpha slider\nper-doc persist (FileState ContrastEnabled/Opacity)", fillcolor="#e1bee7", style=filled];
    cmd [label="Markdown path: div#__sumatra_contrast CSS via Eval\npointer-events:none, remove() on OFF", fillcolor="#e3f2fd", style=filled];
    contrastdup [label="Duplication: contrast JS in 3 divergent copies\nContrastOverlay.cpp:126 / SumatraPDF.cpp:11151 /\nMarkdownModel.cpp:435 (gray math drifts)\n-> MarkdownContrastJs() single source", shape=note, fillcolor="#ffcdd2", style=filled];

    trim -> trimdlg;
    trimdlg -> trimbug [style=dotted];
    trim -> trimdup [style=dotted];
    contrast -> cmd;
    cmd -> contrastdup [style=dotted];
}
