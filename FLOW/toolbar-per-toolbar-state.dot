digraph ToolbarPerToolbarState {
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Consolas", fontsize=10];
    edge [fontname="Consolas", fontsize=9];
    compound=true;

    // ============================================================
    // D10 FIX: Per-Toolbar Pack State
    // ============================================================
    subgraph cluster_d10 {
        label="D10 FIX: Per-Toolbar Pack State (Toolbar.cpp)";
        color="#ff0000";
        style=bold;
        penwidth=2.0;
        
        d10_before [label="BEFORE (SHARED STATE - BUGGY):\nstatic int sLastBuiltDx = 0;\nstatic int sLastPackedAvailDx = 0;\n\n// Single state shared by ALL toolbars:\n// Main, Arch, Flashcard, Edit\n// → Cross-toolbar interference\n// → Secondary toolbar sees main toolbar's width\n// → Skips rebuild when it shouldn't\n// → Buttons don't rewrap correctly", fillcolor="#ffcdd2", style=filled, shape=note, color="#ff0000", penwidth=2.0];
        
        d10_after [label="AFTER (PER-TOOLBAR STATE - FIXED):\nstruct ToolbarPackState {\n  int lastBuiltDx;\n  int lastPackedAvailDx;\n};\nstatic ToolbarPackState sToolbarPackStates[4];\n// Index 0 = Main toolbar (hwndToolbar)\n// Index 1 = Arch Tools (hwndToolbar2)\n// Index 2 = Flashcard (hwndToolbarFlashcard)\n// Index 3 = Edit (hwndToolbarEdit)\n\nint ToolbarPackStateIndex(HWND hwndToolbar) {\n  if (hwnd == win->hwndToolbar) return 0;\n  if (hwnd == win->archTools.hwndToolbar2) return 1;\n  if (hwnd == win->flashcard.hwndToolbarFlashcard) return 2;\n  if (hwnd == win->editTools.hwndToolbarEdit) return 3;\n  return -1;\n}", fillcolor="#c8e6c9", style=filled, penwidth=2.0, color="#2e7d32"];
        
        d10_usage [label="ToolbarRewrapAfterSizing(win, hwnd, force):\nint idx = ToolbarPackStateIndex(hwnd);\nif (idx >= 0) {\n  auto& state = sToolbarPackStates[idx];\n  if (!force && state.lastBuiltDx == currentWidth) return;\n  state.lastBuiltDx = currentWidth;\n  // ... rebuild buttons\n}\n\nSetToolbarBandToRowHeight(hwnd):\nint idx = ToolbarPackStateIndex(hwnd);\nif (idx >= 0) {\n  auto& state = sToolbarPackStates[idx];\n  // use state.lastPackedAvailDx for band calc\n}", fillcolor="#bbdefb", style=filled];
        
        d10_before -> d10_after [color="#ff0000", penwidth=2.0, label="FIXED"];
        d10_after -> d10_usage;
    }

    // ============================================================
    // D10 FIX: Per-Toolbar Rewrap State
    // ============================================================
    subgraph cluster_d10_rewrap {
        label="D10 FIX: Per-Toolbar Rewrap Timer State";
        color="#ff9800";
        style=bold;
        penwidth=2.0;
        
        d10r_before [label="BEFORE (SHARED TIMER STATE):\nstatic UINT_PTR sRewrapTimerId = 0;\n// Single timer ID shared by all toolbars\n// → Timer fires for wrong toolbar\n// → Rewrap runs on main toolbar only anyway\n//   (WndProcToolbar checks hwnd == hwndToolbar)\n// → But state confusion possible", fillcolor="#ffcdd2", style=filled, shape=note, color="#ff0000", penwidth=2.0];
        
        d10r_after [label="AFTER (PER-TOOLBAR REWRAP STATE):\nstruct ToolbarRewrapState {\n  int lastWidth;\n  bool rewrapPending;\n};\nstatic ToolbarRewrapState sToolbarRewrapStates[4];\n// Same 4 indices as pack state\n\nWndProcToolbar WM_SIZE:\nint idx = ToolbarPackStateIndex(hwnd);\nif (idx == 0) {  // ONLY main toolbar\n  sToolbarRewrapStates[0].rewrapPending = true;\n  SetTimer(hwnd, kRewrapToolbarTimerId, 200);\n}\n\nWM_TIMER handler:\nif (idx == 0 && sToolbarRewrapStates[0].rewrapPending) {\n  ToolbarRewrapAfterSizing(win, hwnd);\n  sToolbarRewrapStates[0].rewrapPending = false;\n}", fillcolor="#c8e6c9", style=filled, penwidth=2.0, color="#2e7d32"];
        
        d10r_before -> d10r_after [color="#ff9800", penwidth=2.0, label="FIXED"];
    }

    // ============================================================
    // COORDINATE SPACE HANDLING (Critical for hit-test)
    // ============================================================
    subgraph cluster_coords {
        label="Coordinate Spaces (Critical for Hit-Test & Layout)";
        color="#3f51b5";
        style=bold;
        penwidth=2.0;
        
        coord_screen [label="SCREEN COORDINATES\n• GetCursorPos, WindowFromPoint\n• WM_MOUSEMOVE lParam (if not DPI virtualized)\n• Absolute desktop coordinates", fillcolor="#bbdefb", style=filled];
        
        coord_client_root [label="ROOT CLIENT (Frame window client area)\n• GetClientRect(hwndFrame)\n• RelayoutFrame 'rc' variable\n• Rebar window rects (HwndWindowRect)\n• All SetWindowPos use this space", fillcolor="#c8e6c9", style=filled];
        
        coord_client_toolbar [label="TOOLBAR CLIENT (Toolbar window client area)\n• GetClientRect(hwndToolbar)\n• TbGetItemRect returns THIS space\n• Button hit-test uses this space\n• rcToolbarClient.right = toolbar width", fillcolor="#fff9c4", style=filled];
        
        coord_client_rebar [label="REBAR CLIENT (ReBar window client area)\n• GetClientRect(hwndReBar)\n• Band child (toolbar) positioned here\n• rbBand.cxMinChild = toolbar width\n• chrome = rebarWindowDy - rebarClientDy", fillcolor="#e1bee7", style=filled];
        
        coord_page [label="PAGE COORDINATES (PDF page space)\n• DisplayModel::CvtToScreen/CvtFromScreen\n• Virtual page → canvas client\n• Includes scroll + zoom transform\n• Arch/Edit canvas drawing uses this", fillcolor="#e1bee7", style=filled];
        
        coord_virtual [label="VIRTUAL WND (VirtWnd tree)\n• ev.pt after BubbleMouse = LOCAL to target\n• ctx.bounds / VirtWnd::bounds = ROOT-relative\n• Paint rects from ctx.bounds = root-space\n• Hit-test: pt + bounds.{x,y} = root-space", fillcolor="#fff9c4", style=filled);
        
        // DPI virtualization note
        dpi_note [label="⚠️ DPI VIRTUALIZATION TRAP:\nE2E posted coords may arrive DPI-virtualized (×1.25)\nNon-deterministic! Verify with page-top-border invariants.\nNEVER assume raw pixels = screen pixels.", fillcolor="#ffcdd2", style=filled, shape=note, color="#ff0000", penwidth=2.0];
        
        coord_screen -> coord_client_root [label="ScreenToClient(hwndFrame)"];
        coord_client_root -> coord_client_toolbar [label="ScreenToClient(hwndToolbar)"];
        coord_client_root -> coord_client_rebar [label="ScreenToClient(hwndReBar)"];
        coord_client_root -> coord_page [label="DisplayModel::CvtToScreen"];
        coord_client_root -> coord_virtual [label="VirtWnd::ctx.bounds"];
        
        coord_client_toolbar -> dpi_note [style=dashed];
        coord_client_rebar -> dpi_note [style=dashed];
    }

    // ============================================================
    // TOOLBAR BUTTON HIT-TEST FLOW
    // ============================================================
    subgraph cluster_hittest {
        label="Toolbar Button Hit-Test Flow";
        color="#795548";
        
        ht_mouse [label="WM_LBUTTONDOWN on hwndToolbar\nlParam = client coords (toolbar client space)", fillcolor="#bbdefb", style=filled];
        ht_hittest [label="TbHitTest(hwndToolbar, pt)\npt = {GET_X_LPARAM(lp), GET_Y_LPARAM(lp)}\n// pt in TOOLBAR CLIENT space", fillcolor="#bbdefb", style=filled);
        ht_child [label="ChildWindowFromPoint(hwndToolbar, pt)\n// Check if over child control (page box, find box)", fillcolor="#bbdefb", style=filled);
        ht_result [label="if (idx >= 0) → button hit\nif (idx < 0 && !childAtPoint) → empty area → window drag", fillcolor="#c8e6c9", style=filled);
        ht_getrect [label="TB_GETITEMRECT for checked underline draw\nWndProcToolbar WM_PAINT:\nSendMessage(TB_GETITEMRECT, i, &rc)\n// rc in TOOLBAR CLIENT space", fillcolor="#fff9c4", style=filled);
        ht_draw [label="FillRect(hdc, &rcLine, brush)\n// hdc from GetDC(hwndToolbar)\n// Draws in TOOLBAR CLIENT space", fillcolor="#e1bee7", style=filled);
        
        ht_mouse -> ht_hittest -> ht_child -> ht_result;
        ht_result -> ht_getrect -> ht_draw;
    }

    // ============================================================
    // REBAR BAND HEIGHT CALCULATION
    // ============================================================
    subgraph cluster_band_calc {
        label="Rebar Band Height Calculation (SetToolbarBandToRowHeight)";
        color="#9c27b0";
        
        bc_client [label="GetClientRect(hwndToolbar, &rcToolbarClient)\nif (rcToolbarClient.right <= 0) {\n  // COLLAPSED-CHILD RECOVERY:\n  // Rebar clamped band to 0 width (stale cx)\n  // Re-assert band cx to rebar client width\n  rbBand.cx = rebarClientDx\n  SendMessage(RB_SETBANDINFO)\n  return false\n}", fillcolor="#bbdefb", style=filled);
        
        bc_band_info [label="for each band:\nRB_GETBANDINFO (RBBIM_CHILDSIZE)\nbandDy += rbiBand.cyChild\n// cyChild = height of toolbar child", fillcolor="#bbdefb", style=filled);
        
        bc_measure [label="TB_GETITEMRECT(0, &rcBand)\nrows = rcBand.bottom / max(1, rcBand.top)\nbuttonHeight = rcBand.bottom - rcBand.top\nbandDy = rows * buttonHeight", fillcolor="#bbdefb", style=filled);
        
        bc_chrome [label="Rect rcRebar = HwndWindowRect(hwndReBar)\nRect rcRebarClient = HwndClientRect(hwndReBar)\nchrome = rcRebar.dy - rcRebarClient.dy\n// Non-client area (borders, gripper)", fillcolor="#fff9c4", style=filled);
        
        bc_set [label="rbBand.fMask = RBBIM_CHILDSIZE\nrbBand.cyChild = bandDy\nSendMessage(RB_SETBANDINFO)\n// This triggers RBN_HEIGHTCHANGE → relayout", fillcolor="#c8e6c9", style=filled);
        
        bc_return [label="return (bandDy != oldCyChild)\n// True if band height changed", fillcolor="#c8e6c9", style=filled);
        
        bc_client -> bc_band_info -> bc_measure -> bc_chrome -> bc_set -> bc_return;
    }

    // ============================================================
    // TOOLBAR REWRAP AFTER SIZING (Rebuild buttons)
    // ============================================================
    subgraph cluster_rewrap {
        label="ToolbarRewrapAfterSizing (Rebuild buttons at current width)";
        color="#e91e63";
        
        rw_start [label="ToolbarRewrapAfterSizing(win, hwnd, force)\nToolbar.cpp:1570", fillcolor="#bbdefb", style=filled);
        rw_idx [label="idx = ToolbarPackStateIndex(hwnd)\nif (idx < 0) return;", fillcolor="#bbdefb", style=filled);
        rw_width_check [label="RECT rc; GetClientRect(hwnd, &rc)\nif (!force && sToolbarPackStates[idx].lastBuiltDx == rc.right)\n  return;  // Width unchanged, skip rebuild", fillcolor="#fff9c4", style=filled);
        rw_delete [label="int count = TB_BUTTONCOUNT\nfor (i = count-1; i >= 0; i--)\n  TbDeleteButton(hwnd, i)\n// Delete ALL buttons", fillcolor="#ffcdd2", style=filled);
        rw_readd [label="TbAddButtons(hwnd, count, buttons)\n// Re-add with SAME button array\n// comctl lays out at CURRENT width\n// Buttons wrap naturally if needed", fillcolor="#c8e6c9", style=filled);
        rw_update_state [label="sToolbarPackStates[idx].lastBuiltDx = rc.right\n// Record width we built for", fillcolor="#bbdefb", style=filled);
        rw_band_height [label="SetToolbarBandToRowHeight(hwnd)\n// Update band cyChild for new row count\nif (changed) ScheduleUiUpdate(kUiRelayout)", fillcolor="#bbdefb", style=filled);
        
        rw_start -> rw_idx -> rw_width_check -> rw_delete -> rw_readd -> rw_update_state -> rw_band_height;
    }

    // ============================================================
    // CROSS-REFERENCES
    // ============================================================
    d10_usage ..> d10r_after [style=dotted, label="same index array"];
    d10_usage ..> bc_band_info [style=dotted, label="uses pack state"];
    d10_usage ..> rw_width_check [style=dotted, label="uses pack state"];
    bc_measure ..> ht_getrect [style=dotted, label="same TB_GETITEMRECT"];
    coord_client_toolbar ..> ht_hittest [style=dotted, label="same space"];
}