// dot-sync: verified=2026-11-25 refs=77b6e983c8a9
digraph HomePage {
    // NOTE: Current paint path and layout logic (2026-11-24, sXX)
    // Two-column responsive layout with heatmap visual improvements
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Consolas", fontsize=9];
    edge [fontname="Consolas", fontsize=8];
    compound=true;

    // ===================== HOME PAGE UI =====================
    subgraph cluster_ui {
        label="Home Page UI (HomePage.cpp)";
        color="#4285f4";
        style=filled;
        fillcolor="#e3f2fd";

        canvas [label="Canvas (hwndCanvas)\n• WM_PAINT → DrawHomePage()\n• Double-buffered via win->buffer", fillcolor="#c8e6c9", style=filled]
        chrome [label="HomeChromeWnd (VirtWnd tree)\n• Persistent hover/pressed state\n• Children: studyHistory, stats, entries, tip, buttons", fillcolor="#bbdefb", style=filled]
        study_history [label="HomeStudyHistoryWnd\n• Ranking column (Read/FC/Sessions)\n• Fixed height, NEVER collapses (D2)\n• Internal scroll", fillcolor="#c8e6c9", style=filled]
        stats_band [label="HomeStatsWnd\n• Heatmap / Graph toggle (D7)\n• Single-source geometry (C3)\n• Square cells, 4px gap (C5)\n• Month-tinted fills (C6)\n• TODAY = white (C6)\n• Steady hover fade (C4)", fillcolor="#bbdefb", style=filled]
        entries [label="HomeEntriesWnd\n• Thumbnail/List entries\n• Hit-test, hover, keyboard nav", fillcolor="#e1bee7", style=filled]
        tip_band [label="HomeTipWnd (fixed footer)\n• Markup + links\n• Never scrolls", fillcolor="#fff9c4", style=filled]
    }

    // ===================== LAYOUT ENGINE =====================
    subgraph cluster_layout {
        label="LayoutHomePage() — Single Pass (scroll bakes dyLayout)";
        color="#e91e63";
        style=filled;
        fillcolor="#fce4ec";

        layout_start [label="LayoutHomePage(HomePageLayout& l)\n• Input: canvas client rect (rc.dx, rc.dy)\n• Output: all band rects in l.*", fillcolor="#c8e6c9", style=filled]
        two_col_decision [label="Two-Column Decision (C1)\n• screenCx = GetSystemMetrics(SM_CXSCREEN)\n• threshold = max(screenCx/2, 900)\n• twoColumnMode = (rc.dx >= threshold)\n• Recomputed EVERY layout", fillcolor="#bbdefb", style=filled]
        geom_compute [label="Heatmap Geometry (C3)\n• Compute ONCE per layout\n• rcGrid, cellDx=cellDy, cellGap=4, rowGap=4\n• monthStartCol[13], monthBorderAlt[13]\n• firstCol (Jan 1 weekday)\n• Store in HomeStatsWnd fields\n• Paint() only READS", fillcolor="#c8e6c9", style=filled]
        band_rects [label="Band Rectangles (C2)\n• 2-col: StudyHistory LEFT (40%, clamp 280-460)\n•        Heatmap RIGHT (remainder, floor 520)\n•        Books FULL WIDTH below\n• 1-col: Vertical stack (StudyHist → Heatmap → Books)\n• StudyHistory NEVER collapses (D2/C7)", fillcolor="#bbdefb", style=filled]
        scroll_clamp [label="Scroll Clamp\n• totalContentDy = fixedTop + thumbsContentDy\n• maxScrollY = max(0, totalContentDy - contentBottomY)\n• scrollY clamped, dyLayout = -scrollY\n• Recompute Y with dyLayout applied", fillcolor="#e1bee7", style=filled]
    }

    // ===================== PAINT PIPELINE =====================
    subgraph cluster_paint {
        label="Paint Pipeline (DrawHomePage → DrawHomePageLayout)";
        color="#ff9800";
        style=filled;
        fillcolor="#fff3e0";

        draw_home [label="DrawHomePage()\n• LayoutHomePage(l)\n• SaveHomeLayoutCache(l)\n• HomePageSyncChrome(l)\n• DrawHomePageLayout(l)\n• SyncHomeLayoutCacheFileSizes(l)", fillcolor="#c8e6c9", style=filled]
        sync_chrome [label="HomePageSyncChrome()\n• Feed l.* rects to chrome tree\n• studyHistory.visibility = Visible (D2 fix)\n• stats.visibility = flowVis(rcStats)\n• flowVis collapses ONLY below tip band", fillcolor="#bbdefb", style=filled]
        draw_layout [label="DrawHomePageLayout()\n• Background + search box border\n• Thumbnails/List (clipped to rcThumbsArea)\n• Chrome tree (clipped to tipTop)\n• Tip band (unclipped, on top)", fillcolor="#c8e6c9", style=filled]
        stats_paint [label="HomeStatsWnd::Paint()\n• READS pre-computed geometry (C3)\n• Square cells: cellDx == cellDy\n• Gap = 4px (C5)\n• Month fills: peru (gray-border) / silver (silver-border) (C6)\n• TODAY = white fill + orange outline (C6)\n• Border pens 1.6px (C5)\n• Hover: silverHi with fade alpha (C4)", fillcolor="#c8e6c9", style=filled]
    }

    // ===================== HOVER STATE MACHINE =====================
    subgraph cluster_hover {
        label="Hover State Machine (C4, D3 fix)";
        color="#9c27b0";
        style=filled;
        fillcolor="#f3e5f5";

        on_mouse_move [label="OnMouseMove()\n• Hit-test uses PRE-COMPUTED geometry\n• y bound = 7*cellDy + 6*rowGap (D1)\n• x bound = cellDx (no trailing gap, D4)\n• Row clamped 0..6, Col 0..52\n• If hoverDay changes:\n  - hoverDay = new, alpha=255\n  - StopHoverFade() with nIDEvent=(UINT_PTR)this (D3)\n  - Invalidate() only heatmap band", fillcolor="#c8e6c9", style=filled]
        on_mouse_leave [label="OnMouseLeave()\n• If hoverDay>=1 && alpha>0:\n  StartHoverFade()", fillcolor="#bbdefb", style=filled]
        start_fade [label="StartHoverFade()\n• timerId = SetTimer(hwnd, (UINT_PTR)this, 16, nullptr)\n• hoverFadeTimer = (UINT_PTR)this (nIDEvent, D3)\n• hoverFadeTargetDay = hoverDay\n• hoverFadeStartTime = GetTickCount()", fillcolor="#c8e6c9", style=filled]
        fade_proc [label="HoverFadeTimerProc()\n• Linear 255→0 over 500ms\n• At 500ms: alpha=0, hoverDay=-1, StopHoverFade()\n• Invalidate()", fillcolor="#e1bee7", style=filled]
        stop_fade [label="StopHoverFade()\n• KillTimer(hwnd, (UINT_PTR)this) — nIDEvent!\n• hoverFadeTimer=0, targetDay=-1, alpha=255", fillcolor="#c8e6c9", style=filled]
        destructor [label="~HomeStatsWnd()\n• StopHoverFade() — prevents use-after-free (D3)", fillcolor="#e1bee7", style=filled]
    }

    // ===================== HEATMAP VISUALS =====================
    subgraph cluster_visuals {
        label="Heatmap Visuals (C5, C6)";
        color="#795548";
        style=filled;
        fillcolor="#efebe9";

        square_cells [label="Square Cells\n• cellDx == cellDy always\n• Size = min(widthPitch, heightPitch)\n• Floored at 2px", fillcolor="#c8e6c9", style=filled]
        gaps [label="4px Gaps (C5)\n• cellGap = 4, rowGap = 4\n• Uniform grid: no month gaps\n• ColX(col) = rcGrid.x + col*(cellDx+cellGap)", fillcolor="#bbdefb", style=filled]
        month_fills [label="Month-Tinted Fills (C6)\n• Gray-border months → peru/orange (4 grades)\n• Silver-border months → silver/gray (4 grades)\n• Theme-sensitive (dark/light)\n• TODAY = ALWAYS white fill + orange outline", fillcolor="#c8e6c9", style=filled]
        borders [label="Thicker Borders (C5)\n• 1.6px (match TODAY pen)\n• Gray-border: cellOutline\n• Silver-border: silverHi", fillcolor="#bbdefb", style=filled]
    }

    // ===================== DEFECT FIXES =====================
    subgraph cluster_fixes {
        label="Defect Fixes (D1–D4)";
        color="#f44336";
        style=filled;
        fillcolor="#ffebee";

        d1 [label="D1: Hit-test y-boundary\n• WAS: pt.y < rcGrid.y + 7*(cellDy+2)\n• NOW: pt.y < rcGrid.y + 7*cellDy + 6*rowGap\n• Matches painted grid height", fillcolor="#ffcdd2", style=filled]
        d2 [label="D2: StudyHistory never collapses\n• flowVis() skipped for studyHistory\n• visibility = Visible if !IsEmpty()", fillcolor="#ffcdd2", style=filled]
        d3 [label="D3: Timer ID fix + destructor\n• SetTimer nIDEvent = (UINT_PTR)this\n• KillTimer with nIDEvent, not return value\n• ~HomeStatsWnd() calls StopHoverFade()", fillcolor="#ffcdd2", style=filled]
        d4 [label="D4: Hit-test x-boundary\n• WAS: pt.x < ColX(col) + cellDx + 2\n• NOW: pt.x < rcGrid.x + 53*(cellDx+cellGap) - cellGap\n• No trailing gap on last column", fillcolor="#ffcdd2", style=filled]
    }

    // ===================== EDGES =====================
    layout_start -> two_col_decision;
    two_col_decision -> geom_compute;
    two_col_decision -> band_rects;
    band_rects -> scroll_clamp;
    scroll_clamp -> draw_home;

    draw_home -> sync_chrome;
    draw_home -> draw_layout;
    sync_chrome -> study_history;
    sync_chrome -> stats_band;
    sync_chrome -> entries;
    draw_layout -> draw_home;
    draw_layout -> stats_paint;

    on_mouse_move -> start_fade [style=dashed, label="hoverDay change"];
    on_mouse_leave -> start_fade;
    start_fade -> fade_proc;
    fade_proc -> stop_fade [label="500ms"];
    stop_fade -> destructor;

    geom_compute -> square_cells;
    geom_compute -> gaps;
    square_cells -> month_fills;
    gaps -> borders;

    d1 -> on_mouse_move;
    d2 -> sync_chrome;
    d3 -> start_fade;
    d3 -> destructor;
    d4 -> on_mouse_move;

    // ===================== LEGEND =====================
    subgraph cluster_legend {
        label="Legend";
        color="#ccc";
        ui_n [label="UI Components", fillcolor="#e3f2fd", style=filled];
        layout [label="Layout Engine", fillcolor="#fce4ec", style=filled];
        paint [label="Paint Pipeline", fillcolor="#fff3e0", style=filled];
        hover [label="Hover State Machine", fillcolor="#f3e5f5", style=filled];
        visuals [label="Heatmap Visuals", fillcolor="#efebe9", style=filled];
        fixes [label="Defect Fixes", fillcolor="#ffebee", style=filled];
    }
}