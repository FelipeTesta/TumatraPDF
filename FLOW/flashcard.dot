digraph Flashcard {
    rankdir=TB;
    node [shape=box, style=rounded];
    compound=true;

    create [label="Create card (CmdFlashcardAdd)\nselection -> MuPDF Highlight (author=TumatraPDF-Flashcard)\ncontent EMPTY (positional mask, no text duplication)\nkey = hash(pageNo, bounds) - stable across saves\nMULTI-SELECT: Alt+drag sums disjoint selections\n(SelectionState.altAccum; Alt+click abort = restore)\n-> ONE annot with N quads = ONE card, N mask rects\n(cross-page: one card per page, annots are page-bound)", fillcolor="#c8e6c9", style=filled];
    load [label="CmdFlashcardToggle ON\nFlashcardLoadFromDocument (by author, not 'Q:' prefix)\n+ FlashcardStudyLoad (studyDoc persistence)", fillcolor="#bbdefb", style=filled];
    filter [label="BuildFilteredStudyOrder\nqueue = Vec<FlashcardQueueEntry>{tab, cardIdx}> (s22)\nnew (rating==0) OR due (nextReviewAt <= now)\ncollected SEPARATELY, combined per NewCardsPosition:\n0=newFirst | 1=newLast | 2=mixed (proportional interleave, default)\nrandom = shuffle WITHIN each group (position stays meaningful)\nSCOPE (s22): current-doc (default) | GLOBAL SESSION = all PDF tabs\nof THIS window (crossDocSession; other windows never count)\nPER-TAB page filter applied independently (FlashcardTabState)\nORDER DIALOG (Order btn): Sequential/Random + Before/After/Mixed, instant apply\n(rebuild + restart from first card, centered)", fillcolor="#bbdefb", style=filled];
    filterdlg [label="FILTER WINDOW (Filter btn -> CmdFlashcardFilter, s22)\n'Filtro de Estudo' 560x500, class TUMATRA_FLASHCARD_FILTER\nEDIT expr: set syntax 1-15;20-25;-22-23; (add/remove, sequential,\nclamped; FlashcardFilterEval; apply = Aplicar btn / Enter)\nBOOKMARK MIRROR: owner-drawn listbox, checkbox per TOC item,\nrange = page..page-before-next-in-flat-DFS (sublevels covered);\ncheck injects a-b; token + applies instantly, uncheck removes\nFiltros: ON/OFF instant (keeps expr) | Limpar filtros = hold 2s\ncross-doc checkbox row = window-level session scope\nfilter state PER-TAB (tab->flashcard.filterExpr)", fillcolor="#bbdefb", style=filled];
    filterdlg -> filter [style=dashed, label="rebuild"];
    study [label="Study mode\nopaque mask ONLY on current card (studyMode && !revealMode)\nfirst card: vertically CENTERED, instant scroll\n(FlashcardNavigateToCard: viewport-relative delta\nScrollYBy(screenRect.y + dy/2 - vpdy/2))", fillcolor="#e1bee7", style=filled];
    reveal [label="Reveal (Space/Enter/numpad Enter -> CmdFlashcardReveal)\nmask removed on current card - original text visible\nno-op outside study mode (keys never scroll)", fillcolor="#fff9c4", style=filled];
    rate [label="Rate 1-4 (keys 1..4 + numpad)\nSM-2 update, easeFactor capped [1.3, 2.5]\nrating==1 (Again): reinsert into current queue (relearn)\nadvance: next card MASKED + centered", fillcolor="#e1bee7", style=filled];
    next [label="Next (CmdFlashcardNext toolbar btn)\nskip WITHOUT reveal/rate (no SM-2, no save)\narrives masked + centered; grayed when no next", fillcolor="#e1bee7", style=filled];
    back [label="Back (CmdFlashcardBack)\nprevious card arrives REVEALED (post-reveal)\nscroll position KEPT (no auto-center)", fillcolor="#fff9c4", style=filled];
    persist [label="FlashcardStudySave\nJSON per doc; reload restores counts", fillcolor="#c8e6c9", style=filled];

    create -> load -> filter -> study -> reveal -> rate -> persist;
    rate -> study [style=dashed, label="next card"];
    study -> next [style=dashed, label="skip"];
    study -> back [style=dashed];

    clean [label="CONFIG WINDOW (toolbar Config btn -> CmdFlashcardConfig, s24;\nrenamed from Clean History)\n'Configuracoes' 560x440, class TUMATRA_FLASHCARD_CONFIG, themed (dark ok)\n(1) study-history FOLDER row: EDIT + folder button (IFileDialog\nFOS_PICKFOLDERS); change persists flashcardStudyDir + SaveSettings +\nreloads list; Drive folder = backup; MIGRATES existing JSONs via\nFlashcardStudyMigrateFiles (MOVEFILE_COPY_ALLOWED cross-volume;\ntarget keeps its files); empty = app-data\n(2) history list (owner-drawn, ~10 rows + scroll): |PDF|cartoes|due|\nultima revisao| from FlashcardStudyListDocs (sorted by lastReview desc;\nJSON now stores docName, escaped; legacy files show md5 name)\n(3) 'Limpar livro selecionado' 2s orange -> deletes SELECTED row's JSON\n(md5-matched tabs reset in-memory studyDoc + session + count + sidebar)\n(4) 'Limpar TODOS os livros' 5s red -> DeleteAll + reset EVERY tab\n(+ SidebarPopulate refresh hook) — actions run INSIDE the window,\nlist reloads, window stays open; X/Esc closes;\n(s27) sync dots before name: green=linked (docPath + file::Exists),\nred=PDF moved/renamed, grey=legacy file; 'Re-check' btn re-validates\n(study JSONs persist docPath; EN captions; adopt re-saves docPath);\n(s30) toolbar btn renamed Settings; column-header strip aligned\nwith the rows; Import moved OUT to its own toolbar window"];
    persist -> clean [style=dashed, label="reset"];
    lista [label="LISTA PANEL (Lista btn -> CmdFlashcardLista, s23)\ndocked RIGHT panel (AI-chat pattern; own width + splitter;\ncanvas shrinks via RelayoutFrame; toggle/label-close hides)\nowner-drawn listbox 4 cols: Flashcard (masked text via\nExtractPageText at populate - NOTHING stored in the PDF) |\nPag | Due (countdown AT DRAW TIME: 0min/Nmin/Nh/Nd/'—') |\nStatus colored: new=blue due=orange learn=purple ok=green\n(rows: FcListRow{cardIdx,pageNo,rating,interval,nextReviewAt})\nclick row -> FlashcardNavigateToCardInCurrentTab\nrefresh after rate + clean-current (FlashcardSidebarPopulate)", fillcolor="#e1bee7", style=filled];
    pertab -> lista [style=dotted, label="current tab's cards"];
    stats [label="STUDY-TIME STATS (FlashcardStats.cpp; commits 80de1ac 2026-10-25 + 62b11fc 2026-10-26)
flashcard-stats.txt next to SETTINGS file, 'YYYYMMDD <sec> <cards>'
  (2-col legacy lines parse cards=0); plain text, no JSON
FileState.flashcardStudyTimeSec / flashcardCardsDone per doc
YYYYMMDD bucket = GetLocalTime (FlashcardStats.cpp:44) - DST-sensitive
flush: dirtySec>=60s / dirtyCards>=20 / session end / toggle-off
empty sidecar -> first card of day creates DailyEntry{0,card} (s36-az fix)
lenient parse (strtol, n>=2), keep-sorted insertion", fillcolor="#c8e6c9", style=filled];
    ticks [label="TIMER TICK (Commands_Flashcard.cpp:852 FlashcardStudyTick)
kFlashcardStudyTimerID=16 (Canvas.h:45) dispatch Canvas.cpp:6672
SetTimer(hwndCanvas, ID, USER_TIMER_MINIMUM) -> ~1ms wall ticks
STATS: +0.01f/tick while studyMode && !revealMode,
  per-card cap 60s (maxPerCardSec, MainWindow.h:529), tick count NOT
  wall-clock (stalls/sleep skew) - CREDITS CURRENT TAB,
  NOT studyOrder[curIdx].tab (misattribution bug, md §a)
SESSION TIMER: wall-clock GetTickCount64 vs studyTimerStartTick
  (autoscroll pattern); expiry -> studyMode off + beep + done overlay", fillcolor="#e1bee7", style=filled];
    sesstrix [label="SESSION TIMER TRIO (in fc secondary toolbar)
MainWindow.h FlashcardState: studyTimerCheck (hwndStudyTimerCheck)
+ label + edit (CmdFlashcardStudyTimerEdit=528, :389-412)
studyTimerMinutesSetting (default 30) -> studyTimerMinutes>0 = armed
progress line overlay (FlashcardTimerUIOverlayProc,
  Commands_Flashcard.cpp:915-971; silver RGB(192,192,192) line - theme bug md §B)
'Timer done' ∴ overlay (kFlashcardTimerDoneOverlay, 3s, theme-ok)
shown only while study session runs; fullscreen bottom (windowed = above taskbar)", fillcolor="#e1bee7", style=filled];
    cardsrated [label="CARDS RATED (62b11fc)
HandleFlashcardRate -> FlashcardStatsAddCard (Commands_Flashcard.cpp:479)
per-doc FileState.flashcardCardsDone += 1 + today's sidecar bucket
ALL-TIME totals = FlashcardStatsGetTotalSec/Cards (sum of daily buckets,
independent of doc path - survives rename/delete)
sidecar col 3; FileState field appended at END (s36-az)", fillcolor="#c8e6c9", style=filled];
    dualwrite [label="DUAL-WRITE GATE (s36-bs/bt, F8 partial)
static bool kProfDualWriteSidecars = true (ReadingStats/FlashcardStats/
Flashcard.cpp) - per-book *.json + sidecars STILL written;
profile upserts (ProfileDataAddFlashcardSec/AddFlashcardCard)
UNCONDITIONAL; FlashcardStudySave -> ProfileDataUpdateStudyDoc;
FlashcardStudyLoad -> ProfileDataMergeStudyDoc (newest-wins lastReviewedAt)
profile-only books merged into Config list (deduped docPath)", fillcolor="#ffcdd2", style=filled];
    homesurf [label="HOME SURFACE (HomePage.cpp)
'Read: Today %s | Total: %s   Flashcards: Today %d cards / %s | Total: %d cards / %s'
(:1506-1515, merged profile+live getters)
calendar day cells: readSec+fcSec heat (:1642, :1712-1742)
peru/orange graph line = study-time (:1741-1755)
calendar hover tooltip: 'Read: %s | Flashcards: %s' (:1941-1945)
Home on => fc/arch secondary toolbars HIDDEN, restored on home-off (s36-ax)", fillcolor="#bbdefb", style=filled];
    perftweak [label="PERF + LATE-FIXES (ar..az, post-62b11fc)
s36-ar (877213c): mask paint viewport culling + GDI+ hoist
s36-aq: page filter follows USER-VISIBLE page numbers
s36-am: loader restored only first card -> fixed (FlashcardStudyPruneStates
  at Commands_Flashcard.cpp:470 prunes orphan states)
s36-al: active card rect in peru/orange (Peru/orange fill)
s36-az (dab2dfe): study-scroll strip gate removed (masks doc-anchored)
c4c70ea: save-reload preserves fork state (invert/contrast/trim/crop/timer)
aecd3b4: highlight opacity 0.4 -> 0.1
dab2dfe/aa09dcf/0b2b0c0: profile F3s3/F4/F5 + F6 sync window + F7 + F8 s1/s2", shape=note, fillcolor="#fff9c4", style=filled];
    rate -> cardsrated [style=dotted];
    ticks -> stats [style=dotted];
    ticks -> sesstrix [style=dotted];
    cardsrated -> dualwrite [style=dotted];
    stats -> dualwrite [style=dotted];
    stats -> homesurf [style=dotted];
    ui -> homesurf [style=dotted];
    ticks -> perftweak [style=dotted];
    subgraph cluster_preload {
        label="Preload / cache (study=on)";
        pa3 [label="PA3 PREFETCH (existing)\nFlashcardPrefetchUpcoming Commands_Flashcard.cpp:303\n(GetFzPageInfo loadQuick=true, next 4-5 + extraPages)\nFlashcardPrefetchRenderUpcoming :260 (next 2, gRenderCache)\n[fc][perf] logs: navigate cached=%d (:392) / prefetch idx %dms (:329)\nsync UI-thread; NOT adaptive", fillcolor="#fff9c4", style=filled];
        prewarm [label="ADAPTIVE PREWARMER (PLANNED - not implemented, s64)\newma(cardSwitchMs) at [fc][perf] navigate; N=clamp(150/ewma, 0, tierCap 0|1|2)\nN=0 when ewma>400ms / gConserveMemory / memFree<15%\ncaps: <=2 warm docs, <=4 fz jobs, BELOW_NORMAL thread, droppable\nworker: locked GetFzPageInfo(loadQuick) only, never raw fz\nepoch counter bumped on LoadDocumentFinish/crop/trim/viewportCropV2/tab-close/filter/annot\ntiles same-dm near-target only (cross-doc tiles dropped RenderCache.cpp:626 PageVisibleNearby)\nphases: P1 instrument+N in {0,1} | P2 cross-tab tiles | P3 lazy-tab warm (opt-in, default OFF)", fillcolor="#ffcdd2", style=filled];
        pa3 -> prewarm [style=dashed, label="evolves"];
    }
    perftweak -> pa3 [style=dotted];
    pending [label="REMAINING: bookmark-mirror live check on user's real books;\nimage-occlusion IO-1..IO-4\n(decisions IO-D1/D2/D3 pending);\nuser live tests: filter/global-session/Lista visual", shape=note, fillcolor="#ffcdd2", style=filled];
    clean -> pending [style=dotted];

    dead [label="Dead code to prune:\nhwndCardCount, studyModeType,\nhistory (TODO Flashcard Step 7)", shape=note, fillcolor="#ffcdd2", style=filled];
    filter -> dead [style=dotted];

    ui [label="UI: FlashcardToolbar (Study/Reveal/Back/Next/Order/List/Filter/Import/Session/Settings\n+ counter btn idx 0 (scope-aware: global = sum over tabs);\nNext grayed w/o next;\nOrder opens Study Order options dialog;\nFilter opens Filter window (checked while filter active);\nList (renamed s27, ex Lista) opens docked panel (checked while open);\nImport opens the Import window (s30-C);\nSession opens the Study Session window (s30-D);\nSettings opens the Settings window (s24, renamed s30);\nALL flashcard windows theme-aware (dark mode)", shape=box, fillcolor="#e3f2fd", style=filled];
    importdlg [label="IMPORT WINDOW (toolbar Import btn -> CmdFlashcardImport=512, s30-C)\n'Import Flashcards' 560x360, class TUMATRA_FLASHCARD_IMPORT\n|Document|Cards| table: row1 = current doc + len(cards),\nrow2 = picked source (FcPickPdfFile inside window) + its count;\n'New cards: N (+ imported N so far)' = DRY-RUN diff via\nFlashcardImportDiffCount (dedupe page+bounds 1pt, no creation);\n[Import new cards to this document] -> FlashcardImportFromPdf\ncreates flashcard-tagged DIFFERENT highlights only (history NOT\nimported) -> cards reload + count/state/sidebar/rerender + re-diff;\nsupersedes old Settings 'Import from PDF...'", fillcolor="#fff9c4", style=filled];
    sessiondlg [label="SESSION WINDOW (toolbar Session btn -> CmdFlashcardSession=513, s30-D)\n'Study Session' 640x520, class TUMATRA_FLASHCARD_SESSION\nsearch EDIT on top (EN_CHANGE filter, str::ContainsI on docName||fileName);\nmulti-select owner-drawn list |PDF|cards|due|last reviewed|tags--|\n(checkbox rows blue-when-checked + sync dots s27;\ndata = FlashcardStudyListDocs + docPath + syncStatus);\n[Open Session] -> SessionOpenSelected: CreateProcessW same exe +\nquoted selected docPaths = NEW app window with all selected books\n(works with Filter / global-session cross-doc study);\ntags data model TBD (em dash for now)", fillcolor="#fff9c4", style=filled];
    ui -> importdlg [style=dotted];
    ui -> sessiondlg [style=dotted];
    study -> ui [style=dotted];

    pertab [label="PER-TAB STATE (s22 foundation): WindowTab::flashcard\n= FlashcardTabState{cards, studyDoc, filterExpr,\nfilterEnabled, cardsLoaded(lazy)}\nFlashcardOnTabChanged hook in LoadModelIntoTab\n(ensures new tab's cards; fixes cross-tab mask bleed)", fillcolor="#c8e6c9", style=filled];
    load -> pertab [style=dotted];

    verifynote [label="(verify) unverified-this-session claims:
CmdFlashcardImport=512 / CmdFlashcardSession=513 (confirmed in Commands.h)
filterdlg 'Filtro de Estudo' details (560x500), bookmark-mirror DFS range
Lista column set; import dry-run diff semantics; session window search scope
none of these were re-read in code - trust prior sessions", shape=note, fillcolor="#ffe0b2", style=filled];
    filterdlg -> verifynote [style=dotted];
    lista -> verifynote [style=dotted];
}
