// dot-sync: verified=2026-11-25 refs=c52307992c98
digraph Flashcard {
    rankdir=TB;
    node [shape=box, style=rounded];
    compound=true;

    create [label="Create card (CmdFlashcardAdd)\nselection -> MuPDF Highlight (author=TumatraPDF-Flashcard)\ncontent EMPTY (positional mask, no text duplication)\nkey = hash(pageNo, bounds) - stable across saves\nMULTI-SELECT: Alt+drag sums disjoint selections\n(SelectionState.altAccum; Alt+click abort = restore)\n-> ONE annot with N quads = ONE card, N mask rects\n(cross-page: one card per page, annots are page-bound)", fillcolor="#c8e6c9", style=filled];
    load [label="CmdFlashcardToggle ON\nFlashcardLoadFromDocument (by author, not 'Q:' prefix)\n+ FlashcardStudyLoad (studyDoc persistence)", fillcolor="#bbdefb", style=filled];
    filter [label="BuildFilteredStudyOrder\nqueue = Vec<FlashcardQueueEntry>{tab, cardIdx}> (s22)\nnew (rating==0) OR due (nextReviewAt <= now)\ncollected SEPARATELY, combined per NewCardsPosition:\n0=newFirst | 1=newLast | 2=mixed (proportional interleave, default)\nrandom = shuffle WITHIN each group (position stays meaningful)\nSCOPE (s22): current-doc (default) | GLOBAL SESSION = all PDF tabs\nof THIS window (crossDocSession; other windows never count)\nPER-TAB page filter applied independently (FlashcardTabState)\nORDER DIALOG (Order btn): Sequential/Random + Before/After/Mixed, instant apply\n(rebuild + restart from first card, centered)", fillcolor="#bbdefb", style=filled];
    filterdlg [label="FILTER WINDOW (Filter btn -> CmdFlashcardFilter, s22)\n'Filtro de Estudo' 560x500, class TUMATRA_FLASHCARD_FILTER\nEDIT expr: set syntax 1-15;20-25;-22-23; (add/remove, sequential,\nclamped; FlashcardFilterEval; apply = Aplicar btn / Enter)\nBOOKMARK MIRROR: owner-drawn listbox, checkbox per TOC item,\nrange = page..page-before-next-in-flat-DFS (sublevels covered);\ncheck injects a-b; token + applies instantly, uncheck removes\nFiltros: ON/OFF instant (keeps expr) | Limpar filtros = hold 2s\ncross-doc checkbox row = window-level session scope\nfilter state PER-TAB (tab->flashcard.filterExpr)", fillcolor="#bbdefb", style=filled];
    filterdlg -> filter [style=dashed, label="rebuild"];
    study [label="Study mode\nopaque mask ONLY on current card (studyMode && !revealMode)\nfirst card: vertically CENTERED, instant scroll\n(FlashcardNavigateToCard: viewport-relative delta\nScrollYBy(screenRect.y + dy/2 - vpdy/2))", fillcolor="#e1bee7", style=filled];
    reveal [label="Reveal (Space/Enter/numpad Enter -> CmdFlashcardReveal)\nmask removed on current card - original text visible\nno-op outside study mode (keys never scroll)", fillcolor="#fff9c4", style=filled];
    rate [label="Rate 1-4 (keys 1..4 + numpad)\nSM-2 update, easeFactor capped [1.3, 2.5]\nrating==1 (Again): reinsert into current queue (relearn)\nadvance: next card MASKED + centered", fillcolor="#e1bee7", style=filled];
    next [label="Next (CmdFlashcardNext toolbar btn)\nskip WITHOUT reveal/rate (no SM-2, no save)\narrives masked + centered; grayed when no next", fillcolor="#e1bee7", style=filled];
    back [label="Back (CmdFlashcardBack)\nprevious card arrives REVEALED (post-reveal)\nscroll position KEPT (no auto-center)", fillcolor="#fff9c4", style=filled];
    persist [label="FlashcardStudySave (Commands_Flashcard.cpp)\nFULL JSON rewrite + tmp file + MoveFileExW\nO(states) I/O\nfolder = FlashcardStudyDir() (app-data\\study by default)\nNOT inside user's Defender exclusion\n-- DEFERRED (>= 50 ms), NOT on the rating path --\nper-book JSON + profile write (ProfileDataUpdateStudyDoc)\nare flushed at 7 points: session end (last card rated),\nstudy toggle OFF, study-session timer expiry (periodic),\ntab switch (FlashcardOnTabChanged), tab close (CloseTab),\napp/win close (CloseWindow); declared MainWindow.h\nDirty flags: kFcDirtyPrune=1, kFcDirtySave=2, kFcDirtySidebar=4\npendingSaveTabs (Vec<WindowTab*>, dupes suppressed vs last element)\nCrash-loss window (~60 s of deferred saves) applies to SM-2\nstate only; study-time credit + card count stay SYNCHRONOUS\nOnly SM-2 save can lose up to 50 ms\n-- ASYNC SAVE WORKER (FlashcardSaveWorker, BELOW_NORMAL) --\nUI thread: resolve path + snapshot states + enqueue\nWorker writes per-book JSON (never touches live studyDoc)\nFlashcardStudyWriteJsonToFile serves BOTH sync + async paths\n(one shared writer, format cannot drift)\nProfile write stays on UI thread (gProfile has NO locks)\nFlashcardFlushBookkeepingSaveOnly: save WITHOUT prune,\nruns BEFORE 'save changes?' prompt can cancel it\n(CloseTab, CloseAllDocumentTabsForUnsync, CloseWindow);\nfull flush runs only after prompt succeeds", fillcolor="#c8e6c9", style=filled];

    create -> load -> filter -> study -> reveal -> rate -> persist;
    rate -> study [style=dashed, label="next card"];
    study -> next [style=dashed, label="skip"];
    study -> back [style=dashed];

    clean [label="CONFIG WINDOW (toolbar Config btn -> CmdFlashcardConfig, s24;\nrenamed from Clean History)\n'Configuracoes' 560x440, class TUMATRA_FLASHCARD_CONFIG, themed (dark ok)\n(1) study-history FOLDER row: EDIT + folder button (IFileDialog\nFOS_PICKFOLDERS); change persists flashcardStudyDir + SaveSettings +\nreloads list; Drive folder = backup; MIGRATES existing JSONs via\nFlashcardStudyMigrateFiles (MOVEFILE_COPY_ALLOWED cross-volume;\ntarget keeps its files); empty = app-data\n(2) history list (owner-drawn, ~10 rows + scroll): |PDF|cartoes|due|\nultima revisao| from FlashcardStudyListDocs (sorted by lastReview desc;\nJSON now stores docName, escaped; legacy files show md5 name)\n(3) 'Limpar livro selecionado' 2s orange -> deletes SELECTED row's JSON\n(md5-matched tabs reset in-memory studyDoc + session + count + sidebar)\n(4) 'Limpar TODOS os livros' 5s red -> DeleteAll + reset EVERY tab\n(+ SidebarPopulate refresh hook) — actions run INSIDE the window,\nlist reloads, window stays open; X/Esc closes;\n(s27) sync dots before name: green=linked (docPath + file::Exists),\nred=PDF moved/renamed, grey=legacy file; 'Re-check' btn re-validates\n(study JSONs persist docPath; EN captions; adopt re-saves docPath);\n(s30) toolbar btn renamed Settings; column-header strip aligned\nwith the rows; Import moved OUT to its own toolbar window"];
    persist -> clean [style=dashed, label="reset"];
    lista [label="LISTA PANEL (Lista btn -> CmdFlashcardLista, s23)\ndocked RIGHT panel (AI-chat pattern; own width + splitter;\ncanvas shrinks via RelayoutFrame; toggle/label-close hides)\nowner-drawn listbox 4 cols: Flashcard (masked text via\nExtractPageText at populate - NOTHING stored in the PDF) |\nPag | Due (countdown AT DRAW TIME: 0min/Nmin/Nh/Nd/'—') |\nStatus colored: new=blue due=orange learn=purple ok=green\n(rows: FcListRow{cardIdx,pageNo,rating,interval,nextReviewAt})\nclick row -> FlashcardNavigateToCardInCurrentTab\nrefresh after rate + clean-current (FlashcardSidebarPopulate)\n-- POPULATE GATED ON fcListVisible (19c4f00) --\nhidden panel skips O(cards x states) + page-text extraction\nFlashcardEnsureTabCards calls populate ONLY when fcListVisible\n-- POPULATE NOW DEFERRED (>= 50 ms, kFcDirtySidebar=4) --\nruns only when panel HWNDs exist (FlashcardSidebar.cpp)\n-- INCREMENTAL UPDATE (eb14afc) --\nFlashcardSidebarUpdateIncremental: one row updated, no\nLB_RESETCONTENT, no page-text extraction\nFalls back to full rebuild (logged) if preconditions fail\nCOST per full populate (FlashcardSidebar.cpp): O(cards x states)\nlinear scan + page text extraction + 2 LB messages/row", fillcolor="#e1bee7", style=filled];
    pertab -> lista [style=dotted, label="current tab's cards"];
    stats [label="STUDY-TIME STATS (FlashcardStats.cpp; commits 80de1ac 2026-10-25 + 62b11fc 2026-10-26)
flashcard-stats.txt next to SETTINGS file, 'YYYYMMDD <sec> <cards>'
  (2-col legacy lines parse cards=0]; plain text, no JSON
FileState.flashcardStudyTimeSec / flashcardCardsDone per doc
YYYYMMDD bucket = GetLocalTime (FlashcardStats.cpp) - DST-sensitive
flush: dirtySec>=60s / dirtyCards>=20 / session end / toggle-off
empty sidecar -> first card of day creates DailyEntry{0,card} (s36-az fix)
lenient parse (strtol, n>=2), keep-sorted insertion", fillcolor="#c8e6c9", style=filled];
    ticks [label="TIMER TICK (Commands_Flashcard.cpp FlashcardStudyTick)
kFlashcardStudyTimerID=16 (Canvas.h) dispatch Canvas.cpp
SetTimer(hwndCanvas, ID, USER_TIMER_MINIMUM) -> ~15.6ms wall ticks
STATS: GetTickCount64 delta, 1.5s guard, credits owning tab
  studyOrder[curIdx].tab (NOT focused tab) - wall-clock accurate
  per-card cap 60s (maxPerCardSec, MainWindow.h)
SESSION TIMER: wall-clock GetTickCount64 vs studyTimerStartTick
  (autoscroll pattern); expiry -> studyMode off + beep + done overlay
-- DEFERRED BOOKKEEPING SERVICE (>= 50 ms) --
FlashcardStudyTick also services deferred bookkeeping:
if (dirtyFlags != 0 && nowMs - lastBookkeepingTick >= 50)
  FlashcardRunDeferredBookkeeping (Commands_Flashcard.cpp)
-> prune THEN save per remembered tab, then sidebar populate",
 fillcolor="#e1bee7", style=filled];
    sesstrix [label="SESSION TIMER TRIO (in fc secondary toolbar)
MainWindow.h FlashcardState: studyTimerCheck (hwndStudyTimerCheck)
+ label + edit (CmdFlashcardStudyTimerEdit=528)
studyTimerMinutesSetting (default 30) -> studyTimerMinutes>0 = armed
progress line overlay (FlashcardTimerUIOverlayProc,
  Commands_Flashcard.cpp; ThemeWindowTextColor - theme-ok)
'Timer done' ∴ overlay (kFlashcardTimerDoneOverlay, 3s, theme-ok)
shown only while study session runs; fullscreen bottom (windowed = above taskbar)", fillcolor="#e1bee7", style=filled];
    cardsrated [label="CARDS RATED (62b11fc)
HandleFlashcardRate -> FlashcardStatsAddCard (Commands_Flashcard.cpp)
per-doc FileState.flashcardCardsDone += 1 + today's sidecar bucket
ALL-TIME totals = FlashcardStatsGetTotalSec/Cards (sum of daily buckets,
independent of doc path - survives rename/delete)
sidecar col 3; FileState field appended at END (s36-az)", fillcolor="#c8e6c9", style=filled];
    dualwrite [label="DUAL-WRITE GATE (s36-bs/bt, F8 partial)
static bool kProfDualWriteSidecars = true (ReadingStats/FlashcardStats/
Flashcard.cpp) - per-book *.json + sidecars STILL written;
profile upserts (ProfileDataAddFlashcardSec/AddFlashcardCard)
UNCONDITIONAL; FlashcardStudySave -> ProfileDataUpdateStudyDoc;
FlashcardStudyLoad -> ProfileDataMergeStudyDoc (newest-wins lastReviewedAt)
profile-only books merged into Config list (deduped docPath)", fillcolor="#ffcdd2", style=filled];
    homesurf [label="HOME SURFACE (HomePage.cpp)
'Read: Today %s | Total: %s   Flashcards: Today %d cards / %s | Total: %d cards / %s'
merged profile+live getters
calendar day cells: readSec+fcSec heat
peru/orange graph line = study-time
calendar hover tooltip: 'Read: %s | Flashcards: %s'
Home on => fc/arch secondary toolbars HIDDEN, restored on home-off (s36-ax)", fillcolor="#bbdefb", style=filled];
    perftweak [label="PERF + LATE-FIXES (ar..az, post-62b11fc)
s36-ar (877213c): mask paint viewport culling + GDI+ hoist
s36-aq: page filter follows USER-VISIBLE page numbers
s36-am: loader restored only first card -> fixed (FlashcardStudyPruneStates
  at Commands_Flashcard.cpp prunes orphan states)
s36-al: active card rect in peru/orange (Peru/orange fill)
s36-az (dab2dfe): study-scroll strip gate removed (masks doc-anchored)
c4c70ea: save-reload preserves fork state (invert/contrast/trim/crop/timer)
aecd3b4: highlight opacity 0.4 -> 0.1
dab2dfe/aa09dcf/0b2b0c0: profile F3s3/F4/F5 + F6 sync window + F7 + F8 s1/s2", shape=note, fillcolor="#fff9c4", style=filled];
    rate -> cardsrated [style=dotted];
    ticks -> stats [style=dotted];
    ticks -> sesstrix [style=dotted];
    cardsrated -> dualwrite [style=dotted];
    stats -> dualwrite [style=dotted];
    stats -> homesurf [style=dotted];
    ui -> homesurf [style=dotted];
    ticks -> perftweak [style=dotted];
    subgraph cluster_preload {
        label="Preload / cache (study=on)";
        pa3 [label="PA3 PREFETCH (existing)\nFlashcardPrefetchUpcoming Commands_Flashcard.cpp\n(GetFzPageInfo loadQuick=true, next N + extraPages)\nFlashcardPrefetchRenderUpcoming (next 2, gRenderCache)\nN = FlashcardPrewarmBudget() = min(round(150/ewma), tierCap 0|1|2)\nMAXIMUM 2 cards (tier cap)\n[fc][perf] logs: navigate cached=%d / prefetch idx %dms\nsync UI-thread; NOT adaptive", fillcolor="#fff9c4", style=filled];
        prewarm [label="ADAPTIVE PREWARMER (IMPLEMENTED s64-R9p)\newma(cardSwitchMs) at [fc][perf] navigate (Commands_Flashcard.cpp)\nN = clamp(150 / max(1, ewma), 0, tierCap 0|1|2)\nFlashcardPrewarmBudget: 0 if ewma>400ms OR\n  memLoad>=85% OR availPhys<512MB; tierCap from cores+RAM\ncaps: <=2 warm docs, <=4 fz jobs, BELOW_NORMAL thread, droppable\nworker (FlashcardPrewarmWorker): locked GetFzPageInfo(loadQuick)\n  only, never raw fz; optional tile request if PageVisibleNearby\nepoch counter bumped on LoadDocumentFinish/crop/trim/viewportCropV2/tab-close/filter/annot\nFlashcardPrewarmInvalidate: bumps epoch, drops queue,\n  drain loop DEAD (condition false immediately — no actual wait)\ntiles same-dm near-target only (RenderCache.cpp PageVisibleNearby)\nphases: P1 instrument+N in {0,1} | P2 cross-tab tiles | P3 lazy-tab warm (opt-in, default OFF)", fillcolor="#c8e6c9", style=filled];
        pa3 -> prewarm [style=dashed, label="evolves"];
    }
    perftweak -> pa3 [style=dotted];
    pending [label="REMAINING: bookmark-mirror live check on user's real books;\nimage-occlusion IO-1..IO-4\n(decisions IO-D1/D2/D3 pending);\nuser live tests: filter/global-session/Lista visual", shape=note, fillcolor="#ffcdd2", style=filled];
    clean -> pending [style=dotted];

    // ===================== NEW FINDINGS (C-F1..C-F9) =====================
    subgraph cluster_newfindings {
        label="NEW FINDINGS (C-F1..C-F9, verified in code)";
        color="#9c27b0";
        style=dashed;
        penwidth=2.0;

        c_f1 [label="C-F1 Lista visibility gate\nFlashcardSidebar.cpp\nGated on win->uiState.fcListVisible: hidden panel skips\nO(cards x states) + page-text extraction per rating\nFlashcardEnsureTabCards calls FlashcardSidebarPopulate\nONLY when fcListVisible (Commands_Flashcard.cpp)\nHWNDs destroyed ONLY on flashcard mode OFF\nFlashcardSidebarToggle merely toggles fcListVisible\n-- IMPLEMENTED (19c4f00) -- cheap visibility win", fillcolor="#c8e6c9", style=filled];
        c_f2 [label="C-F2 text cache lifetime\nFlashcardSidebar.cpp\nPageText pt/ptPage cache is LOCAL to one Populate call\n-> P text extractions per rating, NEVER reused between ratings\npt/ptPage freed at end (FreePageText)", fillcolor="#ffe0b2", style=filled];
        c_f3 [label="C-F3 paint cost\nCanvas.cpp PaintFlashcardMasks\nPAINT ONLY VISIBLE PAGES (8de6a69)\nPer-tab index cardIndicesByPage (physical page -> card indices,\nprimary + extraPages) rebuilt at ALL 6 writers of\ntab->flashcard.cards\nPhysical page visible if ANY virtual page has\nvisibleRatio > 0 (TC2 right column correct)\nActive card + Lista-selected card (and extraPages) always included\nFull-iteration fallback when index missing\nHonest complexity: O(cards on visible pages x Q) — NOT O(1)\nEach rect converted/masked once per visible page\nCtrl+Alt rects painted INDIVIDUALLY (6c55353), not as one union\nPhantom move/resize handles gone", fillcolor="#c8e6c9", style=filled];
        c_f4 [label="C-F4 render queue priority\nRenderCache.cpp\nPageRenderRequest::speculative flag\nGetNextRequest serves VISIBLE request before speculative one\nFull queue evicts a speculative entry first\n-- IMPLEMENTED (eb14afc) -- priority inversion fixed", fillcolor="#c8e6c9", style=filled];
        c_f5 [label="C-F5 vicious circle: same budget gates sync + async\n-- FIXED (80dc44f) --\nFlashcardPrefetchCount: sync page-info prefetch has own count\n(floor 1, max tier cap) — never collapses to 0\nTile prewarm still uses FlashcardPrewarmBudget (can be 0)\nDead drain loop removed from FlashcardPrewarmInvalidate\nEWMA measures CRITICAL PATH (totalMs), not just navigate inner", fillcolor="#c8e6c9", style=filled];
        c_f6 [label="C-F6 two file writes per rating, not one\n-- FIXED (fb37717 + 839e670) --\nFlashcardStudyWriteJsonToFile: ONE shared writer serves\nBOTH sync (FlashcardStudySave) + async (worker) paths\nFormat cannot drift\nAsync: FlashcardSaveWorker (BELOW_NORMAL), snapshot of states\nWorker never touches live studyDoc\nJob carries real docName/docPath (resolved on UI thread)\nWorker drains queue before exit (stop flag under lock + signal)\nFailed write: retry up to 3x, 100 ms backoff, truthful 'giving up' log\nProfile write stays on UI thread (gProfile has NO locks)\nNo fake sentinel job, no stray .tmp", fillcolor="#c8e6c9", style=filled];
        c_f7 [label="C-F7 stats do NOT write per rating\nFlashcardStatsAddCard / FlashcardStatsAddSeconds\nFlashcardStats.cpp keep counters in memory\nflush at thresholds (>=20 cards, >=60 seconds)\nNO per-rating I/O", fillcolor="#ffe0b2", style=filled];
        c_f8 [label="C-F8 study tick does NOT invalidate canvas\nFlashcardStudyTick Commands_Flashcard.cpp+\nonly credits study seconds (wall clock), checks session timer\npumps prewarm; repaints ONLY when session timer expires\n15.6ms period is NOT a repaint problem", fillcolor="#ffe0b2", style=filled];
        c_f9 [label="C-F9 repo constraint: NO STL\nsumatrapdf-src/src/base/: Str, Vec, StrVec only\nunordered_map does NOT exist\nany key->index index must be repo-native:\nsorted Vec + binary search, or small open-addressing table in base/", fillcolor="#ffe0b2", style=filled];

        c_f1 -> c_f2 -> c_f3 -> c_f4 -> c_f5 -> c_f6 -> c_f7 -> c_f8 -> c_f9;
    }

    // ===================== DISCARD CHANGES (data fate) =====================
    subgraph cluster_discard {
        label="UNSAVED DOCUMENT -> DISCARD CHANGES (data fate)";
        color="#f44336";
        style=dashed;
        penwidth=2.0;

        discard_load [label="FlashcardEnsureTabCards (Commands_Flashcard.cpp)\nloads cards from LIVE document (FlashcardLoadFromDocument)\nstudy states from JSON (FlashcardStudyLoad)\none per tab (cardsLoaded guard)\nlog: 'loaded %d cards, %d study states'\nmismatch = orphans", fillcolor="#ffcdd2", style=filled];
        discard_key [label="FlashcardKey (Flashcard.cpp)\nFNV-1a over (pageNo + bounds quantized x100)\nstudy state keyed by POSITION, not annotation object\nrecreating SAME rect on SAME page RESURRECTS old state\nrecreating a few pixels off -> NEW key = progress LOST\nold state stays orphaned", fillcolor="#ffcdd2", style=filled];
        discard_prune [label="FlashcardStudyPruneStates (Flashcard.cpp)\ncalled ONLY on rating and delete paths\nNEVER on load -> zero cards = no rating = no prune\norphan survives indefinitely (rewritten by every save)", fillcolor="#ffcdd2", style=filled];
        discard_stats [label="study TIME and cards-rated counters NOT reverted\nlive in per-doc FileState (flashcardStudyTimeSec,\nflashcardCardsDone), daily sidecar, ProfileData\nhistory shows time for cards never in saved file", fillcolor="#ffcdd2", style=filled];
        discard_config [label="FlashcardStudyListDocs (Flashcard.cpp)\nreports cards=%d from STUDY STATES, not from document\nConfig window shows phantom card count", fillcolor="#ffcdd2", style=filled];
        discard_opts [label="Options (what changes / where / expected gain / risk / breaks):\nP1 prune orphan states at load (depends on key index) -> JSON self-heals\nP2 warn when study session active + doc has unsaved annotation changes\nP3 keep studied-but-unsaved cards' state in pending area until save\nP4 do not credit daily stats/sidecar/profile for cards not in saved file\n  (or mark them provisional)\nP5 show BOTH counts (states vs cards present in document) in Config window", fillcolor="#c8e6c9", style=filled];

        discard_load -> discard_key -> discard_prune -> discard_stats -> discard_config -> discard_opts;
    }

    // ===================== PERF WORK PLAN =====================
    plan [label="PERF WORK PLAN (ordered, from horizontal validation of 2 external models)\nP0 instrument the phases (prune/save-json/save-profile/stats/sidebar/prefetch/navigate/total) + keypress->paint, P50/P95/P99, because dominant cost depends on deck size\nP1 split the critical path from the bookkeeping (defer save/stats/sidebar/prewarm-enqueue by a coalesced 30-50 ms timer, flush on session end / tab switch / WM_CLOSE / WM_ENDSESSION and before the Config window reads)\nP2 key->state index (repo-native, no STL) + prune only on load / when the card set changes\nP3 async coalesced save for BOTH targets (book JSON and profile)\nP4 sidebar: visibility gate, persistent per-page text cache, update only the changed row, owner-data virtual list\nP5 budget/EWMA: separate the cheap page-info prefetch from the ewma>400 rule, measure the EWMA over the WHOLE transition, tier cap 0 should disable only the tile prewarm, delete the dead drain loop in FlashcardPrewarmInvalidate\nP6 render-queue priority (visible > speculative)\nP7 paint: index cards by page, cull FIRST with the visible range RecalcVisibleParts already computes, convert only visible cards\nP8 the unsaved/discard scenario\nNOTE: DO NOT 'fix' the prefetch start index — warming the new card is intentional (C-CORR-1)", shape=note, fillcolor="#e8f5e9", style="filled,dashed"];

    dead -> plan [style=dotted];
    discard_opts -> plan [style=dotted];
    c_f9 -> plan [style=dotted];

    dead [label="Dead code to prune:\nhwndCardCount, studyModeType: PRUNED (no longer exist — grep clean)\nhistory: STILL EXISTS (study-history JSONs + flashcard-stats.txt sidecar; FlashcardStats.cpp)\n-- s68 fixes --\nper-card cap clamps credited seconds (maxPerCardSec 60s; Commands_Flashcard.cpp 'credit = room')\nCmdFlashcardNext resets per-card time base (studyTimeSec=0, lastStudyTick=0; Commands_Flashcard.cpp)\npending study seconds flushed on settings save (FlashcardStatsFlush(false); AppSettings.cpp)\n(TODO Flashcard Step 7 — history remains open)", shape=note, fillcolor="#ffcdd2", style=filled];
    filter -> dead [style=dotted];

    verifynote [label="(verify) unverified-this-session claims:
CmdFlashcardImport=512 / CmdFlashcardSession=513 (confirmed in Commands.h)
filterdlg 'Filtro de Estudo' details (560x500), bookmark-mirror DFS range
Lista column set; import dry-run diff semantics; session window search scope
none of these were re-read in code - trust prior sessions", shape=note, fillcolor="#ffe0b2", style=filled];
    filterdlg -> verifynote [style=dotted];
    lista -> verifynote [style=dotted];

    ctrlclick [label="Ctrl+click on highlight -> Canvas.cpp ctrl+click handler\nmatches annot page+bounds to flashcard key -> FlashcardSidebarSelectAndScrollToCard\n(FlashcardSidebar.cpp) -> opens List panel, selects card, scrolls to it", fillcolor="#e3f2fd", style=filled];
    rectsel [label="Rectangular selection semantics\nCtrl+drag = ONE sharp rectangle + ONE card (Selection.cpp,\nCmdFlashcardAdd Commands_Flashcard.cpp) ignoring text underneath\nCtrl+Alt+drag = N rectangles -> ONE grouped card\n(Selection.cpp ctrlAltAccum per page; Flashcard.cpp extraPages\ncross-page group token + Flashcard::extraPages secondary pages)", fillcolor="#e3f2fd", style=filled];
    planned [label="PLANNED (TODO.md only, NOT implemented):\nGroup / Ungroup / Duplicate + Ranking (stars)", fillcolor="#ffcdd2", style=filled];

    lista -> ctrlclick [style=dotted, label="Ctrl+click selects+scrolls"];
    create -> rectsel [style=dotted, label="Ctrl+drag / Ctrl+Alt+drag"];
    rectsel -> planned [style=dotted, label="Group/Ungroup/Duplicate/Ranking"];

    // ===================== PER-RATING COST MODEL (study=on) =====================
    subgraph cluster_costmodel {
        label="PER-RATING COST MODEL (study=on) — Commands_Flashcard.cpp";
        color="#f44336";
        style=dashed;
        penwidth=2.0;

        cost1 [label="CRITICAL PATH (before repaint):\nA.1 state lookup + SM-2 update + state write-back\nbinary search O(log S) in SORTED studyDoc.states\n(FlashcardStudySortStates guarantees invariant on load/parse/prune/insert)\nFlashcardSm2Update + relearn re-insert (rating==1)\nO(log S) — page-independent\nlog: scan=%dms\nDebug gate: FlashcardStudyVerifySorted at load/parse/prune/insert", fillcolor="#ffcdd2", style=filled];
        cost2 [label="CRITICAL PATH:\nA.3 advance setup\nrevealMode=false; studyTimeSec=0; lastStudyTick=0;\ncurrentCardIdx++; session-end check\n(studyMode=false, idx=-1, FlashcardStudyTimerStop)", fillcolor="#e1bee7", style=filled];
        cost3 [label="CRITICAL PATH:\nA.4 synchronous stats\nFlashcardStatsAddCard\nin-memory counters + thresholded flush (NOT per-rating I/O)\nlog: stats=%dms", fillcolor="#fff9c4", style=filled];
        cost4 [label="CRITICAL PATH:\nA.5 toolbar count\nFlashcardToolbarUpdateCount\nO(1) — page-independent\nlog: toolbar=%dms", fillcolor="#fff9c4", style=filled];
        cost5 [label="CRITICAL PATH:\nA.6 nav: prefetch + navigate + prewarm\nFlashcardPrefetchUpcoming\nFlashcardNavigateToEntry\nFlashcardPrewarmEnqueue\npage-dependent (scroll/render cost)\nlog: nav=%dms", fillcolor="#e1bee7", style=filled];
        cost6 [label="CRITICAL PATH:\nA.7 rerender\nMainWindowRerender\n-> WM_PAINT -> PaintFlashcardMasks\nlog: rerender=%dms", fillcolor="#e1bee7", style=filled];
        cost7 [label="DEFERRED (coalesced >= 50 ms, FlashcardStudyTick serviced)\nFlashcardStudyPruneStates -> FlashcardStudySave\nper tab (prune BEFORE save)\nMechanism: kFcDirtyPrune=1 + pendingSaveTabs (Vec<WindowTab*>,\ndupes suppressed vs last element);\nflush points: session end / study toggle OFF / timer expiry /\ntab switch / tab close (CloseTab) / app close (CloseWindow) /\nperiodic (study tick servicing); declared MainWindow.h\n-- ASYNC: FlashcardSaveWorker (BELOW_NORMAL priority) --\nUI thread: resolve path + snapshot states + enqueue to worker\nWorker: FcSaveWriteJob via FlashcardStudyWriteJsonToFile\nretry up to 3x with 100 ms backoff + truthful 'giving up' log\nWorker drains queue before exit (stop flag under lock + signal)\nProfile write stays on UI thread (ProfileDataUpdateStudyDoc)\nlog (deferred line): prune=%dms save=%dms sidebar=%dms tabs=%d total=%dms", fillcolor="#c8e6c9", style=filled];
        cost8 [label="DEFERRED (coalesced >= 50 ms)\nFlashcardSidebarPopulate\nwindow-level populate; only runs when panel HWNDs exist\nGated on win->uiState.fcListVisible (hidden panel skips\nO(cards x states) + page-text extraction per rating)\nMechanism: kFcDirtySidebar=4; same flush points as prune/save\n-- INCREMENTAL UPDATE (eb14afc) --\nFlashcardSidebarUpdateIncremental: one row updated, no\nLB_RESETCONTENT, no page-text extraction\nFalls back to full rebuild (logged) if preconditions fail\nlog (deferred line): ... sidebar=%dms ...", fillcolor="#c8e6c9", style=filled];
        cost9 [label="CRITICAL PATH:\nlastRateTick recorded + rateProbePending armed (rating start)\nKeypress->paint probe: ARM on rating (HandleFlashcardRate),\nCONSUME on first paint of active card's page (Canvas.cpp)\nExactly ONE measurement per rating: '[fc][perf] paint: keypress->paint=%dms card=%d page=%d cached=%d'\nFlashcardPrefetchCount: sync page-info prefetch has own count\n(floor 1, max tier cap) — never collapses to 0\nEWMA now measures CRITICAL PATH duration (totalMs)", fillcolor="#c8e6c9", style=filled];

        cost1 -> cost2 -> cost3 -> cost4 -> cost5 -> cost6;
        cost6 -> cost7 [style=dotted, label="dirty flag set (kFcDirtyPrune/kFcDirtySave), not run inline"];
        cost6 -> cost8 [style=dotted, label="dirty flag set (kFcDirtySidebar), not run inline"];
        cost1 -> cost9 [style=dotted, label="keypress->paint probe"];
    }

    // ===================== PERF HYPOTHESES (ranked) =====================
    subgraph cluster_hypotheses {
        label="PERF HYPOTHESES (ranked by evidence)";
        color="#ff9800";
        style=dashed;
        penwidth=2.0;

        h1 [label="H1. FlashcardStudyPruneStates O(C log C + S) merge pass\nFlashcard.cpp\nSTATUS: IMPLEMENTED (e550105 + eb59cc3)\nSort card keys (VecSort qsort, O(C log C)) + merge pass\nwith sorted states (O(C + S))\nPrune moved out of critical path (kFcDirtyPrune=1,\npendingSaveTabs, flush at 7 points).\nVerify: '[fc][perf] deferred: prune=%dms ...' line\nDebug gate: FlashcardStudyVerifySorted at prune boundary", fillcolor="#c8e6c9", style=filled];
        h2 [label="H2. FlashcardStudySave async worker + shared JSON writer\nFlashcard.cpp\nSTATUS: IMPLEMENTED (fb37717 + 839e670)\nSave moved out of critical path (kFcDirtySave=2,\npendingSaveTabs, flush at 7 points).\nUI thread: resolve path + snapshot states + enqueue\nWorker (BELOW_NORMAL): FcSaveWriteJob via\nFlashcardStudyWriteJsonToFile (shared writer, sync + async)\nRetry up to 3x, 100 ms backoff, truthful 'giving up' log\nWorker drains queue before exit; no sentinel job, no stray .tmp\nProfile write stays on UI thread (gProfile has NO logs)\nConfirm: '[fc][perf] deferred: ... save=%dms ...' line", fillcolor="#c8e6c9", style=filled];
        h3 [label="H3. FlashcardSidebarPopulate visibility gate + incremental\nFlashcardSidebar.cpp\nSTATUS: IMPLEMENTED (19c4f00 + eb14afc)\nGated on win->uiState.fcListVisible: hidden panel skips\nO(cards x states) + page-text extraction per rating\nkFcDirtySidebar=4; runs coalesced via study tick\nFlashcardSidebarUpdateIncremental: one row updated, no\nLB_RESETCONTENT, no page-text extraction\nFalls back to full rebuild (logged) if preconditions fail\nConfirm: '[fc][perf] deferred: ... sidebar=%dms ...' line", fillcolor="#c8e6c9", style=filled];
        h4 [label="H4. FlashcardPrefetchUpcoming/RenderUpcoming off-by-one\nCommands_Flashcard.cpp\nSTATUS: RESOLVED (claim was WRONG — C-CORR-1)\ncurrentCardIdx++ PRECEDES prefetch call;\nfromIdx IS the new card; warming it is intentional.\nConfirm: log 'prefetch idx=' shows new card index", fillcolor="#fff9c4", style=filled];
        h5 [label="H5. FlashcardPrewarmInvalidate drain loop\nFlashcard.cpp\nSTATUS: RESOLVED (80dc44f — loop REMOVED)\nDead drain loop (condition always false) deleted from\nFlashcardPrewarmInvalidate. Worker epoch filter\ndrops stale jobs instead. No actual wait ever happened.\nConfirm: no drain-loop code remains in Flashcard.cpp", fillcolor="#c8e6c9", style=filled];
        h6 [label="H6. EWMA measures CRITICAL PATH\nCommands_Flashcard.cpp\nSTATUS: RESOLVED (80dc44f)\nEWMA now wraps entire HandleFlashcardRate (totalMs),\nnot just navigate inner. 0.7/0.3 smoothing, 2000 ms clamp.\nPrefetch floor (FlashcardPrefetchCount >= 1) breaks\nthe vicious circle on weak machines\nConfirm: '[fc][perf] rate: ... total=%dms ...' line", fillcolor="#c8e6c9", style=filled];
        h7 [label="H7. Tier cap = 0 on weak machines (<=2 cores or <4GB RAM)\nFlashcard.cpp -> cap=0 -> FlashcardPrewarmBudget returns 0\nSTATUS: OPEN\nEvidence: log '[fc][perf] prewarm skipped: n=0';\nprewarmer silently does nothing on low-end machines\nConfirm: run on 2-core VM; observe zero prewarm activity", fillcolor="#fff9c4", style=filled];

        h1 -> h2 -> h3 -> h4 -> h5 -> h6 -> h7;
    }

    // ===================== SORTED-STATE INVARIANT =====================
    subgraph cluster_sorted {
        label="SORTED-STATE INVARIANT (e550105 + 3420201)";
        color="#f44336";
        style=dashed;
        penwidth=2.0;

        s1 [label="Invariant: studyDoc.states sorted by key (ascending),\nno duplicate keys; dedup keeps newest lastReviewedAt\nGuaranteed on EVERY load path:\n(1) FlashcardStudyParseJsonInto -> FlashcardStudySortStates\n(2) FlashcardStudyLoad:file -> FlashcardStudySortStates\n(3) FlashcardStudyLoad:profile-only -> FlashcardStudySortStates\n(4) HandleFlashcardRate:insert -> insert at sorted position\nComplexity: O(log S) lookup (binary search),\nO(C log C + S) prune (merge pass), O(N log N) sort\nBinary search: FlashcardStateFindIdx\nFix: profile-only adopt early return was SKIPPING the sort\n-> binary search missed states -> duplicate key in JSON", fillcolor="#c8e6c9", style=filled];
        s2 [label="Debug gate: FlashcardStudyVerifySorted\n(gIsDebugBuild only, O(S), no allocations)\nWired at 4 invariant boundaries:\nload / parse / prune / insert\nLogs unmistakable error on violation:\n'[fc] ERROR: study states NOT sorted / DUPLICATE key'\nHermetic E2E test (8102456): fixture copied into\ntests/tmp/, process killed, JSON asserted on disk", fillcolor="#fff9c4", style=filled];

        s1 -> s2 [style=dotted];
    }

    // ===================== PAINT VISIBLE PAGES =====================
    subgraph cluster_paint {
        label="PAINT VISIBLE PAGES ONLY (8de6a69 + 6c55353)";
        color="#4caf50";
        style=dashed;
        penwidth=2.0;

        p1 [label="Per-tab index cardIndicesByPage (WindowTab::flashcard)\nphysical page -> card indices (primary + extraPages)\nRebuilt at ALL 6 writers of tab->flashcard.cards:\nFlashcardEnsureTabCards (load/reload x2), CmdFlashcardAdd,\nFlashcardToolbar (clean-selected, clean-all), SumatraControl\nPhysical page visible if ANY virtual page has\nvisibleRatio > 0 (TC2 right column correct)\nActive card + Lista-selected card (and extraPages)\nalways included\nFull-iteration fallback when index missing\nHonest complexity: O(cards on visible pages x Q) — NOT O(1)", fillcolor="#c8e6c9", style=filled];
        p2 [label="Ctrl+Alt rectangle accumulation (6c55353):\npaints INDIVIDUAL rectangles (not one union)\nPhantom move/resize handles gone\nEach rect converted/masked once per visible page\nCull FIRST with visible range (RecalcVisibleParts),\nconvert only visible cards", fillcolor="#c8e6c9", style=filled];

        p1 -> p2 [style=dotted];
    }

    // ===================== IMPROVEMENT OPTIONS (ranked) =====================
    subgraph cluster_improvements {
        label="IMPROVEMENT OPTIONS (ranked, for external review)";
        color="#4caf50";
        style=dashed;
        penwidth=2.0;

        o1 [label="O1. Key->state index / prune amortization\nFlashcard.cpp\nSTATUS: IMPLEMENTED (e550105)\nRepo-native sorted Vec + binary search (no STL per C-F9)\nFlashcardStudySortStates: VecSort (qsort) + dedup pass\nkeeps newest lastReviewedAt for duplicate keys\nO(N log N) sort, O(log S) lookup, O(C log C + S) prune merge\nInvariant guaranteed on EVERY load path (load, parse, prune, insert)\nDebug gate: FlashcardStudyVerifySorted at all 4 boundaries", fillcolor="#c8e6c9", style=filled];
        o2 [label="O2. Debounce/coalesce FlashcardStudySave\nFlashcard.cpp\nSTATUS: IMPLEMENTED (eb59cc3 + fb37717 + 839e670)\nDeferred via kFcDirtySave + pendingSaveTabs;\nflush at 7 points (session end / toggle OFF / timer expiry /\ntab switch / tab close / app close / periodic).\nIn-memory authoritative.\nASYNC: FlashcardSaveWorker (BELOW_NORMAL), per-book JSON write\non worker thread, FlashcardStudyWriteJsonToFile shared writer\nProfile write stays on UI thread (ProfileData is not thread-safe)\nFlashcardFlushBookkeepingSaveOnly: save without prune,\nbefore 'save changes?' prompt can cancel it\nGain: eliminate per-rating disk I/O + AV latency\nRisk: data loss on crash (~60s window, SM-2 state only)\nBreaks: Config window expects file to reflect latest (adopt;\nread-path merges in-memory + on-disk)", fillcolor="#c8e6c9", style=filled];
        o3 [label="O3. Incremental FlashcardSidebarPopulate\nFlashcardSidebar.cpp\nSTATUS: IMPLEMENTED (eb14afc)\nFlashcardSidebarUpdateIncremental: one row updated, no\nLB_RESETCONTENT, no page-text extraction\nPreconditions: Lista HWNDs exist, fcListVisible, same tab,\nstudyOrderIdx valid, listaRows count matches listbox count,\nitem data matches cardIdx\nFalls back to full rebuild (logged) if any precondition fails\nGain: O(1) per rating vs O(cards x states) + n LB msgs\nRisk: listbox API quirks; selection/scroll preservation\nBreaks: nothing if row data structure unchanged", fillcolor="#c8e6c9", style=filled];
        o4 [label="O4. Skip visible page in render prefetch (start index intentional)\nCommands_Flashcard.cpp\nSTATUS: RESOLVED (C-CORR-1 — do NOT change start index)\nChange: skip if vPage == current vPage (already visible)\nGain: avoid redundant tile request for current page\nRisk: None — pure optimization\nBreaks: nothing", fillcolor="#c8e6c9", style=filled];
        o5 [label="O5. Whole-transition EWMA (budget/EWMA split)\nCommands_Flashcard.cpp\nSTATUS: RESOLVED (80dc44f)\nEWMA wraps entire HandleFlashcardRate (totalMs),\n0.7/0.3 smoothing, 2000 ms clamp.\nPrefetch floor (FlashcardPrefetchCount >= 1) breaks\nvicious circle; tile prewarm still gated by FlashcardPrewarmBudget\nGain: prewarmer budget reacts to REAL transition cost\nRisk: ewma noisier; N=150/ewma calibration may need retune\nBreaks: prewarm budget behavior changes", fillcolor="#c8e6c9", style=filled];
        o6 [label="O6. Fix/remove dead drain loop in FlashcardPrewarmInvalidate\nFlashcard.cpp\nSTATUS: RESOLVED (80dc44f — loop REMOVED)\nDead drain loop deleted. Worker epoch filter drops stale jobs.\nNo actual wait ever happened (condition always false).\nGain: prevent stale in-flight contending docLock/CPU\nRisk: none (removal is safe)\nBreaks: nothing if epoch check solid", fillcolor="#c8e6c9", style=filled];
        o7 [label="O7. Async save worker\nFlashcard.cpp + Commands_Flashcard.cpp\nSTATUS: IMPLEMENTED (fb37717 + 839e670)\nFlashcardSaveWorker (BELOW_NORMAL priority) + FcSaveQueue\nUI: resolve path + snapshot states + enqueue (FlashcardStudySaveAsync)\nWorker: FcSaveWriteJob via FlashcardStudyWriteJsonToFile\n(shared writer, sync + async — format cannot drift)\nJob carries real docName/docPath (resolved on UI thread)\nWorker drains queue before exit (stop flag under lock + signal)\nNo fake sentinel job, no stray .tmp\nRetry up to 3x, 100 ms backoff, truthful 'giving up' log\nProfile write stays on UI thread (gProfile has NO locks)\nFlashcardFlushBookkeepingSaveOnly: save WITHOUT prune,\nbefore 'save changes?' prompt (CloseTab, CloseAllDocumentTabsForUnsync,\nCloseWindow); full flush runs only after prompt succeeds", fillcolor="#c8e6c9", style=filled];

        o1 -> o2 -> o3 -> o4 -> o5 -> o6 -> o7;
    }

    // ===================== MEASUREMENT INSTRUMENTATION =====================
    subgraph cluster_instrumentation {
        label="MEASUREMENT INSTRUMENTATION (existing + proposed)";
        color="#607d8b";
        style=dashed;
        penwidth=2.0;

        existing [label="EXISTING [fc][perf] PROBES (Commands_Flashcard.cpp + Canvas.cpp):\n- rate: scan=%dms stats=%dms toolbar=%dms sidebarFlag=%dms nav=%dms rerender=%dms total=%dms cards=%d states=%d\n- deferred: prune=%dms save=%dms sidebar=%dms tabs=%d total=%dms\n- navigate: card=.. cached=%d\n- prefetch idx=.. %dms\n- prefetch-render idx=..\n- prewarm epoch=%d n=%d ewma=..ms\n- prewarm skipped: ...\n- prewarm invalidate epoch=%d dropped=%d\n- paint: keypress->paint=%dms card=%d page=%d cached=%d (Canvas.cpp, arm/consume)\n- renderq: serving visible over %d speculative (idx=%d tail=%d)\n- save worker: wrote %s %llu bytes in %llums ok=1\n- save worker: write FAILED (attempt N/3, retrying in 100ms) / giving up", fillcolor="#e1bee7", style=filled];

        proposed [label="PROPOSED / REMAINING PROBES:\n- keypress->paint: NOW IMPLEMENTED (Canvas.cpp arm/consume)\n- sidebar incremental hit/miss: log when fallback to full rebuild\n- cardIndicesByPage rebuild count (6 writers)\n- FlashcardStudyVerifySorted violations (debug builds)\n- FlashcardSaveWorker retry/give-up events\nREMOVED (now implemented): rate phase timing, deferred bookkeeping,\npaint probe, EWMA critical path, prefetch floor, render-queue priority", fillcolor="#fff9c4", style=filled];

        existing -> proposed [style=dashed];
    }

    ui [label="UI: FlashcardToolbar (Study/Reveal/Back/Next/Order/List/Filter/Import/Session/Settings\n+ counter btn idx 0 (scope-aware: global = sum over tabs);\nNext grayed w/o next;\nOrder opens Study Order options dialog;\nFilter opens Filter window (checked while filter active);\nList (renamed s27, ex Lista) opens docked panel (checked while open);\nImport opens the Import window (s30-C);\nSession opens the Study Session window (s30-D);\nSettings opens the Settings window (s24, renamed s30);\nALL flashcard windows theme-aware (dark mode)", shape=box, fillcolor="#e3f2fd", style=filled];
    importdlg [label="IMPORT WINDOW (toolbar Import btn -> CmdFlashcardImport=512, s30-C)\n'Import Flashcards' 560x360, class TUMATRA_FLASHCARD_IMPORT\n|Document|Cards| table: row1 = current doc + len(cards),\nrow2 = picked source (FcPickPdfFile inside window) + its count;\n'New cards: N (+ imported N so far)' = DRY-RUN diff via\nFlashcardImportDiffCount (dedupe page+bounds 1pt, no creation);\n[Import new cards to this document] -> FlashcardImportFromPdf\ncreates flashcard-tagged DIFFERENT highlights only (history NOT\nimported) -> cards reload + count/state/sidebar/rerender + re-diff;\nsupersedes old Settings 'Import from PDF...'", fillcolor="#fff9c4", style=filled];
    sessiondlg [label="SESSION WINDOW (toolbar Session btn -> CmdFlashcardSession=513, s30-D)\n'Study Session' 640x520, class TUMATRA_FLASHCARD_SESSION\nsearch EDIT on top (EN_CHANGE filter, str::ContainsI on docName||fileName);\nmulti-select owner-drawn list |PDF|cards|due|last reviewed|tags--|\n(checkbox rows blue-when-checked + sync dots s27;\ndata = FlashcardStudyListDocs + docPath + syncStatus);\n[Open Session] -> SessionOpenSelected: CreateProcessW same exe +\nquoted selected docPaths = NEW app window with all selected books\n(works with Filter / global-session cross-doc study);\ntags data model TBD (em dash for now)", fillcolor="#fff9c4", style=filled];
    ui -> importdlg [style=dotted];
    ui -> sessiondlg [style=dotted];
    study -> ui [style=dotted];

    pertab [label="PER-TAB STATE (s22 foundation): WindowTab::flashcard\n= FlashcardTabState{cards, studyDoc, filterExpr,\nfilterEnabled, cardsLoaded(lazy)}\nFlashcardOnTabChanged hook in LoadModelIntoTab\n(ensures new tab's cards; fixes cross-tab mask bleed)", fillcolor="#c8e6c9", style=filled];
