digraph Flashcard {
    rankdir=TB;
    node [shape=box, style=rounded];

    create [label="Create card (CmdFlashcardAdd)\nselection -> MuPDF Highlight (author=TumatraPDF-Flashcard)\ncontent EMPTY (positional mask, no text duplication)\nkey = hash(pageNo, bounds) - stable across saves\nMULTI-SELECT: Alt+drag sums disjoint selections\n(SelectionState.altAccum; Alt+click abort = restore)\n-> ONE annot with N quads = ONE card, N mask rects\n(cross-page: one card per page, annots are page-bound)", fillcolor="#c8e6c9", style=filled];
    load [label="CmdFlashcardToggle ON\nFlashcardLoadFromDocument (by author, not 'Q:' prefix)\n+ FlashcardStudyLoad (studyDoc persistence)", fillcolor="#bbdefb", style=filled];
    filter [label="BuildFilteredStudyOrder\nqueue = Vec<FlashcardQueueEntry>{tab, cardIdx}> (s22)\nnew (rating==0) OR due (nextReviewAt <= now)\ncollected SEPARATELY, combined per NewCardsPosition:\n0=newFirst | 1=newLast | 2=mixed (proportional interleave, default)\nrandom = shuffle WITHIN each group (position stays meaningful)\nSCOPE (s22): current-doc (default) | GLOBAL SESSION = all PDF tabs\nof THIS window (crossDocSession; other windows never count)\nPER-TAB page filter applied independently (FlashcardTabState)\nORDER DIALOG (Order btn): Sequential/Random + Before/After/Mixed, instant apply\n(rebuild + restart from first card, centered)", fillcolor="#bbdefb", style=filled];
    filterdlg [label="FILTER WINDOW (Filter btn -> CmdFlashcardFilter, s22)\n'Filtro de Estudo' 560x500, class TUMATRA_FLASHCARD_FILTER\nEDIT expr: set syntax 1-15;20-25;-22-23; (add/remove, sequential,\nclamped; FlashcardFilterEval; apply = Aplicar btn / Enter)\nBOOKMARK MIRROR: owner-drawn listbox, checkbox per TOC item,\nrange = page..page-before-next-in-flat-DFS (sublevels covered);\ncheck injects a-b; token + applies instantly, uncheck removes\nFiltros: ON/OFF instant (keeps expr) | Limpar filtros = hold 2s\ncross-doc checkbox row = window-level session scope\nfilter state PER-TAB (tab->flashcard.filterExpr)", fillcolor="#bbdefb", style=filled];
    filterdlg -> filter [style=dashed, label="rebuild"];
    study [label="Study mode\nopaque mask ONLY on current card (studyMode && !revealMode)\nfirst card: vertically CENTERED, instant scroll\n(FlashcardNavigateToCard: viewport-relative delta\nScrollYBy(screenRect.y + dy/2 - vpdy/2))", fillcolor="#e1bee7", style=filled];
    reveal [label="Reveal (Space/Enter/numpad Enter -> CmdFlashcardReveal)\nmask removed on current card - original text visible\nno-op outside study mode (keys never scroll)", fillcolor="#fff9c4", style=filled];
    rate [label="Rate 1-4 (keys 1..4 + numpad)\nSM-2 update, easeFactor capped [1.3, 2.5]\nrating==1 (Again): reinsert into current queue (relearn)\nadvance: next card MASKED + centered", fillcolor="#e1bee7", style=filled];
    next [label="Next (CmdFlashcardNext toolbar btn)\nskip WITHOUT reveal/rate (no SM-2, no save)\narrives masked + centered; grayed when no next", fillcolor="#e1bee7", style=filled];
    back [label="Back (CmdFlashcardBack)\nprevious card arrives REVEALED (post-reveal)\nscroll position KEPT (no auto-center)", fillcolor="#fff9c4", style=filled];
    persist [label="FlashcardStudySave\nJSON per doc; reload restores counts", fillcolor="#c8e6c9", style=filled];

    create -> load -> filter -> study -> reveal -> rate -> persist;
    rate -> study [style=dashed, label="next card"];
    study -> next [style=dashed, label="skip"];
    study -> back [style=dashed];

    clean [label="CONFIG WINDOW (toolbar Config btn -> CmdFlashcardConfig, s24;\nrenamed from Clean History)\n'Configuracoes' 560x440, class TUMATRA_FLASHCARD_CONFIG, themed (dark ok)\n(1) study-history FOLDER row: EDIT + folder button (IFileDialog\nFOS_PICKFOLDERS); change persists flashcardStudyDir + SaveSettings +\nreloads list; Drive folder = backup; MIGRATES existing JSONs via\nFlashcardStudyMigrateFiles (MOVEFILE_COPY_ALLOWED cross-volume;\ntarget keeps its files); empty = app-data\n(2) history list (owner-drawn, ~10 rows + scroll): |PDF|cartoes|due|\nultima revisao| from FlashcardStudyListDocs (sorted by lastReview desc;\nJSON now stores docName, escaped; legacy files show md5 name)\n(3) 'Limpar livro selecionado' 2s orange -> deletes SELECTED row's JSON\n(md5-matched tabs reset in-memory studyDoc + session + count + sidebar)\n(4) 'Limpar TODOS os livros' 5s red -> DeleteAll + reset EVERY tab\n(+ SidebarPopulate refresh hook) — actions run INSIDE the window,\nlist reloads, window stays open; X/Esc closes;\n(s27) sync dots before name: green=linked (docPath + file::Exists),\nred=PDF moved/renamed, grey=legacy file; 'Re-check' btn re-validates\n(study JSONs persist docPath; EN captions; adopt re-saves docPath)"];
    persist -> clean [style=dashed, label="reset"];
    lista [label="LISTA PANEL (Lista btn -> CmdFlashcardLista, s23)\ndocked RIGHT panel (AI-chat pattern; own width + splitter;\ncanvas shrinks via RelayoutFrame; toggle/label-close hides)\nowner-drawn listbox 4 cols: Flashcard (masked text via\nExtractPageText at populate - NOTHING stored in the PDF) |\nPag | Due (countdown AT DRAW TIME: 0min/Nmin/Nh/Nd/'—') |\nStatus colored: new=blue due=orange learn=purple ok=green\n(rows: FcListRow{cardIdx,pageNo,rating,interval,nextReviewAt})\nclick row -> FlashcardNavigateToCardInCurrentTab\nrefresh after rate + clean-current (FlashcardSidebarPopulate)", fillcolor="#e1bee7", style=filled];
    pertab -> lista [style=dotted, label="current tab's cards"];
    pending [label="REMAINING: bookmark-mirror live check on user's real books;\nimage-occlusion IO-1..IO-4\n(decisions IO-D1/D2/D3 pending);\nuser live tests: filter/global-session/Lista visual", shape=note, fillcolor="#ffcdd2", style=filled];
    clean -> pending [style=dotted];

    dead [label="Dead code to prune:\nhwndCardCount, studyModeType,\nhistory (TODO Flashcard Step 7)", shape=note, fillcolor="#ffcdd2", style=filled];
    filter -> dead [style=dotted];

    ui [label="UI: FlashcardToolbar (Study/Reveal/Back/Next/Order/Lista/Filter/Config\n+ counter btn idx 0 (scope-aware: global = sum over tabs);\nNext grayed w/o next;\nOrder opens Study Order options dialog;\nFilter opens Filter window (checked while filter active);\nList (renamed s27, ex Lista) opens docked panel (checked while open);\nConfig opens the Config window (s24);\nALL flashcard windows theme-aware (dark mode)", shape=box, fillcolor="#e3f2fd", style=filled];
    study -> ui [style=dotted];

    pertab [label="PER-TAB STATE (s22 foundation): WindowTab::flashcard\n= FlashcardTabState{cards, studyDoc, filterExpr,\nfilterEnabled, cardsLoaded(lazy)}\nFlashcardOnTabChanged hook in LoadModelIntoTab\n(ensures new tab's cards; fixes cross-tab mask bleed)", fillcolor="#c8e6c9", style=filled];
    load -> pertab [style=dotted];
}
