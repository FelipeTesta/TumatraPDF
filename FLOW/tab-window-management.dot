digraph TabWindowManagement {
    rankdir=TB;
    node [shape=box, style=rounded, fontname="Consolas", fontsize=9];
    edge [fontname="Consolas", fontsize=8];
    compound=true;

    // ===================== MAIN WINDOW =====================
    subgraph cluster_mainwin {
        label="MainWindow (MainWindow.h/cpp)";
        color="#4285f4";
        style=filled;
        fillcolor="#e3f2fd";

        win_struct [label="MainWindow struct\n• hwndFrame / hwndToolbar / hwndReBar\n• Vec<WindowTab*> tabs\n• int activeTabIdx\n• ArchToolsState archTools\n• FlashcardState flashcard\n• EditToolsState editTools\n• showHomeOverlay\n• uiState (layout cache)", fillcolor="#c8e6c9", style=filled);
        create_win [label="CreateAndShowMainWindow()\nSumatraStartup.cpp:2585\n• CreateWindowEx(FrameWndProc)\n• CreateToolbar()\n• LoadSettings()\n• RestoreTabsFromHistory()", fillcolor="#bbdefb", style=filled);
        multi_win [label="Multiple MainWindows\n• gWindows (Vec<MainWindow*>)\n• Each has own tabs vector\n• Cross-window: favorites, tab groups\n• Flashcard session: opens NEW window", fillcolor="#bbdefb", style=filled);
    }

    // ===================== WINDOW TAB =====================
    subgraph cluster_wintab {
        label="WindowTab (WindowTab.h/cpp)";
        color="#e91e63";
        style=filled;
        fillcolor="#fce4ec";

        tab_struct [label="WindowTab struct\n• MainWindow* win\n• EngineBase* ctrl\n• DisplayModel* displayModel\n• FileState* fileState\n• FlashcardTabState flashcard\n• SelectionState selection\n• ReadAloudState readAloud\n• int tabGroupId", fillcolor="#c8e6c9", style=filled);
        flashcard_tab [label="FlashcardTabState (per-tab)\n• Vec<Flashcard> cards\n• FlashcardStudyDoc* studyDoc\n• Str filterExpr\n• bool filterEnabled\n• bool cardsLoaded (lazy)", fillcolor="#fff9c4", style=filled);
    }

    // ===================== TABS CONTROL (VIRTWND) =====================
    subgraph cluster_tabsctrl {
        label="TabsCtrl (TabsCtrl.cpp) — VirtWnd Tree";
        color="#ff9800";
        style=filled;
        fillcolor="#fff3e0";

        virtwnd [label="VirtWnd Tree Root\nTabsCtrl.cpp\n• hwndTabCtrl (SysTabControl32)\n• VirtWnd children = tab buttons\n• Paint: active underline 3px (L224-225)\n• Hit-test: TabCtrl_HitTest()", fillcolor="#c8e6c9", style=filled);
        home_tab [label="Home Tab (pinned idx 0)\nTabs.cpp:712-726\n• Always exists when tabs enabled\n• nTabs ≥ 2 with 1 doc\n• ToggleFavoritesTab() shows it", fillcolor="#e1bee7", style=filled);
        tab_close [label="Close Tab Interactions\n• Alt+Click: L719-723 (closes tab)\n• Middle-click: L775-779 (closes/autoscroll)\n• Ctrl+Shift+T: reopen closed\n• Freeze mechanism REMOVED (2026-08-24)", fillcolor="#bbdefb", style=filled);
        tab_layout [label="LayoutTabs()\n• dx = min(DpiScale(TabWidth), (clientW-5)/nTabs)\n• Recalc on RelayoutFrame\n• Scroll buttons if overflow", fillcolor="#bbdefb", style=filled);
    }

    // ===================== TAB GROUPS =====================
    subgraph cluster_tabgroups {
        label="Tab Groups (TabGroupsManage.cpp)";
        color="#9c27b0";
        style=filled;
        fillcolor="#f3e5f5";

        groups [label="Tab Groups\n• Vec<TabGroup> per window\n• Group = {name, Vec<tabIdx>}\n• Menu: Favorites → Tab Groups submenu (L558)\n• Save/Restore: TabGroupsSave/Load", fillcolor="#bbdefb", style=filled);
        group_ops [label="Operations\n• CreateGroupFromSelection()\n• AddTabToGroup / RemoveTabFromGroup\n• MoveGroupTabs()\n• DeleteGroup()\n• Persist in FileState.tabGroupId", fillcolor="#c8e6c9", style=filled);
    }

    // ===================== TAB LIFECYCLE =====================
    subgraph cluster_lifecycle {
        label="Tab Lifecycle";
        color="#4caf50";
        style=filled;
        fillcolor="#e8f5e9";

        add_tab [label="AddTabToWindow(win, tab)\nTabs.cpp:380\n• push_back to win->tabs\n• TabsCtrl insert item\n• LoadModelIntoTab() if ctrl\n• RelayoutFrame()", fillcolor="#c8e6c9", style=filled);
        select_tab [label="TabsSelect(win, idx)\nTabs.cpp:450\n• win->activeTabIdx = idx\n• TabCtrl_SetCurSel\n• LoadModelIntoTab() if lazy\n• UpdateUI (toolbar page text)\n• FlashcardOnTabChanged hook", fillcolor="#c8e6c9", style=filled);
        close_tab [label="CloseTab(win, idx)\nTabs.cpp:520\n• Save FileState to history\n• Destroy DisplayModel + Engine\n• gRenderCache->FreeForDisplayModel()\n• TabsCtrl delete item\n• Select adjacent tab\n• RelayoutFrame()", fillcolor="#c8e6c9", style=filled);
        reopen_tab [label="ReopenLastClosedFile()\nTabs.cpp:580\n• gFileHistory.RecentlyClosed*\n• LoadDocument() with saved state\n• Ctrl+Shift+T reopens whole window\ngClosedGroupSizes tracks groups", fillcolor="#e1bee7", style=filled);
    }

    // ===================== RELAYOUT =====================
    subgraph cluster_relayout {
        label="RelayoutFrame — Tab/Toolbar Coordination";
        color="#795548";
        style=filled;
        fillcolor="#efebe9";

        relayout [label="RelayoutFrame(win, updateToolbars, sidebarDx)\nSumatraPDF.cpp:6343\n• Main toolbar band height\n• Secondary toolbars (arch/fc/edit) Y stack\n• Sidebar (AI chat / Flashcard Lista) width\n• Canvas gets remaining rect\n• Updates TabCtrl position", fillcolor="#c8e6c9", style=filled);
        tab_pos [label="TabCtrl Position\n• Below main toolbar\n• Above secondary toolbars\n• Height = TabCtrl_GetItemRect()\n• RelayoutFrame updates on toolbar show/hide", fillcolor="#bbdefb", style=filled);
    }

    // ===================== STARTUP RESTORE =====================
    subgraph cluster_startup {
        label="Startup Session Restore";
        color="#607d8b";
        style=filled;
        fillcolor="#eceff1";

        restore [label="RestoreTabsFromHistory()\nSumatraStartup.cpp\n• gFileHistory.RecentlyOpened\n• LoadDocument for each\n• lazyLoad = gGlobalPrefs->lazyLoading\n• RestoreMissingTabOnStartup()\n• TabGroupsLoad()", fillcolor="#c8e6c9", style=filled);
        lazy_load [label="Lazy Loading\nSumatraStartup.cpp:2719\n• Tab created, Engine NOT loaded\n• ReloadDocument on first select\n• gGlobalPrefs->lazyLoading flag", fillcolor="#bbdefb", style=filled);
    }

    // ===================== FLASHCARD PER-TAB =====================
    subgraph cluster_fc_tab {
        label="Flashcard Per-Tab State (s22 foundation)";
        color="#1565c0";
        style=filled;
        fillcolor="#e3f2fd";

        fc_tab_state [label="WindowTab::flashcard\n= FlashcardTabState{\n  cards, studyDoc,\n  filterExpr, filterEnabled,\n  cardsLoaded (lazy)\n}\nFlashcardOnTabChanged hook\nin LoadModelIntoTab", fillcolor="#c8e6c9", style=filled);
        fc_cross_tab [label="Cross-tab isolation\n• Mask bleed FIXED (s22)\n• Each tab own cards/studyDoc\n• Global session = sum over tabs\n• Toolbar counter: scope-aware", fillcolor="#bbdefb", style=filled);
    }

    // ===================== EDGES =====================
    create_win -> win_struct;
    win_struct -> multi_win [style=dotted];
    win_struct -> virtwnd;
    win_struct -> tabs [style=dotted];

    virtwnd -> home_tab;
    virtwnd -> tab_close;
    virtwnd -> tab_layout;
    virtwnd -> tab_pos;

    win_struct -> add_tab;
    win_struct -> select_tab;
    win_struct -> close_tab;
    win_struct -> reopen_tab;

    add_tab -> tab_struct;
    select_tab -> flashcard_tab [style=dotted, label="FlashcardOnTabChanged"];
    close_tab -> reopen_tab [style=dashed];

    relayout -> tab_pos;
    relayout -> virtwnd [style=dotted];

    restore -> add_tab;
    restore -> groups [style=dotted];
    lazy_load -> select_tab [style=dotted];

    fc_tab_state -> fc_cross_tab;

    // Cross-refs to other systems
    tab_struct ..> dm [style=dotted, label="DisplayModel"];
    tab_struct ..> ctrl [style=dotted, label="EngineBase"];
    close_tab ..> cache [style=dotted, label="FreeForDisplayModel"];

    // Legend
    subgraph cluster_legend {
        label="Legend";
        color="#ccc";
        win [label="MainWindow", fillcolor="#e3f2fd", style=filled];
        tab [label="WindowTab", fillcolor="#fce4ec", style=filled];
        virt [label="VirtWnd/TabCtrl", fillcolor="#fff3e0", style=filled];
        groups [label="Tab Groups", fillcolor="#f3e5f5", style=filled];
        lifecycle [label="Lifecycle", fillcolor="#e8f5e9", style=filled];
        relayout_n [label="Relayout", fillcolor="#efebe9", style=filled];
        startup [label="Startup", fillcolor="#eceff1", style=filled];
        fc [label="Flashcard per-tab", fillcolor="#e3f2fd", style=filled];
    }
}