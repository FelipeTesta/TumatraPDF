  // Shortcuts already linked above

  // Legend node (invisible, for documentation)
  n_legend [label="Legend:\n● Solid edges = hierarchy (parent→child)\n● Dashed blue = cross-links (menu→dialog, toolbar→panel, shortcut→cmd)\n● Dashed orange = toolbar toggle → secondary toolbar\n● Dashed pink = toolbar/menu → side panel\n● Dashed green = installer → main window / home → main window\n● Red cluster = SUSPECT orphan commands (no handler/menu/toolbar/shortcut)\n● Dashed nodes = conditional / dev-only / commented out\n● Note nodes (folded corner) = registry keys, cmd-line flags, toggle states, special items\n● Fill colors: install=slate, main=blue, menus=green, toolbars=orange, dialogs=indigo, home=cyan, panels=pink, suspect=red, shortcuts=gray", shape=note, fillcolor="#0F172A", fontcolor="#64748B", fontsize=9, style="filled,rounded"];
}