digraph TumatraPDF_UX {
  // TumatraPDF UX Map — complete user-experience flow from first-run to every reachable action
  // Date: 2026-11-16
  // Sources: tests/tmp/s64/ux-commands.md (537 Cmd* ids, MENU MAP 11 top menus, TOOLBAR MAP 35+ toggles+secondary, CONTEXT MENUS, SUSPECT/DEAD)
  //          tests/tmp/s64/ux-menumap-raw.md (raw menu paths with Cmd ids)
  //          tests/tmp/s64/ui-inventory.md (installer+uninstaller: windows, controls, buttons, flows, registry, flags)
  //          tests/tmp/s64/dialog-inventory.md (25+ dialogs/secondary windows, controls, invocation)
  //          tests/tmp/s64/home_side_inventory.md (Home page 18 elements; side panels 53 elements; CONDITIONAL 7)
  // Legend: solid edges = hierarchy/parent-child; dashed blue edges = cross-links (menu→dialog, toolbar→panel, shortcut→cmd)
  //         red cluster = SUSPECT orphan commands; note nodes = registry/flags; dashed nodes = conditional/dev-only
  // Cluster node counts: install=42, main=18, menus=11 clusters/148 items, toolbars_extra=3 clusters/45 btns, dialogs=27, home=18, panels=53, suspect=80, shortcuts=15

  rankdir=TB; compound=true; newrank=true; splines=ortho;
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=11 margin="0.18,0.08"];
  edge [fontname="Helvetica" fontsize=9 color="#6B7280"];

  // ============================================================
  // CLUSTER: INSTALLER / UNINSTALLER FLOW
  // ============================================================
  subgraph cluster_install {
    label="Installer / Uninstaller Flow"; style="filled,rounded"; fillcolor="#1E293B"; fontcolor="#E2E8F0"; color="#334155";
    node [fillcolor="#334155" fontcolor="#E2E8F0" color="#475569"];

    // Entry points
    n_download [label="Download Installer\n(.exe from GitHub)", tooltip="source:ui-inventory.md:entry points RunInstaller()"];
    n_run_installer [label="RunInstaller()\nlaunches GUI installer", tooltip="source:ui-inventory.md:54"];
    n_silent_flag [label="/S silent flag\ninstall without UI", tooltip="source:ui-inventory.md:55", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_d_path [label="/d <path>\nchange uninstall dir", tooltip="source:ui-inventory.md:56", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_run_install_now [label="-run-install-now\nauto-elevated install", tooltip="source:ui-inventory.md:57", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_fast_install [label="-fast-install\nskip UI direct install", tooltip="source:ui-inventory.md:58", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_all_users_flag [label="-all-users\nforce all-users install", tooltip="source:ui-inventory.md:59", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_with_filter [label="-with-filter / -with-preview\nopt-in checkboxes", tooltip="source:ui-inventory.md:60", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_install_dir_flag [label="-install-dir <dir>\nset install directory", tooltip="source:ui-inventory.md:61", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];

    // Installer window
    n_installer_win [label="Installer Window\n420x340 (492x340 pre-release)\nclass SUMATRA_PDF_INSTALLER_FRAME", tooltip="source:ui-inventory.md:2-5"];
    n_installer_paint [label="GDI+ Custom Paint\nWM_PAINT handler", tooltip="source:ui-inventory.md:6"];
    n_wordmark [label="Wordmark \"TumatraPDF\"\nImpact 40pt #F5F5F0 on #202634", tooltip="source:ui-inventory.md:9"];
    n_version_badge [label="Version Badge\nrotated 45deg off-white", tooltip="source:ui-inventory.md:10"];

    // Pre-install controls
    n_edit_dir [label="Installation Dir Edit\n\"Install TumatraPDF in &folder:\"\neditable, pre-filled", tooltip="source:ui-inventory.md:7"];
    n_btn_browse [label="Browse \"...\" Button\nbtnBrowseDir → folder browser", tooltip="source:ui-inventory.md:8,15"];
    n_chk_preview [label="Checkbox: Let Windows show\n&previews of PDF documents\ncheckboxRegisterPreview", tooltip="source:ui-inventory.md:11,31"];
    n_chk_search [label="Checkbox: Let Windows Desktop Search\n&search PDF documents\ncheckboxRegisterSearchFilter", tooltip="source:ui-inventory.md:12,32"];
    n_chk_allusers [label="Checkbox: Install for all users\ncheckboxForAllUsers", tooltip="source:ui-inventory.md:13,33"];
    n_btn_install [label="Install TumatraPDF\nbtnInstall (disabled during install)", tooltip="source:ui-inventory.md:14,35"];

    // Installing phase
    n_progress_install [label="Installing Progress Bar\nfile extraction + registry writes", tooltip="source:ui-inventory.md:28"];
    n_progress_uninstall [label="Uninstall Progress Bar\nremoved in StartInstallation", tooltip="source:ui-inventory.md:29"];

    // Done / Failed
    n_done_start [label="Done: Start TumatraPDF\nbtnRunSumatra shown", tooltip="source:ui-inventory.md:16"];
    n_failed_dialog [label="Failed: TaskDialog\nShow log / Close buttons", tooltip="source:ui-inventory.md:17,27", shape=box, style="filled,rounded,dashed", fillcolor="#7F1D1D", fontcolor="#FECACA"];
    n_no_repair [label="NOTE: No repair mode UI\nwould require custom cmd-line", tooltip="source:ui-inventory.md:64", shape=note, fillcolor="#7F1D1D", fontcolor="#FECACA"];

    // Uninstaller branch
    n_uninstaller_win [label="Uninstaller Window\n420x340 class SUMATRA_PDF_INSTALLER_FRAME", tooltip="source:ui-inventory.md:18-21"];
    n_uninstaller_welcome [label="Welcome Message\n\"Thank you for choosing TumatraPDF!\"", tooltip="source:ui-inventory.md:24"];
    n_uninstaller_progress [label="Uninstallation in Progress...", tooltip="source:ui-inventory.md:25"];
    n_uninstaller_done [label="Uninstall Complete\n\"Thank you! %s has been uninstalled.\"", tooltip="source:ui-inventory.md:26"];
    n_uninstaller_failed [label="Uninstall Failed\nTaskDialog: Show log / Close", tooltip="source:ui-inventory.md:27"];
    n_btn_uninstall [label="Uninstall TumatraPDF\ngButtonUninstaller (disabled during)", tooltip="source:ui-inventory.md:22,37"];
    n_btn_close_post [label="Close (post-uninstall)\ngButtonExit", tooltip="source:ui-inventory.md:23,38"];

    // Registry keys
    n_reg_hklm [label="HKLM\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\SumatraPDF", tooltip="source:ui-inventory.md:40-52", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_reg_keys [label="DisplayIcon, DisplayName, DisplayVersion,\nEstimatedSize, InstallDate, InstallLocation,\nNoModify=1, NoRepair=1, Publisher,\nUninstallString, QuietUninstallString,\nURLInfoAbout, URLUpdateInfo", tooltip="source:ui-inventory.md:40-52", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];

    // Edges installer flow
    n_download -> n_run_installer;
    n_run_installer -> n_silent_flag [style=dashed, color="#3B82F6", xlabel="if /S"];
    n_run_installer -> n_d_path [style=dashed, color="#3B82F6", xlabel="if /d"];
    n_run_installer -> n_run_install_now [style=dashed, color="#3B82F6", xlabel="if flag"];
    n_run_installer -> n_fast_install [style=dashed, color="#3B82F6", xlabel="if flag"];
    n_run_installer -> n_all_users_flag [style=dashed, color="#3B82F6", xlabel="if flag"];
    n_run_installer -> n_with_filter [style=dashed, color="#3B82F6", xlabel="if flag"];
    n_run_installer -> n_install_dir_flag [style=dashed, color="#3B82F6", xlabel="if flag"];
    n_run_installer -> n_installer_win;
    n_installer_win -> n_installer_paint;
    n_installer_win -> n_wordmark;
    n_installer_win -> n_version_badge;
    n_installer_win -> n_edit_dir;
    n_installer_win -> n_btn_browse;
    n_installer_win -> n_chk_preview;
    n_installer_win -> n_chk_search;
    n_installer_win -> n_chk_allusers;
    n_installer_win -> n_btn_install;
    n_btn_install -> n_progress_install;
    n_progress_install -> n_done_start;
    n_progress_install -> n_failed_dialog;
    n_failed_dialog -> n_no_repair [style=dashed, color="#EF4444"];

    // Uninstaller flow
    n_run_installer -> n_uninstaller_win [style=dashed, color="#3B82F6", xlabel="uninstall path"];
    n_uninstaller_win -> n_uninstaller_welcome;
    n_uninstaller_win -> n_btn_uninstall;
    n_uninstaller_win -> n_btn_browse;
    n_btn_uninstall -> n_uninstaller_progress;
    n_uninstaller_progress -> n_uninstaller_done;
    n_uninstaller_progress -> n_uninstaller_failed;
    n_uninstaller_done -> n_btn_close_post;
    n_uninstaller_failed -> n_no_repair [style=dashed, color="#EF4444"];

    // Registry
    n_installer_win -> n_reg_hklm [style=dashed, color="#3B82F6", xlabel="WriteUninstallerRegistryInfo"];
    n_reg_hklm -> n_reg_keys;
  }

  // ============================================================
  // CLUSTER: MAIN WINDOW
  // ============================================================
  subgraph cluster_main {
    label="Main Window"; style="filled,rounded"; fillcolor="#1E3A5F"; fontcolor="#E2E8F0"; color="#3B82F6";
    node [fillcolor="#1E40AF" fontcolor="#E2E8F0" color="#3B82F6"];

    n_main_win [label="Main Window\nTab Bar + Hamburger + Green Dot\nCaption Controls (min/max/close)", tooltip="source:home_side_inventory.md:main window elements"];
    n_tab_bar [label="Tab Bar\nTabs + Hamburger Menu + Green Status Dot", tooltip="source:home_side_inventory.md:main window"];
    n_hamburger [label="Hamburger Menu\nopens Command Palette / menus", tooltip="source:home_side_inventory.md:main window"];
    n_green_dot [label="Green Dot\nstatus indicator", tooltip="source:home_side_inventory.md:main window"];
    n_caption [label="Caption Controls\nMinimize / Maximize / Close", tooltip="source:home_side_inventory.md:main window"];

    // Primary toolbar row
    n_toolbar_main [label="Primary Toolbar Row (35 built-in + separators)", tooltip="source:ux-commands.md:160-196"];
    n_tb_home [label="Home\nCmdOpenHome", tooltip="source:ux-commands.md:161"];
    n_tb_open [label="Open\nCmdOpenFile", tooltip="source:ux-commands.md:162"];
    n_tb_bookmarks [label="Bookmarks (toggle)\nCmdToggleBookmarks\nchecked=sidebar visible", tooltip="source:ux-commands.md:163"];
    n_tb_print [label="Print\nCmdPrint", tooltip="source:ux-commands.md:164"];
    n_tb_save [label="Save (toggle)\nCmdSaveAnnotations\nchecked=unsaved annotations", tooltip="source:ux-commands.md:165"];
    n_tb_pagenum [label="Page Number Edit Box\n(special, not a command)", tooltip="source:ux-commands.md:166", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_tb_prev [label="Previous Page\nCmdGoToPrevPage", tooltip="source:ux-commands.md:167"];
    n_tb_next [label="Next Page\nCmdGoToNextPage", tooltip="source:ux-commands.md:168"];
    n_tb_readaloud [label="Read Aloud (dropdown)\nCmdReadAloud", tooltip="source:ux-commands.md:170"];
    n_tb_fitwidth [label="Fit Width + Continuous\nCmdZoomFitWidthAndContinuous", tooltip="source:ux-commands.md:172"];
    n_tb_fitsingle [label="Fit Single Page\nCmdZoomFitPageAndSinglePage", tooltip="source:ux-commands.md:173"];
    n_tb_rotleft [label="Rotate Left\nCmdRotateLeft", tooltip="source:ux-commands.md:174"];
    n_tb_rotright [label="Rotate Right\nCmdRotateRight", tooltip="source:ux-commands.md:175"];
    n_tb_zoomout [label="Zoom Out\nCmdZoomOut", tooltip="source:ux-commands.md:176"];
    n_tb_zoomin [label="Zoom In\nCmdZoomIn", tooltip="source:ux-commands.md:177"];
    n_tb_find [label="Find\nCmdFindFirst", tooltip="source:ux-commands.md:179"];
    n_tb_autoscroll [label="Autoscroll\nCmdAutoScrollToggle", tooltip="source:ux-commands.md:181"];
    n_tb_as_down [label="Autoscroll Speed Down\nCmdAutoScrollSpeedDown", tooltip="source:ux-commands.md:182"];
    n_tb_as_up [label="Autoscroll Speed Up\nCmdAutoScrollSpeedUp", tooltip="source:ux-commands.md:183"];
    n_tb_contrast [label="Contrast (toggle)\nCmdContrastToggle\nchecked=contrast on/off", tooltip="source:ux-commands.md:185,212"];
    n_tb_invert [label="Invert (toggle)\nCmdInvertColors\nchecked=invert on/off", tooltip="source:ux-commands.md:186,213"];
    n_tb_scan [label="Scan Mode (toggle)\nCmdViewportCropToggle\nchecked=scan mode on/off", tooltip="source:ux-commands.md:187,214"];
    n_tb_twocol [label="Two Columns (toggle)\nCmdViewportCropV2Toggle\nchecked=two columns on/off", tooltip="source:ux-commands.md:188,215"];
    n_tb_trim [label="Trim (toggle)\nCmdMarginTrimToggle\nchecked=margin trim on/off", tooltip="source:ux-commands.md:189,216"];
    n_tb_trimcfg [label="Trim Config\nCmdTrimConfig", tooltip="source:ux-commands.md:190"];
    n_tb_flashcard [label="Flashcard (toggle)\nCmdFlashcardToggle\nchecked=flashcard mode on/off", tooltip="source:ux-commands.md:192,219", style="filled,rounded", fillcolor="#7C2D12", fontcolor="#FED7AA"];
    n_tb_archtools [label="Arch Tools (toggle)\nCmdArchToolsToggle\nchecked=arch tools on/off", tooltip="source:ux-commands.md:194,217"];
    n_tb_edit [label="Edit (toggle)\nCmdEditToolsToggle\nchecked=edit mode on/off", tooltip="source:ux-commands.md:195,218"];

    n_canvas [label="Canvas\nPDF rendering area", tooltip="source:home_side_inventory.md:canvas"];

    // Hierarchy edges
    n_main_win -> n_tab_bar;
    n_main_win -> n_toolbar_main;
    n_main_win -> n_canvas;
    n_tab_bar -> n_hamburger;
    n_tab_bar -> n_green_dot;
    n_main_win -> n_caption;

    n_toolbar_main -> n_tb_home;
    n_toolbar_main -> n_tb_open;
    n_toolbar_main -> n_tb_bookmarks;
    n_toolbar_main -> n_tb_print;
    n_toolbar_main -> n_tb_save;
    n_toolbar_main -> n_tb_pagenum;
    n_toolbar_main -> n_tb_prev;
    n_toolbar_main -> n_tb_next;
    n_toolbar_main -> n_tb_readaloud;
    n_toolbar_main -> n_tb_fitwidth;
    n_toolbar_main -> n_tb_fitsingle;
    n_toolbar_main -> n_tb_rotleft;
    n_toolbar_main -> n_tb_rotright;
    n_toolbar_main -> n_tb_zoomout;
    n_toolbar_main -> n_tb_zoomin;
    n_toolbar_main -> n_tb_find;
    n_toolbar_main -> n_tb_autoscroll;
    n_toolbar_main -> n_tb_as_down;
    n_toolbar_main -> n_tb_as_up;
    n_toolbar_main -> n_tb_contrast;
    n_toolbar_main -> n_tb_invert;
    n_toolbar_main -> n_tb_scan;
    n_toolbar_main -> n_tb_twocol;
    n_toolbar_main -> n_tb_trim;
    n_toolbar_main -> n_tb_trimcfg;
    n_toolbar_main -> n_tb_flashcard;
    n_toolbar_main -> n_tb_archtools;
    n_toolbar_main -> n_tb_edit;

    // Cross-links: toolbar buttons -> commands (dashed blue, using xlabel for ortho)
    n_tb_home -> n_mnu_file_newwin [style=dashed, color="#3B82F6", xlabel="CmdOpenHome"];
    n_tb_open -> n_mnu_file_open [style=dashed, color="#3B82F6", xlabel="CmdOpenFile"];
    n_tb_bookmarks -> n_mnu_view_bookmarks [style=dashed, color="#3B82F6", xlabel="CmdToggleBookmarks"];
    n_tb_print -> n_mnu_file_print [style=dashed, color="#3B82F6", xlabel="CmdPrint"];
    n_tb_save -> n_mnu_file_saveann [style=dashed, color="#3B82F6", xlabel="CmdSaveAnnotations"];
    n_tb_prev -> n_mnu_goto_prev [style=dashed, color="#3B82F6", xlabel="CmdGoToPrevPage"];
    n_tb_next -> n_mnu_goto_next [style=dashed, color="#3B82F6", xlabel="CmdGoToNextPage"];
    n_tb_readaloud -> n_mnu_context_readaloud [style=dashed, color="#3B82F6", xlabel="CmdReadAloud"];
    n_tb_fitwidth -> n_mnu_zoom_fitwidth [style=dashed, color="#3B82F6", xlabel="CmdZoomFitWidthAndContinuous"];
    n_tb_fitsingle -> n_mnu_view_single [style=dashed, color="#3B82F6", xlabel="CmdZoomFitPageAndSinglePage"];
    n_tb_rotleft -> n_mnu_view_rotleft [style=dashed, color="#3B82F6", xlabel="CmdRotateLeft"];
    n_tb_rotright -> n_mnu_view_rotright [style=dashed, color="#3B82F6", xlabel="CmdRotateRight"];
    n_tb_zoomout -> n_mnu_zoom_out [style=dashed, color="#3B82F6", xlabel="CmdZoomOut"];
    n_tb_zoomin -> n_mnu_zoom_in [style=dashed, color="#3B82F6", xlabel="CmdZoomIn"];
    n_tb_find -> n_mnu_goto_find [style=dashed, color="#3B82F6", xlabel="CmdFindFirst"];
    n_tb_autoscroll -> n_mnu_newtools_autoscroll [style=dashed, color="#3B82F6", xlabel="CmdAutoScrollToggle"];
    n_tb_as_down -> n_mnu_newtools_asdown [style=dashed, color="#3B82F6", xlabel="CmdAutoScrollSpeedDown"];
    n_tb_as_up -> n_mnu_newtools_asup [style=dashed, color="#3B82F6", xlabel="CmdAutoScrollSpeedUp"];
    n_tb_contrast -> n_mnu_newtools_contrast [style=dashed, color="#3B82F6", xlabel="CmdContrastToggle"];
    n_tb_invert -> n_mnu_newtools_invert [style=dashed, color="#3B82F6", xlabel="CmdInvertColors"];
    n_tb_scan -> n_mnu_newtools_scan [style=dashed, color="#3B82F6", xlabel="CmdViewportCropToggle"];
    n_tb_twocol -> n_mnu_newtools_twocol [style=dashed, color="#3B82F6", xlabel="CmdViewportCropV2Toggle"];
    n_tb_trim -> n_mnu_newtools_trim [style=dashed, color="#3B82F6", xlabel="CmdMarginTrimToggle"];
    n_tb_trimcfg -> n_mnu_newtools_trimcfg [style=dashed, color="#3B82F6", xlabel="CmdTrimConfig"];
    n_tb_flashcard -> n_mnu_newtools_flashcard [style=dashed, color="#3B82F6", xlabel="CmdFlashcardToggle"];
    n_tb_archtools -> n_mnu_newtools_archscale [style=dashed, color="#3B82F6", xlabel="CmdArchToolsToggle"];
    n_tb_edit -> n_mnu_newtools_edit [style=dashed, color="#3B82F6", xlabel="CmdEditToolsToggle"];

    // Toggle state nodes
    n_toggle_bookmarks [label="Bookmarks Toggle State\nchecked=tocVisible", tooltip="source:ux-commands.md:209,221", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_save [label="Save Toggle State\nchecked=unsaved annotations", tooltip="source:ux-commands.md:210", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_readaloud [label="Read Aloud Toggle State\nchecked=speaking/paused", tooltip="source:ux-commands.md:211", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_contrast [label="Contrast Toggle State\nchecked=overlay on/off", tooltip="source:ux-commands.md:212", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_invert [label="Invert Toggle State\nchecked=invert on/off", tooltip="source:ux-commands.md:213", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_scan [label="Scan Mode Toggle State\nchecked=on/off", tooltip="source:ux-commands.md:214", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_twocol [label="Two Columns Toggle State\nchecked=on/off", tooltip="source:ux-commands.md:215", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_trim [label="Trim Toggle State\nchecked=on/off", tooltip="source:ux-commands.md:216", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_arch [label="Arch Tools Toggle State\nchecked=on/off", tooltip="source:ux-commands.md:217", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_edit [label="Edit Tools Toggle State\nchecked=on/off", tooltip="source:ux-commands.md:218", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_flashcard [label="Flashcard Toggle State\nchecked=on/off", tooltip="source:ux-commands.md:219", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
    n_toggle_autoscroll [label="Autoscroll Toggle State\nchecked=on/off", tooltip="source:ux-commands.md:220", shape=note, fillcolor="#0F172A", fontcolor="#94A3B8"];
  }

  // ============================================================
  // CLUSTER: TOP-LEVEL MENUS (11 menus)
  // ============================================================
  subgraph cluster_menus {
    label="Top-Level Menus (11)"; style="filled,rounded"; fillcolor="#1E4D2B"; fontcolor="#E2E8F0"; color="#22C55E";
    node [fillcolor="#166534" fontcolor="#E2E8F0" color="#22C55E"];

    // FILE MENU
    subgraph cluster_mnu_file {
      label="File Menu"; style="filled,rounded"; fillcolor="#14532D"; color="#4ADE80";
      node [fillcolor="#15803D" fontcolor="#E2E8F0" color="#4ADE80"];

      n_mnu_file [label="File Menu", shape=folder];
      n_mnu_file_newwin [label="New Window\nCmdNewWindow", tooltip="source:ux-menumap-raw.md:6"];
      n_mnu_file_open [label="Open...\nCmdOpenFile", tooltip="source:ux-menumap-raw.md:7"];
      n_mnu_file_togglepicker [label="Use TumatraPDF File Picker\nCmdToggleFilePicker", tooltip="source:ux-menumap-raw.md:8"];
      n_mnu_file_close [label="Close\nCmdClose", tooltip="source:ux-menumap-raw.md:9"];
      n_mnu_file_showfolder [label="Show in Folder\nCmdShowInFolder", tooltip="source:ux-menumap-raw.md:10"];
      n_mnu_file_next [label="Open Next File In Folder\nCmdOpenNextFileInFolder", tooltip="source:ux-menumap-raw.md:11"];
      n_mnu_file_prev [label="Open Previous File In Folder\nCmdOpenPrevFileInFolder", tooltip="source:ux-menumap-raw.md:12"];
      n_mnu_file_saveas [label="Save As...\nCmdSaveAs", tooltip="source:ux-menumap-raw.md:13"];
      n_mnu_file_convert [label="Convert to PDF...\nCmdConvertToPDF", tooltip="source:ux-menumap-raw.md:14"];
      n_mnu_file_saveann [label="Save Annotations to existing PDF\nCmdSaveAnnotations", tooltip="source:ux-menumap-raw.md:15"];
      n_mnu_file_rename [label="Rename...\nCmdRenameFile\n(ENABLE_SAVE_SHORTCUT cond.)", tooltip="source:ux-menumap-raw.md:17", style="dashed"];
      n_mnu_file_delete [label="Delete\nCmdDeleteFile", tooltip="source:ux-menumap-raw.md:18"];
      n_mnu_file_delnext [label="Delete and Open Next File\nCmdDeleteFileAndOpenNext", tooltip="source:ux-menumap-raw.md:19"];
      n_mnu_file_print [label="Print...\nCmdPrint", tooltip="source:ux-menumap-raw.md:20"];
      n_mnu_file_opendir_explorer [label="Open Directory in Explorer\nCmdOpenWithExplorer\n(PDF/XPS/CHM cond.)", tooltip="source:ux-menumap-raw.md:22", style="dashed"];
      n_mnu_file_opendir_opus [label="Open Directory in Directory Opus\nCmdOpenWithDirectoryOpus\n(PDF/XPS/CHM cond.)", tooltip="source:ux-menumap-raw.md:23", style="dashed"];
      n_mnu_file_opendir_tc [label="Open Directory in Total Commander\nCmdOpenWithTotalCommander\n(PDF/XPS/CHM cond.)", tooltip="source:ux-menumap-raw.md:24", style="dashed"];
      n_mnu_file_opendir_dc [label="Open Directory in Double Commander\nCmdOpenWithDoubleCommander\n(PDF/XPS/CHM cond.)", tooltip="source:ux-menumap-raw.md:25", style="dashed"];
      n_mnu_file_openacrobat [label="Open in Adobe Reader\nCmdOpenWithAcrobat\n(PDF cond.)", tooltip="source:ux-menumap-raw.md:26", style="dashed"];
