// Remaining red = direct SetSelected bypass
// (SumatraPDF.cpp, hard-banned file) + #8 missing-file-at-restore
// pending design decision. Line numbers drift with edits — re-verify
// before trusting.
digraph TabSessionSystem {
    rankdir=LR;
    node [shape=box, fontname="Consolas", fontsize=10];
